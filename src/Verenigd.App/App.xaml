<Application x:Class="Verenigd.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Verenigd.App.Converters"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolNaarZichtbaar" />
            <conv:KleurNaarBrushConverter x:Key="KleurNaarBrush" />
            <conv:NullNaarZichtbaarheidConverter x:Key="NietNullNaarZichtbaar" />
            <conv:NullNaarZichtbaarheidConverter x:Key="NullNaarZichtbaar" Omgekeerd="True" />
            <conv:OmgekeerdeBoolNaarZichtbaarheidConverter x:Key="OnwaarNaarZichtbaar" />
            <conv:GelijkAanParameterConverter x:Key="GelijkAan" />
            <conv:GelijkAanNaarZichtbaarheidConverter x:Key="GelijkAanZichtbaar" />
            <conv:NietConverter x:Key="Niet" />
            <conv:EnumNaarIndexConverter x:Key="EnumNaarIndex" />
            <conv:RapportNaarDocumentConverter x:Key="RapportNaarDocument" />

            <FontFamily x:Key="Pictogrammen">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- Standaardmaten volgens de Windows-richtlijnen (veelvouden van 4/8). -->
            <Thickness x:Key="PaginaMarge">24,16,24,24</Thickness>
            <Thickness x:Key="KaartPadding">16</Thickness>

            <Style x:Key="Paginatitel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="Sectietitel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,8,0,8" />
            </Style>
            <Style x:Key="Toelichting" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Foutmelding" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
            <!-- De accentknop van het Fluent-thema herkent geen toegangstoets ("_Boeken" verschijnt letterlijk);
                 deze sjabloon toont de tekst als AccessText, zodat Alt+letter weer werkt. -->
            <DataTemplate x:Key="Toegangstekst">
                <AccessText Text="{Binding}" />
            </DataTemplate>
            <Style x:Key="Kaart" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="{StaticResource KaartPadding}" />
            </Style>
            <Style x:Key="Knoppenbalk" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,24,0,0" />
            </Style>
            <Style x:Key="DialoogKnop" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
