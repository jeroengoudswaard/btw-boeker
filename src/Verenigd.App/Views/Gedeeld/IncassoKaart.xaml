<UserControl x:Class="Verenigd.App.Views.Gedeeld.IncassoKaart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Verenigd.App.ViewModels.Contributie"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:IncassoInstellingenViewModel}">
    <!-- Incassogegevens van de Vereniging; gedeeld door Instellingen en de startwizard. -->
    <Border Style="{StaticResource Kaart}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="Incassant-_ID" Target="{Binding ElementName=IncassantVeld}" VerticalAlignment="Center" />
            <TextBox x:Name="IncassantVeld" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"
                     Text="{Binding IncassantId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="IncassantId" />
            <Label Grid.Row="1" Content="Naa_m (als bij de bank)" Target="{Binding ElementName=IncassoNaamVeld}" VerticalAlignment="Center" />
            <TextBox x:Name="IncassoNaamVeld" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="2" Content="I_BAN" Target="{Binding ElementName=IncassoIbanVeld}" VerticalAlignment="Center" />
            <TextBox x:Name="IncassoIbanVeld" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"
                     Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="3" Content="Incasso_dag" Target="{Binding ElementName=DagKeuze}" VerticalAlignment="Center" />
            <ComboBox x:Name="DagKeuze" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"
                      ItemsSource="{Binding Incassodagen}" SelectedItem="{Binding Incassodag}" />
            <Label Grid.Row="4" Content="_Eerste incassomaand" Target="{Binding ElementName=EersteMaandKeuze}" VerticalAlignment="Center" />
            <ComboBox x:Name="EersteMaandKeuze" Grid.Row="4" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                      ItemsSource="{Binding Maandkeuzes}" SelectedItem="{Binding EersteIncassomaand}"
                      ToolTip="Eerdere maanden worden nooit via Verenigd geïncasseerd" />
            <Label Grid.Row="5" Content="_Omschrijving" Target="{Binding ElementName=SjabloonVeld}" VerticalAlignment="Center" />
            <TextBox x:Name="SjabloonVeld" Grid.Row="5" Grid.Column="1" Margin="0,0,0,4"
                     Text="{Binding Omschrijvingssjabloon, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Gebruik {maanden} en {voornamen}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Toelichting}" Margin="0,0,0,8">
                <Run Text="Voorbeeld: " /><Run Text="{Binding Voorbeeld, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Fout}" Style="{StaticResource Foutmelding}"
                       Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
        </Grid>
    </Border>
</UserControl>
