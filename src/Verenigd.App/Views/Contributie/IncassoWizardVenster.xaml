<Window x:Class="Verenigd.App.Views.Contributie.IncassoWizardVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Verenigd.App.ViewModels.Contributie"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:IncassoWizardViewModel}"
        Title="Nieuwe incassorun"
        Width="900" Height="620" MinWidth="640" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="IncassoWizard">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="Stappen">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,24,0" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock x:Name="Stap1" Text="1  Maand" />
                <TextBlock x:Name="Stap2" Text="2  Berekening" />
                <TextBlock x:Name="Stap3" Text="3  Controleren" />
                <TextBlock x:Name="Stap4" Text="4  Klaar" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Left" Width="120" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding IsBezig, Converter={StaticResource BoolNaarZichtbaar}}" AutomationProperties.Name="Bezig" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt; V_orige" Style="{StaticResource DialoogKnop}" Command="{Binding VorigeCommand}"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}" AutomationProperties.AutomationId="IncassoVorige" />
                    <Button Style="{StaticResource DialoogKnop}" IsDefault="True" Command="{Binding VolgendeCommand}"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}" AutomationProperties.AutomationId="IncassoVolgende">
                        <AccessText Text="{Binding Volgendetekst, StringFormat='_{0} &gt;'}" />
                    </Button>
                    <Button Content="Annuleren" Style="{StaticResource DialoogKnop}" IsCancel="True"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}" AutomationProperties.AutomationId="IncassoAnnuleren" />
                    <Button Content="Sluiten" Style="{StaticResource DialoogKnop}" IsDefault="True" Click="Sluiten_Click"
                            Visibility="{Binding IsKlaar, Converter={StaticResource BoolNaarZichtbaar}}" AutomationProperties.AutomationId="IncassoSluiten" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Margin="24,0,24,8" Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}"
                   Visibility="{Binding Foutmelding, Converter={StaticResource NietNullNaarZichtbaar}}" AutomationProperties.LiveSetting="Assertive" />

        <Grid Margin="24,16">
            <!-- ===== Stap 1: maand ===== -->
            <StackPanel MaxWidth="520" HorizontalAlignment="Left"
                        Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Maand}">
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                           Text="Kies de maand. Gemiste maanden uit dit boekjaar worden automatisch meegenomen; een maand wordt nooit twee keer geïncasseerd." />
                <Label Content="_Maand" Target="{Binding ElementName=Maandkeuze}" Padding="0,0,0,4" />
                <ComboBox x:Name="Maandkeuze" ItemsSource="{Binding Maanden}" SelectedItem="{Binding GekozenMaand}" Width="240" HorizontalAlignment="Left"
                          AutomationProperties.AutomationId="IncassoMaand" />
            </StackPanel>

            <!-- ===== Stap 2: berekening ===== -->
            <DockPanel Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Berekening}">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Run Text="{Binding Totaaltekst, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  uitvoerdatum " /><Run Text="{Binding Uitvoerdatum, Mode=OneWay}" />
                </TextBlock>
                <TabControl>
                    <TabItem Header="{Binding PostenKop}">
                        <DataGrid ItemsSource="{Binding Posten}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  RowDetailsVisibilityMode="VisibleWhenSelected" AutomationProperties.Name="Posten">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rekeninghouder" Binding="{Binding Rekeninghouder}" Width="*" />
                                <DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="*" />
                                <DataGridTextColumn Header="Bedrag" Binding="{Binding Bedrag}" Width="Auto" />
                                <DataGridTextColumn Header="Omschrijving" Binding="{Binding Omschrijving}" Width="2*" />
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate DataType="{x:Type vm:PostWeergave}">
                                    <ItemsControl ItemsSource="{Binding Regels}" Margin="24,4,0,8" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PostRegelWeergave}">
                                                <TextBlock>
                                                    <Run Text="{Binding Naam, Mode=OneWay}" /> · <Run Text="{Binding Maand, Mode=OneWay}" /> · <Run Text="{Binding Categorie, Mode=OneWay}" /> · <Run Text="{Binding Bedrag, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{Binding ZelfTeInnenKop}">
                        <DataGrid ItemsSource="{Binding ZelfTeInnen}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  AutomationProperties.Name="Zelf te innen">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lidnummer" Binding="{Binding Lidnummer}" Width="Auto" />
                                <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="*" />
                                <DataGridTextColumn Header="Maanden" Binding="{Binding Maanden}" Width="*" />
                                <DataGridTextColumn Header="Bedrag" Binding="{Binding Bedrag}" Width="Auto" />
                                <DataGridTextColumn Header="Reden" Binding="{Binding Reden}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </DockPanel>

            <!-- ===== Stap 3: controleren ===== -->
            <StackPanel MaxWidth="560" HorizontalAlignment="Left"
                        Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Controleren}">
                <TextBlock Text="{Binding Totaaltekst}" Style="{StaticResource Sectietitel}" />
                <TextBlock Margin="0,0,0,12"><Run Text="Uitvoerdatum: " /><Run Text="{Binding Uitvoerdatum, Mode=OneWay}" /></TextBlock>
                <TextBlock Text="Er is niets te incasseren." FontWeight="SemiBold" Margin="0,0,0,12"
                           Visibility="{Binding IsLeeg, Converter={StaticResource BoolNaarZichtbaar}}" />
                <ItemsControl ItemsSource="{Binding Meldingen}" Focusable="False" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Foutmelding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,12"
                           Text="Met 'Definitief maken' wordt eerst een back-up gemaakt. Daarna wordt de run vastgelegd en kunt u het incassobestand (pain.008) opslaan. Een definitieve run kan niet meer worden gewijzigd, alleen geannuleerd als de bank hem niet heeft uitgevoerd." />
                <CheckBox Content="Ik heb de posten en de lijst 'zelf te innen' _gecontroleerd" ContentTemplate="{StaticResource Toegangstekst}" IsChecked="{Binding IsGecontroleerd}"
                          AutomationProperties.AutomationId="IncassoGecontroleerd" />
            </StackPanel>

            <!-- ===== Stap 4: klaar ===== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                        Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Klaar}">
                <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE930;" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock Text="Incassorun definitief" Style="{StaticResource Sectietitel}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Samenvatting}" Style="{StaticResource Toelichting}" AutomationProperties.AutomationId="IncassoSamenvatting" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
