<UserControl x:Class="Verenigd.App.Views.Contributie.ContributieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Verenigd.App.ViewModels.Contributie"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ContributieViewModel}"
             AutomationProperties.AutomationId="ContributieTabblad">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding VernieuwCommand}" />
    </UserControl.InputBindings>
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Zoeken_Executed" />
    </UserControl.CommandBindings>

    <DockPanel Margin="{StaticResource PaginaMarge}">
        <!-- ===== Opdrachtbalk onderaan ===== -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Opslaan" MinWidth="96" Command="{Binding OpslaanCommand}"
                    Style="{DynamicResource AccentButtonStyle}" ToolTip="Opslaan (Ctrl+S)" AutomationProperties.AutomationId="ContributieOpslaan" />
            <TextBlock DockPanel.Dock="Right" Text="Niet-opgeslagen wijzigingen" Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Visibility="{Binding HeeftOnopgeslagenWijzigingen, Converter={StaticResource BoolNaarZichtbaar}}" />
            <TextBlock Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}" Margin="0" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Assertive" />
        </DockPanel>

        <TabControl AutomationProperties.AutomationId="ContributieSubtabbladen">
            <!-- ===== Leden & categorie ===== -->
            <TabItem Header="_Leden &amp; categorie" AutomationProperties.AutomationId="SubtabLeden">
                <DockPanel Margin="0,12,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Label Content="_Zoeken" Target="{Binding ElementName=Zoekveld}" VerticalAlignment="Center" Padding="0,0,8,0" />
                        <TextBox x:Name="Zoekveld" Width="220" Margin="0,0,16,0" VerticalAlignment="Center"
                                 Text="{Binding Zoektekst, UpdateSourceTrigger=PropertyChanged}" ToolTip="Naam of lidnummer (Ctrl+F)"
                                 AutomationProperties.Name="Zoeken op naam of lidnummer" />
                        <CheckBox Content="Alleen met _waarschuwing" IsChecked="{Binding AlleenWaarschuwingen}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Command="{Binding VoorstellenOvernemenCommand}" VerticalAlignment="Center" AutomationProperties.AutomationId="VoorstellenOvernemen">
                            <TextBlock><Run Text="Voorstellen _overnemen (" /><Run Text="{Binding AantalVoorstellen, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                        </Button>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0"
                               Text="De categorie bepaalt het maandbedrag. Een nieuwe categorie geldt vanaf de ingangsdatum; voor een maand telt de categorie op de 1e (Leiding betaalt geen contributie)." />
                    <DataGrid ItemsSource="{Binding Leden}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionUnit="FullRow" AutomationProperties.Name="Leden en categorie">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lidnummer" Binding="{Binding Lidnummer.Waarde}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="Groep" Binding="{Binding Groepen}" IsReadOnly="True" Width="*" />
                            <DataGridTemplateColumn Header="Categorie" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:LidCategorieRegel}">
                                        <ComboBox ItemsSource="{Binding DataContext.Categorieen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Naam" SelectedItem="{Binding GekozenCategorie, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.Name="{Binding Naam, StringFormat=Categorie van {0}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Voorstel" Binding="{Binding Voorstel.Naam}" IsReadOnly="True" Width="*" />
                            <DataGridTemplateColumn Header="Vanaf" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:LidCategorieRegel}">
                                        <DatePicker SelectedDate="{Binding Ingangsdatum, UpdateSourceTrigger=PropertyChanged}"
                                                    AutomationProperties.Name="{Binding Naam, StringFormat=Ingangsdatum van {0}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Betaler" Binding="{Binding Betalertekst}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Let op" Binding="{Binding Waarschuwing}" IsReadOnly="True" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Betalers & machtigingen ===== -->
            <TabItem Header="_Betalers &amp; machtigingen" AutomationProperties.AutomationId="SubtabBetalers">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" MinWidth="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="_Nieuwe betaler" Command="{Binding NieuweBetalerCommand}" AutomationProperties.AutomationId="NieuweBetaler" />
                            <TextBlock Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Run Text="{Binding AantalZonderBetaler, Mode=OneWay}" /><Run Text=" leden zonder betaler" />
                            </TextBlock>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Betalers}" SelectedItem="{Binding GeselecteerdeBetaler}" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Betalers">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rekeninghouder" Binding="{Binding Rekeninghouder}" Width="2*" />
                                <DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="2*" />
                                <DataGridTextColumn Header="Leden" Binding="{Binding AantalLeden}" Width="Auto" />
                                <DataGridTextColumn Header="Machtiging" Binding="{Binding Machtigingtekst}" Width="2*" />
                                <DataGridTextColumn Header="Let op" Binding="{Binding Waarschuwing}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <TextBlock Grid.Column="2" Text="Selecteer een betaler of kies Nieuwe betaler." Style="{StaticResource Toelichting}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Betaler, Converter={StaticResource NullNaarZichtbaar}}" />
                    <Border Grid.Column="2" Style="{StaticResource Kaart}" DataContext="{Binding Betaler}" d:DataContext="{d:DesignInstance Type=vm:BetalerEditor}"
                            Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}" AutomationProperties.AutomationId="BetalerEditor">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Label Content="_IBAN" Target="{Binding ElementName=IbanVeld}" Padding="0,0,0,4" />
                                <TextBox x:Name="IbanVeld" Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,0,0,8"
                                         AutomationProperties.AutomationId="BetalerIban" />
                                <Label Content="_Rekeninghouder" Target="{Binding ElementName=HouderVeld}" Padding="0,0,0,4" />
                                <TextBox x:Name="HouderVeld" Text="{Binding Rekeninghouder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <Label Content="_Mandaatkenmerk" Target="{Binding ElementName=KenmerkVeld}" Padding="0,0,0,4" />
                                <TextBox x:Name="KenmerkVeld" Text="{Binding Mandaatkenmerk, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                         ToolTip="Het kenmerk van de SEPA-machtiging, zoals op het machtigingsformulier" />
                                <Label Content="Machtiging _ondertekend op" Target="{Binding ElementName=OndertekendVeld}" Padding="0,0,0,4" />
                                <DatePicker x:Name="OndertekendVeld" SelectedDate="{Binding OndertekendOp}" Margin="0,0,0,8" />
                                <Label Content="Machtiging i_ngetrokken per" Target="{Binding ElementName=IngetrokkenVeld}" Padding="0,0,0,4" />
                                <DatePicker x:Name="IngetrokkenVeld" SelectedDate="{Binding IngetrokkenOp}" Margin="0,0,0,12" />

                                <TextBlock Text="Leden van deze betaler" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Leden}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LidKeuze}">
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" FontFamily="{StaticResource Pictogrammen}" Content="&#xE711;" Padding="6,2"
                                                        ToolTip="Ontkoppelen" AutomationProperties.Name="{Binding Naam, StringFormat={}{0} ontkoppelen}"
                                                        Command="{Binding DataContext.VerwijderLidCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="_Toevoegen" Margin="8,0,0,0" Command="{Binding VoegLidToeCommand}" />
                                    <ComboBox ItemsSource="{Binding BeschikbareLeden}" SelectedItem="{Binding LidToevoegen}" IsEditable="False"
                                              AutomationProperties.Name="Lid toevoegen" />
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Fouten}" Margin="0,12,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Foutmelding}" Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Opslaan met Ctrl+S." Style="{StaticResource Toelichting}" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Tarieven ===== -->
            <TabItem Header="_Tarieven" AutomationProperties.AutomationId="SubtabTarieven">
                <DockPanel Margin="0,12,0,0" MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Label Content="Boek_jaar" Target="{Binding ElementName=Jaarkeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                        <ComboBox x:Name="Jaarkeuze" ItemsSource="{Binding Boekjaren}" SelectedItem="{Binding Boekjaar}" MinWidth="100" Margin="0,0,16,0" />
                        <Button Content="_Kopiëren van vorig jaar" Command="{Binding KopieerVorigJaarCommand}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0"
                               Text="Het maandbedrag wordt elke maand geïncasseerd. Leiding en Vrijgesteld staan vast op € 0,00." />
                    <DataGrid ItemsSource="{Binding Tarieven}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" AutomationProperties.Name="Tarieven">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Categorie" Binding="{Binding Categorie}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="Soort" Binding="{Binding Soort}" IsReadOnly="True" Width="*" />
                            <DataGridTemplateColumn Header="Maandbedrag (€)" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:TariefRegel}">
                                        <TextBox Text="{Binding Bedragtekst, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBewerkbaar, Converter={StaticResource Niet}}"
                                                 TextAlignment="Right" AutomationProperties.Name="{Binding Categorie, StringFormat=Maandbedrag {0}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="" Binding="{Binding Fout}" IsReadOnly="True" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Incassoruns ===== -->
            <TabItem Header="_Incassoruns" AutomationProperties.AutomationId="SubtabRuns">
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Top" Content="Nieuwe _incassorun..." HorizontalAlignment="Left" Margin="0,0,0,12"
                            Style="{DynamicResource AccentButtonStyle}" Command="{Binding NieuweRunCommand}" AutomationProperties.AutomationId="NieuweIncassorun" />
                    <DataGrid ItemsSource="{Binding Runs}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              AutomationProperties.Name="Incassoruns">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Maand" Binding="{Binding Maand}" Width="*" />
                            <DataGridTextColumn Header="Uitvoerdatum" Binding="{Binding Uitvoerdatum}" Width="Auto" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Statustekst}" Width="Auto" />
                            <DataGridTextColumn Header="Posten" Binding="{Binding AantalPosten}" Width="Auto" />
                            <DataGridTextColumn Header="Totaal" Binding="{Binding Totaal}" Width="Auto" />
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:RunRegel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Bestand opslaan..." Margin="0,0,8,0" IsEnabled="{Binding IsDefinitief}"
                                                    Command="{Binding DataContext.BestandOpslaanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Annuleren..." IsEnabled="{Binding IsDefinitief}"
                                                    Command="{Binding DataContext.AnnuleerRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
