<Window x:Class="Verenigd.App.Views.Leden.ImportWizardVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Verenigd.App.ViewModels.Leden"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ImportWizardViewModel}"
        Title="SOL3-import"
        Width="900" Height="620" MinWidth="640" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AllowDrop="True" Drop="Venster_Drop" DragOver="Venster_DragOver"
        AutomationProperties.AutomationId="ImportWizard">
    <DockPanel>
        <!-- ===== Stappen ===== -->
        <Border DockPanel.Dock="Top" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="Stappen">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,24,0" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="1  Bestanden" x:Name="Stap1" />
                <TextBlock Text="2  Groepen" x:Name="Stap2" />
                <TextBlock Text="3  Controleren" x:Name="Stap3" />
                <TextBlock Text="4  Klaar" x:Name="Stap4" />
            </StackPanel>
        </Border>

        <!-- ===== Knoppen ===== -->
        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Left" Width="120" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding IsBezig, Converter={StaticResource BoolNaarZichtbaar}}" AutomationProperties.Name="Bezig" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt; V_orige" Style="{StaticResource DialoogKnop}" Command="{Binding VorigeCommand}"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}"
                            AutomationProperties.AutomationId="WizardVorige" />
                    <Button Style="{StaticResource DialoogKnop}" IsDefault="True" Command="{Binding VolgendeCommand}"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}"
                            AutomationProperties.AutomationId="WizardVolgende">
                        <AccessText Text="{Binding Volgendetekst, StringFormat='_{0} &gt;'}" />
                    </Button>
                    <Button Content="Annuleren" Style="{StaticResource DialoogKnop}" IsCancel="True"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}"
                            AutomationProperties.AutomationId="WizardAnnuleren" />
                    <Button Content="Sluiten" Style="{StaticResource DialoogKnop}" IsDefault="True" Click="Sluiten_Click"
                            Visibility="{Binding IsKlaar, Converter={StaticResource BoolNaarZichtbaar}}"
                            AutomationProperties.AutomationId="WizardSluiten" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Margin="24,0,24,8" Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}"
                   Visibility="{Binding Foutmelding, Converter={StaticResource NietNullNaarZichtbaar}}"
                   AutomationProperties.AutomationId="WizardFout" AutomationProperties.LiveSetting="Assertive" />

        <Grid Margin="24,16">
            <!-- ===== Stap 1: bestanden ===== -->
            <DockPanel Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Bestanden}">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                           Text="Kies de vier SOL3-exports (of sleep ze naar dit venster). De app herkent ze aan hun kopregel. Vóór het importeren wordt automatisch een back-up gemaakt." />
                <Button DockPanel.Dock="Bottom" Content="_Bladeren..." HorizontalAlignment="Left" Margin="0,16,0,0" MinWidth="96"
                        Command="{Binding BladerenCommand}" AutomationProperties.AutomationId="WizardBladeren" />
                <ItemsControl ItemsSource="{Binding Bestanden}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExportBestandRegel}">
                            <Border Style="{StaticResource Kaart}" Margin="0,0,0,8" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="{StaticResource Pictogrammen}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGeldig}" Value="True">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Omschrijving}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Bestandsnaam, TargetNullValue='(niet gekozen)'}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Pad}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Statustekst}" Style="{StaticResource Toelichting}" VerticalAlignment="Center"
                                               MaxWidth="320" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- ===== Stap 2: groepen indelen ===== -->
            <DockPanel Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Groepen}">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                           Text="Deze groepen zijn nieuw. Kies per groep wat het is. Technische groepen (zoals '(Migratie)') worden standaard verborgen in overzichten, maar tellen mee voor 'Lid sinds'." />
                <DataGrid ItemsSource="{Binding Groepen}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" SelectionUnit="Cell" AutomationProperties.Name="Nieuwe groepen">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Groep" Binding="{Binding Naam}" IsReadOnly="True" Width="*" />
                        <DataGridComboBoxColumn Header="Soort" Width="200"
                                                ItemsSource="{x:Static vm:ImportWizardViewModel.Groepsoorten}"
                                                SelectedItemBinding="{Binding Soort, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ===== Stap 3: controleren ===== -->
            <DockPanel Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Controleren}">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Toelichting}" Margin="0,0,0,12"
                           Text="Controleer wat er verandert. Er is nog niets gewijzigd; dat gebeurt pas met 'Importeren'. Leden worden nooit verwijderd." />
                <TextBlock DockPanel.Dock="Top" Text="Deze import verandert niets: de gegevens zijn al actueel." FontWeight="SemiBold" Margin="0,0,0,12"
                           Visibility="{Binding IsOngewijzigd, Converter={StaticResource BoolNaarZichtbaar}}" />
                <TabControl AutomationProperties.AutomationId="WizardVoorbeeld">
                    <TabItem Header="{Binding NieuwKop}">
                        <DataGrid ItemsSource="{Binding Nieuw}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  AutomationProperties.Name="Nieuwe leden">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lidnummer" Binding="{Binding Lidnummer}" Width="Auto" />
                                <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{Binding GewijzigdKop}">
                        <DataGrid ItemsSource="{Binding Gewijzigd}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  AutomationProperties.Name="Gewijzigde leden">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lidnummer" Binding="{Binding Lidnummer}" Width="Auto" />
                                <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="*" />
                                <DataGridTextColumn Header="Veld" Binding="{Binding Veld}" Width="Auto" />
                                <DataGridTextColumn Header="Oud" Binding="{Binding Oud}" Width="*" />
                                <DataGridTextColumn Header="Nieuw" Binding="{Binding Nieuw}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{Binding IbanVerschillenKop}" Visibility="{Binding HeeftIbanVerschillen, Converter={StaticResource BoolNaarZichtbaar}}"
                             AutomationProperties.AutomationId="WizardIbanVerschillen">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Toelichting}" Margin="0,8" TextWrapping="Wrap"
                                       Text="SOL3 levert bij deze leden een ander IBAN dan in Verenigd. Standaard blijft het IBAN in Verenigd staan. Vink aan als het nieuwe IBAN klopt; een nieuw IBAN vraagt meestal om een nieuwe machtiging." />
                            <DataGrid ItemsSource="{Binding IbanVerschillen}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                      CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Afwijkende IBAN's">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="IBAN uit SOL3 overnemen" Binding="{Binding Overnemen, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                    <DataGridTextColumn Header="Lidnummer" Binding="{Binding Lidnummer}" IsReadOnly="True" Width="Auto" />
                                    <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="IBAN in Verenigd" Binding="{Binding Huidig}" IsReadOnly="True" Width="Auto" />
                                    <DataGridTextColumn Header="IBAN uit SOL3" Binding="{Binding Sol3}" IsReadOnly="True" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{Binding UitgeschrevenKop}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Toelichting}" Margin="0,8"
                                       Text="Deze leden staan niet meer in de export. Aangevinkte leden worden uitgeschreven met de importdatum als einddatum." />
                            <DataGrid ItemsSource="{Binding Uitgeschreven}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                      CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Uit te schrijven leden">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Uitschrijven" Binding="{Binding Uitschrijven, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                    <DataGridTextColumn Header="Lidnummer" Binding="{Binding Lidnummer}" IsReadOnly="True" Width="Auto" />
                                    <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" IsReadOnly="True" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{Binding WaarschuwingenKop}">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="_Waarschuwingen opslaan..." HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Command="{Binding WaarschuwingenOpslaanCommand}" />
                            <DataGrid ItemsSource="{Binding Waarschuwingen}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      AutomationProperties.Name="Waarschuwingen">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Export" Binding="{Binding Export}" Width="Auto" />
                                    <DataGridTextColumn Header="Regel" Binding="{Binding Regel}" Width="Auto" />
                                    <DataGridTextColumn Header="Lidnummer" Binding="{Binding Lidnummer}" Width="Auto" />
                                    <DataGridTextColumn Header="Melding" Binding="{Binding Tekst}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>

            <!-- ===== Stap 4: klaar ===== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                        Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Klaar}">
                <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE930;" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock Text="Import voltooid" Style="{StaticResource Sectietitel}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Samenvatting}" Style="{StaticResource Toelichting}" TextAlignment="Center"
                           AutomationProperties.AutomationId="WizardSamenvatting" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
