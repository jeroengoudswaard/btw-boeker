<Window x:Class="Verenigd.App.Views.Inrichting.StartwizardVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tg="clr-namespace:Verenigd.App.Views.Toegankelijkheid"
        xmlns:g="clr-namespace:Verenigd.App.Views.Gedeeld"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Verenigd.App.ViewModels.Inrichting"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:StartwizardViewModel}"
        Title="Verenigd instellen"
        Width="900" Height="680" MinWidth="680" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="Startwizard">
    <Window.Resources>
        <Style x:Key="Stapkaart" TargetType="Border" BasedOn="{StaticResource Kaart}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="AlIngericht" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Text" Value="✓ Al ingericht. U kunt verder, of het hieronder toch opnieuw doen." />
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- ===== Stappenbalk: klikbaar; ✓ klaar, ● huidige stap, ○ nog te doen ===== -->
        <Border DockPanel.Dock="Top" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="Verenigd instellen" Style="{StaticResource Sectietitel}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Stappen}" Focusable="False" AutomationProperties.Name="Stappen">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StapRegel}">
                            <Button Command="{Binding DataContext.GaNaarCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    Padding="8,4" Margin="0,0,4,4" Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="{Binding Toegankelijkenaam}" AutomationProperties.AutomationId="{Binding Stap, StringFormat=Stap{0}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Teken}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="Steptitel" Text="{Binding Titel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHuidig}" Value="True">
                                    <Setter TargetName="Steptitel" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Steptitel" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Knoppen onderaan ===== -->
        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="_Later verder" Command="{Binding LaterVerderCommand}" MinWidth="96"
                        ToolTip="Sluiten en deze stap onthouden; bij de volgende keer openen gaat u hier verder" AutomationProperties.AutomationId="StartwizardLaterVerder" />
                <ProgressBar DockPanel.Dock="Left" Width="120" Height="4" Margin="16,0,0,0" IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding IsBezig, Converter={StaticResource BoolNaarZichtbaar}}" AutomationProperties.Name="Bezig" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Over_slaan" Style="{StaticResource DialoogKnop}" Command="{Binding OverslaanCommand}"
                            ToolTip="Naar de volgende stap zonder deze stap te doen; dat kan later altijd nog" AutomationProperties.AutomationId="StartwizardOverslaan" />
                    <Button Content="&lt; Vo_rige" Style="{StaticResource DialoogKnop}" Command="{Binding VorigeCommand}" AutomationProperties.AutomationId="StartwizardVorige" />
                    <Button Content="_Volgende &gt;" IsDefault="True" Command="{Binding VolgendeCommand}" AutomationProperties.AutomationId="StartwizardVolgende">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DialoogKnop}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Huidig}" Value="Klaar">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="_Voltooien" Style="{StaticResource DialoogKnop}" Command="{Binding VoltooienCommand}"
                            Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Klaar}"
                            AutomationProperties.AutomationId="StartwizardVoltooien" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Margin="24,0,24,8" Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}" AutomationProperties.LiveSetting="Assertive"
                   Visibility="{Binding Foutmelding, Converter={StaticResource NietNullNaarZichtbaar}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <TextBlock Text="{Binding Stapnummer}" Style="{StaticResource Toelichting}" />
                <TextBlock Text="{Binding HuidigeTitel}" Style="{StaticResource Paginatitel}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource AlIngericht}" AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding IsHuidigeStapKlaar, Converter={StaticResource BoolNaarZichtbaar}}" />

                <!-- ===== Welkom ===== -->
                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Welkom}">
                    <TextBlock Style="{StaticResource Toelichting}" FontSize="16" Margin="0,0,0,16"
                               Text="Deze wizard helpt u stap voor stap de administratie van uw scoutinggroep in te richten. Dat duurt ongeveer 20 minuten. U kunt elke stap overslaan en later verdergaan." />
                    <Border Style="{StaticResource Stapkaart}">
                        <StackPanel>
                            <TextBlock Text="Wat u nodig hebt" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource Toelichting}" Text="• Een sterk wachtwoord voor de versleutelde database" />
                            <TextBlock Style="{StaticResource Toelichting}" Text="• De vier ledenexports uit Scouts Online (SOL3), als u de leden wilt inlezen" />
                            <TextBlock Style="{StaticResource Toelichting}" Text="• Uw huidige boekhouding in Excel, of kies het standaardschema" />
                            <TextBlock Style="{StaticResource Toelichting}" Text="• Een bankafschrift (CAMT.053) van de Rabobank" />
                            <TextBlock Style="{StaticResource Toelichting}" Text="• Het incassant-ID uit het incassocontract en de tarieven per maand" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Database ===== -->
                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Database}">
                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                               Text="Alle gegevens staan in één versleuteld bestand op deze pc. Bij het aanmaken krijgt u een herstelsleutel: bewaar die goed, want zonder wachtwoord of herstelsleutel kan niemand de gegevens nog openen." />
                    <WrapPanel>
                        <Button Content="_Nieuwe database aanmaken..." Command="{Binding NieuweDatabaseCommand}" Style="{DynamicResource AccentButtonStyle}"
                                ContentTemplate="{StaticResource Toegangstekst}" Margin="0,0,8,8" AutomationProperties.AutomationId="StartwizardNieuweDatabase" />
                        <Button Content="_Bestaande database openen..." Command="{Binding OpenDatabaseCommand}" Margin="0,0,8,8"
                                AutomationProperties.AutomationId="StartwizardOpenDatabase" />
                    </WrapPanel>
                </StackPanel>

                <!-- ===== Vereniging en Stichting ===== -->
                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Administraties}">
                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                               Text="De naam en de kleur ziet u terug in de wisselaar bovenaan, de gekleurde band en de statusbalk. Met Volgende worden ze opgeslagen." />
                    <ItemsControl ItemsSource="{Binding Namen}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <g:AdministratieKaart Margin="0,0,0,12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===== Leden ===== -->
                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Leden}">
                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                               Text="Lees de vier exports uit SOL3 in. U ziet eerst een voorbeeld en er wordt vooraf een back-up gemaakt." />
                    <Button Content="SOL3-_bestanden inlezen..." Command="{Binding LedenInlezenCommand}" Style="{DynamicResource AccentButtonStyle}"
                            ContentTemplate="{StaticResource Toegangstekst}" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.AutomationId="StartwizardLeden" />
                    <TextBlock Text="Welke exports maakt u in SOL3?" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <g:Sol3Uitleg AutomationProperties.AutomationId="StartwizardSol3Uitleg" />
                </StackPanel>

                <!-- ===== Boekhouding ===== -->
                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Boekhouding}">
                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                               Text="Kies hoe de boekhouding begint. De Stichting kunt u nu of later inrichten (bijvoorbeeld voor het meerjarenplan)." />
                    <WrapPanel Margin="0,0,0,12">
                        <Label Content="_Administratie" Target="{Binding ElementName=BoekhoudingVoorKeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                        <ComboBox x:Name="BoekhoudingVoorKeuze" ItemsSource="{x:Static vm:StartwizardViewModel.BoekhoudingKeuzes}" SelectedItem="{Binding BoekhoudingVoor}"
                                  Width="160" AutomationProperties.AutomationId="StartwizardBoekhoudingVoor" />
                    </WrapPanel>
                    <Border Style="{StaticResource Stapkaart}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Overnemen _uit Excel..." Command="{Binding BoekhoudingInrichtenCommand}" CommandParameter="{x:Static vm:Boekhoudingkeuze.Excel}"
                                    VerticalAlignment="Center" AutomationProperties.AutomationId="StartwizardExcel" />
                            <StackPanel>
                                <TextBlock Text="Overnemen uit Excel" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Toelichting}" Text="Rekeningschema en eindbalans van vorig jaar, met daarna de historie." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Stapkaart}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Stan_daardschema..." Command="{Binding BoekhoudingInrichtenCommand}" CommandParameter="{x:Static vm:Boekhoudingkeuze.Standaard}"
                                    VerticalAlignment="Center" AutomationProperties.AutomationId="StartwizardStandaard" />
                            <StackPanel>
                                <TextBlock Text="Standaardschema voor scoutinggroepen" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Toelichting}" Text="Speltakken aanvinken en beginsaldi invullen." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Stapkaart}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="S_jabloonbestand..." Command="{Binding BoekhoudingInrichtenCommand}" CommandParameter="{x:Static vm:Boekhoudingkeuze.Sjabloon}"
                                    VerticalAlignment="Center" AutomationProperties.AutomationId="StartwizardSjabloon" />
                            <StackPanel>
                                <TextBlock Text="Sjabloon van een andere groep" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Toelichting}" Text="Een .vsjabloon-bestand: alleen rekeningen, geen bedragen." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Stapkaart}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Lee_g beginnen" Command="{Binding BoekhoudingInrichtenCommand}" CommandParameter="{x:Static vm:Boekhoudingkeuze.Leeg}"
                                    VerticalAlignment="Center" AutomationProperties.AutomationId="StartwizardLeeg" />
                            <StackPanel>
                                <TextBlock Text="Leeg beginnen" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Toelichting}" Text="Alleen de dagboeken; de rekeningen maakt u zelf." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Bank ===== -->
                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Bank}">
                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                               Text="Lees een bankafschrift (CAMT.053) van de Vereniging in. Verenigd herkent de eigen rekeningen aan het IBAN en maakt per rekening een bankdagboek. Richt eerst de boekhouding in." />
                    <Button Content="Bank_afschrift inlezen..." Command="{Binding BankInlezenCommand}" Style="{DynamicResource AccentButtonStyle}"
                            ContentTemplate="{StaticResource Toegangstekst}" HorizontalAlignment="Left" AutomationProperties.AutomationId="StartwizardBank"
                            IsEnabled="{Binding Status.BoekhoudingVereniging}" />
                </StackPanel>

                <!-- ===== Contributie ===== -->
                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Contributie}">
                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                               Text="De gegevens uit het incassocontract; met Volgende worden ze opgeslagen. De tarieven per categorie vult u in onder Contributie › Tarieven." />
                    <g:IncassoKaart DataContext="{Binding Incasso}" Margin="0,0,0,12" />
                    <Button Content="_Tarieven invullen..." Command="{Binding TarievenInvullenCommand}" HorizontalAlignment="Left"
                            ToolTip="Slaat de incassogegevens op, onthoudt deze stap en opent Contributie › Tarieven" AutomationProperties.AutomationId="StartwizardTarieven" />
                </StackPanel>

                <!-- ===== Klaar ===== -->
                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Klaar}">
                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                               Text="Dit is de stand van de inrichting. Wat nog open staat, kunt u later via het menu doen of via Bestand › Startwizard." />
                    <ItemsControl ItemsSource="{Binding Klaarregels}" Focusable="False" AutomationProperties.Name="Samenvatting">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KlaarRegel}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Teken}" Width="24" />
                                    <TextBlock Text="{Binding Tekst}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
