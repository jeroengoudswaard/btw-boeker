<UserControl x:Class="Verenigd.App.Views.OverzichtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Verenigd.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OverzichtViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource PaginaMarge}">

            <!-- ===== Startpagina: nog geen database geopend ===== -->
            <StackPanel MaxWidth="560" HorizontalAlignment="Left"
                        Visibility="{Binding Shell.IsDatabaseOpen, Converter={StaticResource OnwaarNaarZichtbaar}}"
                        AutomationProperties.AutomationId="Startpagina">
                <TextBlock Text="Welkom bij Verenigd" Style="{StaticResource Paginatitel}" />
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,24"
                           Text="Leden, contributie, boekhouding en begroting voor de vereniging en de stichting. Alle gegevens worden versleuteld opgeslagen in één databasebestand." />

                <Button HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,8"
                        Command="{Binding Shell.NieuweDatabaseCommand}" AutomationProperties.AutomationId="StartNieuw">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE710;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Nieuwe database..." FontWeight="SemiBold" />
                            <TextBlock Text="Begin met een lege, versleutelde administratie (Ctrl+N)" Style="{StaticResource Toelichting}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,8"
                        Command="{Binding Shell.OpenDatabaseCommand}" AutomationProperties.AutomationId="StartOpenen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE8E5;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Database openen..." FontWeight="SemiBold" />
                            <TextBlock Text="Open een bestaand .vdb-bestand (Ctrl+O)" Style="{StaticResource Toelichting}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button HorizontalContentAlignment="Left" Padding="16,12"
                        Command="{Binding Shell.HerstelBackupCommand}" AutomationProperties.AutomationId="StartBackup">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE777;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Back-up terugzetten..." FontWeight="SemiBold" />
                            <TextBlock Text="Zet een .vbak-back-up terug als nieuwe database" Style="{StaticResource Toelichting}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ===== Overzicht: database geopend ===== -->
            <StackPanel Visibility="{Binding Shell.IsDatabaseOpen, Converter={StaticResource BoolNaarZichtbaar}}">
                <TextBlock Text="Overzicht" Style="{StaticResource Paginatitel}" />

                <TextBlock Text="Administraties" Style="{StaticResource Sectietitel}" />
                <ItemsControl ItemsSource="{Binding Shell.Administraties}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AdministratieViewModel}">
                            <Border Style="{StaticResource Kaart}" Width="280" Margin="0,0,16,16" Padding="0">
                                <StackPanel>
                                    <Border Height="6" CornerRadius="8,8,0,0"
                                            Background="{Binding Accentkleur, Converter={StaticResource KleurNaarBrush}}" />
                                    <StackPanel Margin="16,12,16,16">
                                        <TextBlock Text="{Binding Naam}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Soort}" Style="{StaticResource Toelichting}" />
                                        <TextBlock Text="Kerncijfers verschijnen hier vanaf fase 2 (leden) en fase 4 (boekhouding)."
                                                   Style="{StaticResource Toelichting}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Aan de slag" Style="{StaticResource Sectietitel}" />
                <TextBlock Style="{StaticResource Toelichting}" MaxWidth="640" HorizontalAlignment="Left">
                    Open modules via het menu <Bold>Modules</Bold> of met <Bold>Ctrl+1</Bold> t/m <Bold>Ctrl+6</Bold>.
                    Financiële modules openen voor de administratie van het actieve tabblad; via het menu kiest u zelf
                    Vereniging of Stichting. Naam en kleur van een administratie wijzigt u onder <Bold>Extra › Instellingen</Bold>.
                </TextBlock>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
