<UserControl x:Class="Verenigd.App.Views.OverzichtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tg="clr-namespace:Verenigd.App.Views.Toegankelijkheid"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Verenigd.App.ViewModels"
             xmlns:inr="clr-namespace:Verenigd.Application.Inrichting;assembly=Verenigd.Application"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OverzichtViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource PaginaMarge}">

            <!-- ===== Startpagina: nog geen database geopend ===== -->
            <tg:Groepspaneel MaxWidth="560" HorizontalAlignment="Left"
                        Visibility="{Binding Shell.IsDatabaseOpen, Converter={StaticResource OnwaarNaarZichtbaar}}"
                        AutomationProperties.Name="Startpagina" AutomationProperties.AutomationId="Startpagina">
                <TextBlock Text="Welkom bij Verenigd" Style="{StaticResource Paginatitel}" />
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,24"
                           Text="Leden, contributie, boekhouding en begroting voor de vereniging en de stichting. Alle gegevens worden versleuteld opgeslagen in één databasebestand." />

                <Button HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,8"
                        Command="{Binding Shell.NieuweDatabaseCommand}" AutomationProperties.AutomationId="StartNieuw">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE710;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Nieuwe database..." FontWeight="SemiBold" />
                            <TextBlock Text="Begin met een lege, versleutelde administratie (Ctrl+N)" Style="{StaticResource Toelichting}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,8"
                        Command="{Binding Shell.OpenDatabaseCommand}" AutomationProperties.AutomationId="StartOpenen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE8E5;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Database openen..." FontWeight="SemiBold" />
                            <TextBlock Text="Open een bestaand .vdb-bestand (Ctrl+O)" Style="{StaticResource Toelichting}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button HorizontalContentAlignment="Left" Padding="16,12"
                        Command="{Binding Shell.HerstelBackupCommand}" AutomationProperties.AutomationId="StartBackup">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE777;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Back-up terugzetten..." FontWeight="SemiBold" />
                            <TextBlock Text="Zet een .vbak-back-up terug als nieuwe database" Style="{StaticResource Toelichting}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </tg:Groepspaneel>

            <!-- ===== Start: database geopend: kerncijfers (besluit 217) en kaarten met de volgende stap (besluit 183) ===== -->
            <StackPanel Visibility="{Binding Shell.IsDatabaseOpen, Converter={StaticResource BoolNaarZichtbaar}}">
                <TextBlock Text="Start" Style="{StaticResource Paginatitel}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,24" MaxWidth="640" HorizontalAlignment="Left"
                           Text="De stand van zaken en wat er te doen is. Links kiest u een onderdeel; bovenaan wisselt u tussen Vereniging en Stichting." />

                <ItemsControl ItemsSource="{Binding Kerncijfers}" Focusable="False" Margin="0,0,0,12"
                              AutomationProperties.Name="Kerncijfers" AutomationProperties.AutomationId="Kerncijfers">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:Kerncijferregel}">
                            <Border Style="{StaticResource Kaart}" Width="232" Margin="0,0,12,12" AutomationProperties.Name="{Binding Titel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Titel}" Style="{StaticResource Kerncijfertitel}" />
                                    <TextBlock Text="{Binding Waarde}" Style="{StaticResource Kerncijferwaarde}" />
                                    <TextBlock Text="{Binding Toelichting}" FontSize="12" Style="{StaticResource Toelichting}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Te doen" Style="{StaticResource Sectietitel}" Margin="0,4,0,12" />
                <ItemsControl ItemsSource="{Binding Kaarten}" Focusable="False" AutomationProperties.Name="Te doen" AutomationProperties.AutomationId="Startkaarten">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type inr:Startkaart}">
                            <Border Style="{StaticResource Kaart}" Width="300" Margin="0,0,12,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Content="{Binding Knoptekst}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Command="{Binding DataContext.Shell.KaartOpenenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Titel}"
                                            AutomationProperties.AutomationId="{Binding Soort, StringFormat=Kaart_{0}}" />
                                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Top"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding Aantal}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titel}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Administratie}" Style="{StaticResource Toelichting}" FontSize="12"
                                                   Visibility="{Binding Administratie, Converter={StaticResource NietNullNaarZichtbaar}}" />
                                        <TextBlock Text="{Binding Tekst}" Style="{StaticResource Toelichting}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Leeg scherm: niets te doen. -->
                <Border Style="{StaticResource Kaart}" MaxWidth="480" HorizontalAlignment="Left"
                        Visibility="{Binding Kaarten.Count, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=0}">
                    <StackPanel>
                        <TextBlock Text="✓ Alles is bij" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Toelichting}" Text="Er staat niets klaar. Kies links een onderdeel om verder te werken." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
