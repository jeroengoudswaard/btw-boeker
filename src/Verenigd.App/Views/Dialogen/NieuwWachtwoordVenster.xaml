<Window x:Class="Verenigd.App.Views.Dialogen.NieuwWachtwoordVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wachtwoord instellen"
        SizeToContent="Height" Width="460"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=Wachtwoord}">
    <StackPanel Margin="24">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="De database wordt versleuteld met dit wachtwoord. Kies minimaal 12 tekens; een korte zin is sterk én goed te onthouden. Hierna krijgt u een herstelsleutel voor als u het wachtwoord vergeet." />
        <Label Content="_Wachtwoord" Target="{Binding ElementName=Wachtwoord}" Padding="0,0,0,4" />
        <PasswordBox x:Name="Wachtwoord" PasswordChanged="Wachtwoord_PasswordChanged" Margin="0,0,0,12"
                     AutomationProperties.AutomationId="NieuwWachtwoord" />
        <Label Content="_Bevestig wachtwoord" Target="{Binding ElementName=Bevestiging}" Padding="0,0,0,4" />
        <PasswordBox x:Name="Bevestiging" PasswordChanged="Bevestiging_PasswordChanged"
                     AutomationProperties.AutomationId="BevestigWachtwoord" />
        <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}"
                   Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
        <StackPanel Style="{StaticResource Knoppenbalk}">
            <Button Content="Aanmaken" IsDefault="True" Style="{StaticResource DialoogKnop}"
                    IsEnabled="{Binding KanBevestigen}" Click="Aanmaken_Click" />
            <Button Content="Annuleren" IsCancel="True" Style="{StaticResource DialoogKnop}" />
        </StackPanel>
    </StackPanel>
</Window>
