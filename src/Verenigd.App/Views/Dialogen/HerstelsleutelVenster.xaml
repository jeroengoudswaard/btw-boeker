<Window x:Class="Verenigd.App.Views.Dialogen.HerstelsleutelVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uw herstelsleutel"
        SizeToContent="Height" Width="560"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="Bewaar deze herstelsleutel goed" Style="{StaticResource Sectietitel}" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16">
            Bent u uw wachtwoord kwijt, dan kunt u de database <Bold>alleen</Bold> met deze sleutel nog openen.
            Verenigd bewaart de sleutel nergens. Druk hem af of sla hem op op een veilige plek, bijvoorbeeld
            in de kluis van de vereniging of in een wachtwoordmanager — niet in dezelfde map als de database.
        </TextBlock>
        <Border Style="{StaticResource Kaart}">
            <TextBox x:Name="Sleutel" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     FontFamily="Consolas" FontSize="18" TextAlignment="Center" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="GetoondeHerstelsleutel" />
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Kopiëren" Click="Kopieren_Click" MinWidth="96" Margin="0,0,8,0" />
            <Button Content="Opslaan als tekstbestand..." Click="Opslaan_Click" />
        </StackPanel>
        <CheckBox x:Name="Bewaard" Margin="0,20,0,0" Checked="Bewaard_Changed" Unchecked="Bewaard_Changed"
                  Content="Ik heb de herstelsleutel veilig bewaard" AutomationProperties.AutomationId="SleutelBewaard" />
        <StackPanel Style="{StaticResource Knoppenbalk}">
            <Button x:Name="Doorgaan" Content="Doorgaan" IsDefault="True" IsEnabled="False"
                    Style="{StaticResource DialoogKnop}" Click="Doorgaan_Click" />
        </StackPanel>
    </StackPanel>
</Window>
