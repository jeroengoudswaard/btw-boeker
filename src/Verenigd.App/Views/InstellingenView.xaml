<UserControl x:Class="Verenigd.App.Views.InstellingenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Verenigd.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstellingenViewModel}">
    <DockPanel>
        <!-- Opdrachtbalk onderaan, zoals in Windows-instellingenvensters -->
        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Niet-opgeslagen wijzigingen" Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="0,0,16,0"
                           Visibility="{Binding HeeftOnopgeslagenWijzigingen, Converter={StaticResource BoolNaarZichtbaar}}" />
                <Button Content="Opslaan" MinWidth="96" Command="{Binding OpslaanCommand}"
                        Style="{DynamicResource AccentButtonStyle}" ToolTip="Opslaan (Ctrl+S)"
                        AutomationProperties.AutomationId="InstellingenOpslaan" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource PaginaMarge}" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Instellingen" Style="{StaticResource Paginatitel}" />
                <TextBlock Text="Administraties" Style="{StaticResource Sectietitel}" />
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                           Text="De accentkleur ziet u terug in de tabbladen, de gekleurde band en de statusbalk. Zo is altijd duidelijk in welke administratie u werkt." />

                <ItemsControl ItemsSource="{Binding Regels}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AdministratieInstellingRegel}">
                            <Border Style="{StaticResource Kaart}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.ColumnSpan="2" Text="{Binding Soort}" FontWeight="SemiBold" Margin="0,0,0,12" />

                                    <Label Grid.Row="1" Content="_Naam" Target="{Binding ElementName=NaamInvoer}" VerticalAlignment="Center" />
                                    <TextBox x:Name="NaamInvoer" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                             Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Naam" />

                                    <Label Grid.Row="2" Content="_Accentkleur" Target="{Binding ElementName=KleurInvoer}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox x:Name="KleurInvoer" Width="120" FontFamily="Consolas"
                                                 Text="{Binding KleurHex, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Accentkleur (hexcode)" />
                                        <ItemsControl ItemsSource="{x:Static vm:AdministratieInstellingRegel.Kleurvoorstellen}" Margin="12,0,0,0"
                                                      Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="28" Height="28" Margin="0,0,6,0" Padding="0"
                                                            Background="{Binding}" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                                            Command="{Binding DataContext.KiesKleurCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="14"
                                                                        BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Label Grid.Row="3" Content="Voorbeeld" VerticalAlignment="Center" />
                                    <Border Grid.Row="3" Grid.Column="1" Padding="16,8" CornerRadius="4"
                                            Background="{Binding Voorbeeldkleur, Converter={StaticResource KleurNaarBrush}}">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Naam}"
                                                   Foreground="{Binding Voorbeeldtekstkleur, Converter={StaticResource KleurNaarBrush}}" />
                                    </Border>

                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Fout}" Style="{StaticResource Foutmelding}"
                                               Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== Incasso (fase 3) ===== -->
                <StackPanel DataContext="{Binding Incasso}" Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}"
                            AutomationProperties.AutomationId="InstellingenIncasso">
                    <TextBlock Text="Incasso (Vereniging)" Style="{StaticResource Sectietitel}" />
                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                               Text="Gegevens van de Vereniging als incassant, zoals in het incassocontract met de Rabobank." />
                    <Border Style="{StaticResource Kaart}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="Incassant-_ID" Target="{Binding ElementName=IncassantVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="IncassantVeld" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"
                                     Text="{Binding IncassantId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="IncassantId" />
                            <Label Grid.Row="1" Content="Naa_m (als bij de bank)" Target="{Binding ElementName=IncassoNaamVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="IncassoNaamVeld" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Grid.Row="2" Content="I_BAN" Target="{Binding ElementName=IncassoIbanVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="IncassoIbanVeld" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"
                                     Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Grid.Row="3" Content="Incasso_dag" Target="{Binding ElementName=DagKeuze}" VerticalAlignment="Center" />
                            <ComboBox x:Name="DagKeuze" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"
                                      ItemsSource="{Binding Incassodagen}" SelectedItem="{Binding Incassodag}" />
                            <Label Grid.Row="4" Content="_Eerste incassomaand" Target="{Binding ElementName=EersteMaandKeuze}" VerticalAlignment="Center" />
                            <ComboBox x:Name="EersteMaandKeuze" Grid.Row="4" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                                      ItemsSource="{Binding Maandkeuzes}" SelectedItem="{Binding EersteIncassomaand}"
                                      ToolTip="Eerdere maanden worden nooit via Verenigd geïncasseerd" />
                            <Label Grid.Row="5" Content="_Omschrijving" Target="{Binding ElementName=SjabloonVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="SjabloonVeld" Grid.Row="5" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Omschrijvingssjabloon, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Gebruik {maanden} en {voornamen}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Toelichting}" Margin="0,0,0,8">
                                <Run Text="Voorbeeld: " /><Run Text="{Binding Voorbeeld, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Fout}" Style="{StaticResource Foutmelding}"
                                       Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ===== Facturen (stap 4c-2, besluiten 107 en 112) ===== -->
                <StackPanel DataContext="{Binding Facturen}" Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}" Margin="0,24,0,0"
                            AutomationProperties.AutomationId="InstellingenFacturen">
                    <TextBlock Text="Facturen (Vereniging)" Style="{StaticResource Sectietitel}" />
                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16" TextWrapping="Wrap"
                               Text="De afzender op de verkoopfactuur. Het IBAN komt ook in de betaal-QR-code; het logo wordt in de versleutelde database bewaard." />
                    <Border Style="{StaticResource Kaart}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="Naam _vereniging" Target="{Binding ElementName=FactuurNaamVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="FactuurNaamVeld" Grid.Column="1" Margin="0,0,0,8" MaxLength="100" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="FactuurAfzender" />
                            <Label Grid.Row="1" Content="_Straat en nummer" Target="{Binding ElementName=FactuurStraatVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="FactuurStraatVeld" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" MaxLength="100" Text="{Binding Straat, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Grid.Row="2" Content="_Postcode en plaats" Target="{Binding ElementName=FactuurPostcodeVeld}" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                <TextBox x:Name="FactuurPostcodeVeld" Width="90" MaxLength="10" Margin="0,0,8,0" Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Postcode" />
                                <TextBox MaxLength="100" Text="{Binding Plaats, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Plaats" />
                            </DockPanel>
                            <Label Grid.Row="3" Content="_KvK-nummer" Target="{Binding ElementName=FactuurKvkVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="FactuurKvkVeld" Grid.Row="3" Grid.Column="1" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" MaxLength="20"
                                     Text="{Binding Kvk, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Grid.Row="4" Content="IBAN voor betalin_gen" Target="{Binding ElementName=FactuurIbanVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="FactuurIbanVeld" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas" MaxLength="42"
                                     Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FactuurIban" />
                            <Label Grid.Row="5" Content="E-mai_l" Target="{Binding ElementName=FactuurEmailVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="FactuurEmailVeld" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" MaxLength="254" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Grid.Row="6" Content="_Telefoon" Target="{Binding ElementName=FactuurTelefoonVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="FactuurTelefoonVeld" Grid.Row="6" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8" MaxLength="20"
                                     Text="{Binding Telefoon, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Grid.Row="7" Content="Betaalte_rmijn (dagen)" Target="{Binding ElementName=FactuurTermijnVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="FactuurTermijnVeld" Grid.Row="7" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"
                                     Text="{Binding Termijn, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Grid.Row="8" Content="Tekst onder de _factuur" Target="{Binding ElementName=FactuurVoetVeld}" VerticalAlignment="Center" />
                            <TextBox x:Name="FactuurVoetVeld" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" MaxLength="500" Text="{Binding Voettekst, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="9" Text="Logo" VerticalAlignment="Center" Margin="5,0,0,0" />
                            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding Logotekst}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.AutomationId="FactuurLogo" />
                                <Button Content="Logo kie_zen..." Command="{Binding KiesLogoCommand}" Margin="0,0,8,0" ToolTip="PNG of JPG, maximaal 2 MB" />
                                <Button Content="Logo _wissen" Command="{Binding WisLogoCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}"
                               Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                </StackPanel>
                <TextBlock Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}"
                           Visibility="{Binding Foutmelding, Converter={StaticResource NietNullNaarZichtbaar}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
