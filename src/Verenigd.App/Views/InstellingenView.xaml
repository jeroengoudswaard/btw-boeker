<UserControl x:Class="Verenigd.App.Views.InstellingenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Verenigd.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstellingenViewModel}">
    <DockPanel>
        <!-- Opdrachtbalk onderaan, zoals in Windows-instellingenvensters -->
        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Niet-opgeslagen wijzigingen" Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="0,0,16,0"
                           Visibility="{Binding HeeftOnopgeslagenWijzigingen, Converter={StaticResource BoolNaarZichtbaar}}" />
                <Button Content="Opslaan" MinWidth="96" Command="{Binding OpslaanCommand}"
                        Style="{DynamicResource AccentButtonStyle}" ToolTip="Opslaan (Ctrl+S)"
                        AutomationProperties.AutomationId="InstellingenOpslaan" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource PaginaMarge}" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Instellingen" Style="{StaticResource Paginatitel}" />
                <TextBlock Text="Administraties" Style="{StaticResource Sectietitel}" />
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                           Text="De accentkleur ziet u terug in de tabbladen, de gekleurde band en de statusbalk. Zo is altijd duidelijk in welke administratie u werkt." />

                <ItemsControl ItemsSource="{Binding Regels}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AdministratieInstellingRegel}">
                            <Border Style="{StaticResource Kaart}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.ColumnSpan="2" Text="{Binding Soort}" FontWeight="SemiBold" Margin="0,0,0,12" />

                                    <Label Grid.Row="1" Content="_Naam" Target="{Binding ElementName=NaamInvoer}" VerticalAlignment="Center" />
                                    <TextBox x:Name="NaamInvoer" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                             Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Naam" />

                                    <Label Grid.Row="2" Content="_Accentkleur" Target="{Binding ElementName=KleurInvoer}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox x:Name="KleurInvoer" Width="120" FontFamily="Consolas"
                                                 Text="{Binding KleurHex, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Accentkleur (hexcode)" />
                                        <ItemsControl ItemsSource="{x:Static vm:AdministratieInstellingRegel.Kleurvoorstellen}" Margin="12,0,0,0"
                                                      Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="28" Height="28" Margin="0,0,6,0" Padding="0"
                                                            Background="{Binding}" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                                            Command="{Binding DataContext.KiesKleurCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="14"
                                                                        BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Label Grid.Row="3" Content="Voorbeeld" VerticalAlignment="Center" />
                                    <Border Grid.Row="3" Grid.Column="1" Padding="16,8" CornerRadius="4"
                                            Background="{Binding Voorbeeldkleur, Converter={StaticResource KleurNaarBrush}}">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Naam}"
                                                   Foreground="{Binding Voorbeeldtekstkleur, Converter={StaticResource KleurNaarBrush}}" />
                                    </Border>

                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Fout}" Style="{StaticResource Foutmelding}"
                                               Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
