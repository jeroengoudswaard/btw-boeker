<UserControl x:Class="Verenigd.App.Views.InstellingenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:Verenigd.App.Views.Gedeeld"
             xmlns:vm="clr-namespace:Verenigd.App.ViewModels"
             AutomationProperties.AutomationId="Instellingen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="48,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Niet-opgeslagen wijzigingen" Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="0,0,16,0"
                           Visibility="{Binding HeeftOnopgeslagenWijzigingen, Converter={StaticResource BoolNaarZichtbaar}}" />
                <Button Content="Opslaan" MinWidth="96" Command="{Binding OpslaanCommand}"
                        Style="{DynamicResource AccentButtonStyle}" ToolTip="Opslaan (Ctrl+S)"
                        AutomationProperties.AutomationId="InstellingenOpslaan" />
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}" Margin="48,0,48,8"
                   Visibility="{Binding Foutmelding, Converter={StaticResource NietNullNaarZichtbaar}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Administraties" Style="{StaticResource Paginatitel}" />
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                           Text="Stel per administratie de naam, accentkleur en drempel voor boekingen zonder bon in." />
                <ItemsControl ItemsSource="{Binding Regels}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AdministratieInstellingRegel}">
                            <StackPanel Margin="0,0,0,16">
                                <g:AdministratieKaart />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Label Content="Drempel 'zonder bon' (€)" Target="{Binding ElementName=Drempelveld}" VerticalAlignment="Center" Padding="0,0,8,0" />
                                    <TextBox x:Name="Drempelveld" Width="100" Text="{Binding Drempeltekst, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Uitgaven en ontvangsten van bank of kas vanaf dit bedrag zonder bijlage komen in het filter en op de startpagina"
                                             AutomationProperties.AutomationId="{Binding Soort, StringFormat=Drempel{0}}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
