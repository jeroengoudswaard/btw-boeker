<UserControl x:Class="Verenigd.App.Views.InstellingenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tg="clr-namespace:Verenigd.App.Views.Toegankelijkheid"
             xmlns:g="clr-namespace:Verenigd.App.Views.Gedeeld"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Verenigd.App.ViewModels"
             xmlns:lvm="clr-namespace:Verenigd.App.ViewModels.Leden"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstellingenViewModel}">
    <DockPanel>
        <!-- Opdrachtbalk onderaan, zoals in Windows-instellingenvensters -->
        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Niet-opgeslagen wijzigingen" Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="0,0,16,0"
                           Visibility="{Binding HeeftOnopgeslagenWijzigingen, Converter={StaticResource BoolNaarZichtbaar}}" />
                <Button Content="Opslaan" MinWidth="96" Command="{Binding OpslaanCommand}"
                        Style="{DynamicResource AccentButtonStyle}" ToolTip="Opslaan (Ctrl+S)"
                        AutomationProperties.AutomationId="InstellingenOpslaan" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource PaginaMarge}" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Instellingen" Style="{StaticResource Paginatitel}" />
                <TextBlock Text="Administraties" Style="{StaticResource Sectietitel}" />
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                           Text="De accentkleur ziet u terug in de wisselaar links bovenaan, de gekleurde band en de statusbalk. Zo is altijd duidelijk in welke administratie u werkt." />

                <ItemsControl ItemsSource="{Binding Regels}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AdministratieInstellingRegel}">
                            <StackPanel Margin="0,0,0,16">
                                <g:AdministratieKaart />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Label Content="Drempel 'zonder bon' (€)" Target="{Binding ElementName=Drempelveld}" VerticalAlignment="Center" Padding="0,0,8,0" />
                                    <TextBox x:Name="Drempelveld" Width="100" Text="{Binding Drempeltekst, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Uitgaven en ontvangsten van bank of kas vanaf dit bedrag zonder bijlage komen in het filter en op de startpagina"
                                             AutomationProperties.AutomationId="{Binding Soort, StringFormat=Drempel{0}}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== Incasso (fase 3) ===== -->
                <tg:Groepspaneel DataContext="{Binding Incasso}" Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}"
                            AutomationProperties.Name="Incasso (Vereniging)" AutomationProperties.AutomationId="InstellingenIncasso">
                    <TextBlock Text="Incasso (Vereniging)" Style="{StaticResource Sectietitel}" />
                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16"
                               Text="Gegevens van de Vereniging als incassant, zoals in het incassocontract met de Rabobank." />
                    <g:IncassoKaart />
                </tg:Groepspaneel>

                <!-- ===== Facturen per administratie (besluiten 112 en 209) ===== -->
                <ItemsControl ItemsSource="{Binding Facturen}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <tg:Groepspaneel Margin="0,24,0,0" AutomationProperties.Name="{Binding Titel}" AutomationProperties.AutomationId="{Binding Administratie, StringFormat=InstellingenFacturen{0}}">
                                <TextBlock Text="{Binding Titel}" Style="{StaticResource Sectietitel}" />
                                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16" TextWrapping="Wrap"
                                           Text="De afzender op de verkoopfactuur. Het IBAN komt ook in de betaal-QR-code; het logo wordt in de versleutelde database bewaard." />
                                <Border Style="{StaticResource Kaart}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label Content="Naam _vereniging" Target="{Binding ElementName=FactuurNaamVeld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="FactuurNaamVeld" Grid.Column="1" Margin="0,0,0,8" MaxLength="100" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="{Binding Administratie, StringFormat=FactuurAfzender{0}}" />
                                        <Label Grid.Row="1" Content="_Straat en nummer" Target="{Binding ElementName=FactuurStraatVeld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="FactuurStraatVeld" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" MaxLength="100" Text="{Binding Straat, UpdateSourceTrigger=PropertyChanged}" />
                                        <Label Grid.Row="2" Content="_Postcode en plaats" Target="{Binding ElementName=FactuurPostcodeVeld}" VerticalAlignment="Center" />
                                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                            <TextBox x:Name="FactuurPostcodeVeld" Width="90" MaxLength="10" Margin="0,0,8,0" Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Postcode" />
                                            <TextBox MaxLength="100" Text="{Binding Plaats, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Plaats" />
                                        </DockPanel>
                                        <Label Grid.Row="3" Content="_KvK-nummer" Target="{Binding ElementName=FactuurKvkVeld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="FactuurKvkVeld" Grid.Row="3" Grid.Column="1" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" MaxLength="20"
                                                 Text="{Binding Kvk, UpdateSourceTrigger=PropertyChanged}" />
                                        <Label Grid.Row="4" Content="IBAN voor betalin_gen" Target="{Binding ElementName=FactuurIbanVeld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="FactuurIbanVeld" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas" MaxLength="42"
                                                 Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="{Binding Administratie, StringFormat=FactuurIban{0}}" />
                                        <Label Grid.Row="5" Content="E-mai_l" Target="{Binding ElementName=FactuurEmailVeld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="FactuurEmailVeld" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" MaxLength="254" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                        <Label Grid.Row="6" Content="_Telefoon" Target="{Binding ElementName=FactuurTelefoonVeld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="FactuurTelefoonVeld" Grid.Row="6" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8" MaxLength="20"
                                                 Text="{Binding Telefoon, UpdateSourceTrigger=PropertyChanged}" />
                                        <Label Grid.Row="7" Content="Betaalte_rmijn (dagen)" Target="{Binding ElementName=FactuurTermijnVeld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="FactuurTermijnVeld" Grid.Row="7" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                 Text="{Binding Termijn, UpdateSourceTrigger=PropertyChanged}" />
                                        <Label Grid.Row="8" Content="Tekst onder de _factuur" Target="{Binding ElementName=FactuurVoetVeld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="FactuurVoetVeld" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" MaxLength="500" Text="{Binding Voettekst, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="9" Text="Logo" VerticalAlignment="Center" Margin="5,0,0,0" />
                                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Logotekst}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.AutomationId="{Binding Administratie, StringFormat=FactuurLogo{0}}" />
                                            <Button Content="Logo kie_zen..." Command="{Binding KiesLogoCommand}" Margin="0,0,8,0" ToolTip="PNG of JPG, maximaal 2 MB" />
                                            <Button Content="Logo _wissen" Command="{Binding WisLogoCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}"
                                           Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                            </tg:Groepspaneel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== E-mail per administratie (besluiten 192, 193 en 211) ===== -->
                <ItemsControl ItemsSource="{Binding Emailkoppelingen}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <tg:Groepspaneel Margin="0,24,0,0" AutomationProperties.Name="{Binding Titel}" AutomationProperties.AutomationId="{Binding Administratie, StringFormat=InstellingenEmail{0}}">
                                <TextBlock Text="{Binding Titel}" Style="{StaticResource Sectietitel}" />
                                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16" TextWrapping="Wrap"
                                           Text="Elke administratie verstuurt via een eigen Gmail-account, met alleen toestemming om te versturen (geen wachtwoord in de app). Maak eenmalig een eigen Google Cloud-project; de stappen staan in docs/GOOGLE-CLOUD.md. Adres en sleutels staan versleuteld in de database." />
                                <Border Style="{StaticResource Kaart}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label Content="_Uw naam (afzender)" Target="{Binding ElementName=AfzendernaamVeld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="AfzendernaamVeld" Grid.Column="1" Margin="0,0,0,8" MaxLength="100" Text="{Binding Afzendernaam, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Bijvoorbeeld: Penningmeester Scouting" AutomationProperties.AutomationId="{Binding Administratie, StringFormat=Afzendernaam{0}}" />
                                        <Label Grid.Row="1" Content="_Het Gmail-adres" Target="{Binding ElementName=AfzenderadresVeld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="AfzenderadresVeld" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" MaxLength="254" Text="{Binding Afzenderadres, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Het gmail.com-adres waarmee u bij Google toestemming geeft" AutomationProperties.AutomationId="{Binding Administratie, StringFormat=Afzenderadres{0}}" />
                                        <TextBlock Grid.Row="2" Text="Clientbestand" VerticalAlignment="Center" Margin="5,0,0,8" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Clienttekst}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="300"
                                                       AutomationProperties.AutomationId="{Binding Administratie, StringFormat=Clientbestand{0}}" />
                                            <Button Content="_Clientbestand inlezen..." Command="{Binding LeesClientbestandCommand}"
                                                    ToolTip="Het JSON-bestand van een OAuth-client van het type Desktop-app" AutomationProperties.AutomationId="{Binding Administratie, StringFormat=ClientbestandInlezen{0}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Text="Koppeling" VerticalAlignment="Top" Margin="5,6,0,0" />
                                        <StackPanel Grid.Row="3" Grid.Column="1">
                                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,8" AutomationProperties.AutomationId="{Binding Administratie, StringFormat=EmailStatus{0}}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Koppelen met Google..." Command="{Binding KoppelCommand}" Margin="0,0,8,0"
                                                        ToolTip="Opent de browser; geef daar toestemming om e-mail te versturen" AutomationProperties.AutomationId="{Binding Administratie, StringFormat=EmailKoppelen{0}}" />
                                                <Button Content="Ontkoppelen..." Command="{Binding OntkoppelCommand}" AutomationProperties.AutomationId="{Binding Administratie, StringFormat=EmailOntkoppelen{0}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}"
                                           Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                            </tg:Groepspaneel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- ===== Groepen (besluit 215) ===== -->
                <tg:Groepspaneel DataContext="{Binding Groepen}" Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}" Margin="0,24,0,0"
                                 AutomationProperties.Name="Groepen" AutomationProperties.AutomationId="InstellingenGroepen">
                    <TextBlock Text="Groepen" Style="{StaticResource Sectietitel}" />
                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,16" TextWrapping="Wrap"
                               Text="Het soort van elke groep uit SOL3. Speltakken bepalen de voorgestelde contributiecategorie en de speltak in e-mails; technische groepen zijn standaard verborgen." />
                    <TextBlock Style="{StaticResource Toelichting}" Text="Nog geen groepen: lees eerst de leden in uit SOL3."
                               Visibility="{Binding Regels.Count, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=0}" />
                    <ItemsControl ItemsSource="{Binding Regels}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding Source={x:Static lvm:GroepenInstellingenViewModel.Soorten}}"
                                              SelectedItem="{Binding Soort}" AutomationProperties.Name="{Binding Naam, StringFormat='Soort van {0}'}" />
                                    <TextBlock Text="{Binding Naam}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </tg:Groepspaneel>
                <TextBlock Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}"
                           Visibility="{Binding Foutmelding, Converter={StaticResource NietNullNaarZichtbaar}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
