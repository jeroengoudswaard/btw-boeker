<Window x:Class="Verenigd.App.Views.Boekhouding.BoekhoudingImportVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tg="clr-namespace:Verenigd.App.Views.Toegankelijkheid"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Verenigd.App.ViewModels.Boekhouding"
        xmlns:boek="clr-namespace:Verenigd.Domain.Financien.Boekhouding;assembly=Verenigd.Domain"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BoekhoudingImportViewModel}"
        Title="Boekhouding overnemen uit Excel"
        Width="920" Height="640" MinWidth="680" MinHeight="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="BoekhoudingImport">
    <Window.Resources>
        <ObjectDataProvider x:Key="Soorten" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="boek:RekeningSoort" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="Stappen">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,24,0" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock x:Name="Stap1" Text="1  Bestand" />
                <TextBlock x:Name="Stap2" Text="2  Rekeningen" />
                <TextBlock x:Name="Stap3" Text="3  Beginbalans" />
                <TextBlock x:Name="Stap4" Text="4  Klaar" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Left" Width="120" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding IsBezig, Converter={StaticResource BoolNaarZichtbaar}}" AutomationProperties.Name="Bezig" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt; V_orige" Style="{StaticResource DialoogKnop}" Command="{Binding VorigeCommand}"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}" AutomationProperties.AutomationId="BoekhoudingImportVorige" />
                    <Button Style="{StaticResource DialoogKnop}" IsDefault="True" Command="{Binding VolgendeCommand}"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}" AutomationProperties.AutomationId="BoekhoudingImportVolgende">
                        <AccessText Text="{Binding Volgendetekst, StringFormat='_{0} &gt;'}" />
                    </Button>
                    <Button Content="Annuleren" Style="{StaticResource DialoogKnop}" IsCancel="True"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}" AutomationProperties.AutomationId="BoekhoudingImportAnnuleren" />
                    <Button Content="Sluiten" Style="{StaticResource DialoogKnop}" IsDefault="True" Click="Sluiten_Click"
                            Visibility="{Binding IsKlaar, Converter={StaticResource BoolNaarZichtbaar}}" AutomationProperties.AutomationId="BoekhoudingImportSluiten" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Margin="24,0,24,8" Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}"
                   Visibility="{Binding Foutmelding, Converter={StaticResource NietNullNaarZichtbaar}}" AutomationProperties.LiveSetting="Assertive" />

        <Grid Margin="24,16">
            <!-- ===== Stap 1: bestand ===== -->
            <StackPanel MaxWidth="560" HorizontalAlignment="Left"
                        Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Bestand}">
                <TextBlock Style="{StaticResource Sectietitel}"><Run Text="Bestand: " /><Run Text="{Binding Bestandsnaam, Mode=OneWay}" /></TextBlock>
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,12"
                           Text="Verenigd leest het werkblad 'Voorblad': het rekeningschema met rubrieken en de eindbalans per 31-12, die de beginbalans van het volgende jaar wordt. De boekingen zelf worden niet overgenomen." />
                <TextBlock Style="{StaticResource Toelichting}"
                           Text="Het Excel-bestand wordt alleen gelezen en niet bewaard. De overname kan één keer, in een lege administratie; vooraf wordt een back-up gemaakt." />
            </StackPanel>

            <!-- ===== Stap 2: rekeningen ===== -->
            <DockPanel Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Rekeningen}">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Toelichting}" Margin="0,0,0,8"
                           Text="Controleer per rekening de soort (balans of resultaat). Rekeningen met 'Overslaan' worden niet overgenomen, zoals 9990 Memoriaal." />
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Meldingen}" Focusable="False" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Foutmelding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DataGrid ItemsSource="{Binding Rekeningen}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" AutomationProperties.Name="Rekeningen uit Excel" AutomationProperties.AutomationId="ImportRekeningen">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nummer" Binding="{Binding Nummer}" IsReadOnly="True" Width="Auto" />
                        <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" IsReadOnly="True" Width="2*" />
                        <DataGridTextColumn Header="Rubriek" Binding="{Binding Rubriek}" IsReadOnly="True" Width="*" />
                        <DataGridTemplateColumn Header="Soort" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ImportRekeningRegel}">
                                    <ComboBox ItemsSource="{Binding Source={StaticResource Soorten}}" SelectedItem="{Binding Soort, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.Name="{Binding Naam, StringFormat=Soort van {0}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Rol" Binding="{Binding Roltekst}" IsReadOnly="True" Width="Auto" />
                        <DataGridTextColumn Header="Debet" Binding="{Binding Debettekst}" IsReadOnly="True" Width="Auto" />
                        <DataGridTextColumn Header="Credit" Binding="{Binding Credittekst}" IsReadOnly="True" Width="Auto" />
                        <DataGridTemplateColumn Header="Overslaan" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ImportRekeningRegel}">
                                    <CheckBox IsChecked="{Binding Overslaan, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                              AutomationProperties.Name="{Binding Naam, StringFormat={}{0} overslaan}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ===== Stap 3: beginbalans ===== -->
            <DockPanel Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Beginbalans}">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Beginbalanstitel}" Style="{StaticResource Sectietitel}" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock>
                        <Run Text="Totaal debet " /><Run Text="{Binding TotaalDebettekst, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="   ·   totaal credit " /><Run Text="{Binding TotaalCredittekst, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="De beginbalans is in evenwicht." Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                               Visibility="{Binding IsInEvenwicht, Converter={StaticResource BoolNaarZichtbaar}}" />
                    <tg:Groepskader Style="{StaticResource Kaart}" Margin="0,8,0,0" AutomationProperties.Name="Verschil in de beginbalans" AutomationProperties.AutomationId="BeginbalansVerschil"
                            Visibility="{Binding IsInEvenwicht, Converter={StaticResource OnwaarNaarZichtbaar}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Foutmelding}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite">
                                <Run Text="De beginbalans is niet in evenwicht: verschil " /><Run Text="{Binding Verschiltekst, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Zonder keuze wordt er niets geïmporteerd." />
                            </TextBlock>
                            <CheckBox Content="Het verschil _bewust boeken op een tussenrekening (te onderzoeken)" IsChecked="{Binding VerschilBewustBoeken}"
                                      AutomationProperties.AutomationId="VerschilBewustBoeken" />
                            <StackPanel Orientation="Horizontal" Margin="24,8,0,0" IsEnabled="{Binding VerschilBewustBoeken}">
                                <Label Content="_Rekening" Target="{Binding ElementName=Verschilnummer}" VerticalAlignment="Center" Padding="0,0,8,0" />
                                <TextBox x:Name="Verschilnummer" Width="80" Text="{Binding Verschilnummer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <TextBox Width="260" Text="{Binding Verschilnaam, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Naam van de tussenrekening" />
                            </StackPanel>
                            <TextBlock Text="{Binding Verschilfout}" Style="{StaticResource Foutmelding}" Margin="24,4,0,0"
                                       Visibility="{Binding Verschilfout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                            <TextBlock Style="{StaticResource Toelichting}" Margin="0,8,0,0"
                                       Text="Het verschil komt als aparte regel op de openingsbalans en in het logboek. Zoek het daarna uit en boek het met een memoriaalpost weg." />
                        </StackPanel>
                    </tg:Groepskader>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Beginbalans}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          AutomationProperties.Name="Beginbalans">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nummer" Binding="{Binding Nummer}" Width="Auto" />
                        <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="2*" />
                        <DataGridTextColumn Header="Rubriek" Binding="{Binding Rubriek}" Width="*" />
                        <DataGridTextColumn Header="Debet" Binding="{Binding Debettekst}" Width="Auto" />
                        <DataGridTextColumn Header="Credit" Binding="{Binding Credittekst}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ===== Stap 4: klaar ===== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                        Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Klaar}">
                <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE930;" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock Text="Boekhouding overgenomen" Style="{StaticResource Sectietitel}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Samenvatting}" Style="{StaticResource Toelichting}" AutomationProperties.AutomationId="BoekhoudingImportSamenvatting" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
