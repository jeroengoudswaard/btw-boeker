                    </Grid>
                </TabItem>

                <!-- ===== Relaties (gedeeld door beide administraties, besluiten 105 en 108) ===== -->
                <TabItem Header="Re_laties" AutomationProperties.AutomationId="SubtabRelaties">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="3*" MinWidth="420" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Content="Nieu_we relatie" Command="{Binding NieuweRelatieCommand}" AutomationProperties.AutomationId="NieuweRelatie" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Relaties (zoals huurders en sponsors) gelden voor beide administraties en staan los van de leden. Opslaan met Ctrl+S." />
                            <DataGrid ItemsSource="{Binding Relaties}" SelectedItem="{Binding GeselecteerdeRelatie}" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Relaties"
                                      AutomationProperties.AutomationId="Relaties">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="*" />
                                    <DataGridTextColumn Header="Plaats" Binding="{Binding Plaats}" Width="Auto" />
                                    <DataGridTextColumn Header="Soort" Binding="{Binding Rol}" Width="Auto" />
                                    <DataGridCheckBoxColumn Header="Actief" Binding="{Binding IsActief}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <TextBlock Grid.Column="2" Text="Selecteer een relatie of kies Nieuwe relatie." Style="{StaticResource Toelichting}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding GeselecteerdeRelatie, Converter={StaticResource NullNaarZichtbaar}}" />
                        <tg:Groepskader Grid.Column="2" Style="{StaticResource Kaart}" DataContext="{Binding GeselecteerdeRelatie}" d:DataContext="{d:DesignInstance Type=vm:RelatieRegel}"
                                Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}" AutomationProperties.Name="Relatie" AutomationProperties.AutomationId="RelatieEditor">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Content="_Naam" Target="{Binding ElementName=RelatieNaam}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieNaam" Grid.Column="1" Margin="0,0,0,8" MaxLength="100" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="RelatieNaam" />
                                <Label Grid.Row="1" Content="C_ontactpersoon" Target="{Binding ElementName=RelatieContact}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieContact" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" MaxLength="100" Text="{Binding Contactpersoon, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Grid.Row="2" Content="Straat en n_ummer" Target="{Binding ElementName=RelatieStraat}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieStraat" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" MaxLength="100" Text="{Binding Straat, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Grid.Row="3" Content="Pos_tcode en plaats" Target="{Binding ElementName=RelatiePostcode}" VerticalAlignment="Center" />
                                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBox x:Name="RelatiePostcode" Width="90" MaxLength="10" Margin="0,0,8,0" Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Postcode" />
                                    <TextBox MaxLength="100" Text="{Binding Plaats, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Plaats" />
                                </DockPanel>
                                <Label Grid.Row="4" Content="E-_mail" Target="{Binding ElementName=RelatieEmail}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieEmail" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" MaxLength="254" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Grid.Row="5" Content="Telefoon" Target="{Binding ElementName=RelatieTelefoon}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieTelefoon" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" MaxLength="20" Text="{Binding Telefoon, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Grid.Row="6" Content="_IBAN" Target="{Binding ElementName=RelatieIban}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieIban" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas" MaxLength="42"
                                         Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}" ToolTip="Wordt gebruikt om betalingen in de bank te herkennen"
                                         AutomationProperties.AutomationId="RelatieIban" />
                                <TextBlock Grid.Row="7" Text="Soort" VerticalAlignment="Center" Margin="5,0,0,8" />
                                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="Debiteur" IsChecked="{Binding IsDebiteur}" Margin="0,0,16,0" />
                                    <CheckBox Content="Crediteur" IsChecked="{Binding IsCrediteur}" Margin="0,0,16,0" />
                                    <CheckBox Content="Actief" IsChecked="{Binding IsActief}" />
                                </StackPanel>
                                <Label Grid.Row="8" Content="Notitie" Target="{Binding ElementName=RelatieNotitie}" VerticalAlignment="Top" />
                                <TextBox x:Name="RelatieNotitie" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"
                                         MaxLength="2000" Text="{Binding Notitie, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Fout}" Style="{StaticResource Foutmelding}" AutomationProperties.AutomationId="RelatieFout"
                                           Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                            </Grid>
                        </tg:Groepskader>
                    </Grid>
                </TabItem>

                <!-- ===== Rekeningschema ===== -->
                <TabItem Header="{DynamicResource T.Tab.Rekeningschema}" ToolTip="{DynamicResource U.Rekeningschema}" AutomationProperties.AutomationId="SubtabRekeningschema">
                    <DockPanel Margin="0,12,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button Content="{DynamicResource T.Knop.NieuweRekening}" Command="{Binding NieuweRekeningCommand}" Margin="0,0,24,0" AutomationProperties.AutomationId="NieuweRekening" />
                            <TextBox Width="200" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding NieuweRubriekNaam, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Naam van de nieuwe rubriek" />
                            <Button Content="{DynamicResource T.Knop.RubriekToevoegen}" Command="{Binding NieuweRubriekCommand}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0"
                                   Text="Opslaan met Ctrl+S. Het nummer van een bestaande rekening en de soort van een rekening waarop al is geboekt staan vast; een rekening die niet meer wordt gebruikt kunt u inactief maken." />
                        <DataGrid ItemsSource="{Binding Rekeningen}" SelectedItem="{Binding GeselecteerdeRekening}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                                  AutomationProperties.Name="Rekeningschema" AutomationProperties.AutomationId="Rekeningschema">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Nummer" Width="90" SortMemberPath="Nummer">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <TextBox Text="{Binding Nummertekst, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsNieuw, Converter={StaticResource Niet}}"
                                                     AutomationProperties.Name="Rekeningnummer" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Naam" Width="2*" SortMemberPath="Naam">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <TextBox Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Naam van de rekening" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource T.Rubriek}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <ComboBox ItemsSource="{Binding DataContext.Rubrieken, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding GekozenRubriek, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Naam"
                                                      AutomationProperties.Name="Rubriek" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Soort" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <ComboBox ItemsSource="{Binding DataContext.Soorten, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Soort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Soort" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource T.Kant}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <ComboBox ItemsSource="{x:Static vm:RekeningRegel.Kanten}" SelectedItem="{Binding Kant, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding KantIsKiesbaar}" AutomationProperties.Name="Baten of lasten"
                                                      ToolTip="Baten (inkomsten) of lasten (uitgaven); nodig voor de begroting. Alleen bij resultaatrekeningen." />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Rol" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <ComboBox ItemsSource="{Binding DataContext.Rollen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Rol, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rol"
                                                      ToolTip="Reserve: hierheen gaat het resultaat bij de jaarafsluiting. Kruisposten: tussenrekening voor overboekingen. Kas: rekening van het kasboek." />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actief" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <CheckBox IsChecked="{Binding IsActief, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" AutomationProperties.Name="Actief" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldotekst}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Let op" Binding="{Binding Fout}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Grootboekkaart ===== -->
                <TabItem Header="{DynamicResource T.Tab.Grootboekkaart}" ToolTip="{DynamicResource U.Grootboekkaart}" AutomationProperties.AutomationId="SubtabGrootboekkaart">
                    <DockPanel Margin="0,12,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Label Content="{DynamicResource T.Label.Rekening}" Target="{Binding ElementName=Kaartrekening}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <ComboBox x:Name="Kaartrekening" ItemsSource="{Binding Rekeningkeuzes}" SelectedItem="{Binding KaartRekening}" Width="280"
                                      IsTextSearchEnabled="True" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.AutomationId="KaartRekening" />
                            <Label Content="_Van" Target="{Binding ElementName=KaartVan}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <DatePicker x:Name="KaartVan" SelectedDate="{Binding KaartVan}" Width="130" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Label Content="_Tot en met" Target="{Binding ElementName=KaartTot}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <DatePicker x:Name="KaartTot" SelectedDate="{Binding KaartTot}" Width="130" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Run Text="Beginsaldo " /><Run Text="{Binding KaartBeginsaldo, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="   ·   eindsaldo " /><Run Text="{Binding KaartEindsaldo, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="   (positief = debet)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" Text="{Binding KaartVoorbladtekst}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="KaartVoorblad" AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding KaartVoorbladtekst, Converter={StaticResource NietNullNaarZichtbaar}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Toelichting}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KaartWijktAf}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding KaartMutaties}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  AutomationProperties.Name="Mutaties op de grootboekkaart" AutomationProperties.AutomationId="KaartMutaties">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="Auto" />
                                <DataGridTextColumn Header="Nummer" Binding="{Binding Nummer}" Width="Auto" />
                                <DataGridTextColumn Header="Omschrijving" Binding="{Binding Omschrijving}" Width="*" />
                                <DataGridTextColumn Binding="{Binding Debet}" Width="Auto">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding Data.KaartDebetkop, Source={StaticResource Kaartproxy}}" ToolTip="{Binding Data.KaartKoptip, Source={StaticResource Kaartproxy}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Credit}" Width="Auto">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding Data.KaartCreditkop, Source={StaticResource Kaartproxy}}" ToolTip="{Binding Data.KaartKoptip, Source={StaticResource Kaartproxy}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Rapporten ===== -->
                <TabItem Header="{DynamicResource T.Tab.Rapporten}" AutomationProperties.AutomationId="SubtabRapporten">
                    <DockPanel Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Label Content="Rapport" Target="{Binding ElementName=Rapportkeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <ComboBox x:Name="Rapportkeuze" ItemsSource="{Binding Rapportkeuzes}" SelectedValuePath="Soort" DisplayMemberPath="Naam"
                                      SelectedValue="{Binding Rapportsoort}" Width="240" AutomationProperties.AutomationId="Rapportkeuze" />
                            <TextBlock Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Text="Alleen geboekte posten tellen mee." />
                        </StackPanel>
                        <FlowDocumentScrollViewer Document="{Binding Rapport, Converter={StaticResource RapportNaarDocument}}" VerticalScrollBarVisibility="Auto"
                                                  IsToolBarVisible="False" AutomationProperties.Name="Rapport" AutomationProperties.AutomationId="Rapport" />
                    </DockPanel>
                </TabItem>

                <!-- ===== Begroting (fase 5a, besluiten 146–155) ===== -->
                <TabItem Header="{DynamicResource T.Tab.Begroting}" ToolTip="{DynamicResource U.Begroting}" AutomationProperties.AutomationId="SubtabBegroting">
                    <DockPanel Margin="0,12,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Label Content="_Jaar" Target="{Binding ElementName=Begrotingsjaarkeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <ComboBox x:Name="Begrotingsjaarkeuze" ItemsSource="{Binding Begrotingsjaren}" SelectedItem="{Binding Begrotingsjaar}" Width="90"
                                      Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Begrotingsjaar" />
                            <Label Content="_Versie" Target="{Binding ElementName=Begrotingsversiekeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <ComboBox x:Name="Begrotingsversiekeuze" ItemsSource="{Binding Begrotingsversies}" SelectedItem="{Binding GekozenBegrotingsversie}"
                                      DisplayMemberPath="Tekst" MinWidth="300" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Begrotingsversie" />
                            <Button Content="{DynamicResource T.Knop.BegrotingMaken}" Command="{Binding BegrotingMakenCommand}" VerticalAlignment="Center"
                                    Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}" AutomationProperties.AutomationId="BegrotingMaken"
                                    Visibility="{Binding HeeftBegroting, Converter={StaticResource OnwaarNaarZichtbaar}}" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding IsBegrotingBewerkbaar, Converter={StaticResource BoolNaarZichtbaar}}">
