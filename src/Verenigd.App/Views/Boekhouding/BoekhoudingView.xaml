                    </DockPanel>
                </TabItem>

                <!-- ===== Facturen (stap 4c-2, besluiten 66 en 105–112) ===== -->
                <TabItem Header="_Facturen" AutomationProperties.AutomationId="SubtabFacturen">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="3*" MinWidth="460" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Content="Nieu_we factuur" Command="{Binding NieuweFactuurCommand}" Margin="0,0,16,0"
                                        ToolTip="Een nieuwe verkoopfactuur (Ctrl+N blijft Nieuwe post)" AutomationProperties.AutomationId="NieuweFactuur" />
                                <Label Content="T_onen" Target="{Binding ElementName=Factuurfilterkeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                                <ComboBox x:Name="Factuurfilterkeuze" ItemsSource="{Binding Factuurfilters}" SelectedItem="{Binding Factuurfilter}" Width="120"
                                          VerticalAlignment="Center" AutomationProperties.AutomationId="Factuurfilter" />
                            </WrapPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Factuuraantaltekst}" Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Command="{Binding FactuurPdfCommand}" Margin="0,0,8,0" ToolTip="De factuur opslaan als PDF met betaal-QR-code"
                                        AutomationProperties.AutomationId="FactuurPdf">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xEA90;" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <AccessText Text="Als PDF opslaa_n..." />
                                    </StackPanel>
                                </Button>
                                <Button Content="Cred_itfactuur..." Command="{Binding CreditfactuurCommand}" Margin="0,0,8,0"
                                        ToolTip="Een definitieve factuur corrigeren of intrekken" AutomationProperties.AutomationId="Creditfactuur" />
                                <Button Content="Concept _verwijderen" Command="{Binding VerwijderFactuurconceptCommand}" AutomationProperties.AutomationId="FactuurconceptVerwijderen" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Facturen}" SelectedItem="{Binding GeselecteerdeFactuur}" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Verkoopfacturen"
                                      AutomationProperties.AutomationId="Verkoopfacturen">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVervallen}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="ToolTip" Value="Vervallen: de betaaltermijn is verstreken" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nummer" Binding="{Binding Nummer}" Width="Auto" />
                                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="Auto" />
                                    <DataGridTextColumn Header="Relatie" Binding="{Binding Relatie}" Width="*" />
                                    <DataGridTextColumn Header="Totaal" Binding="{Binding Totaal}" Width="Auto" />
                                    <DataGridTextColumn Header="Open" Binding="{Binding Open}" Width="Auto" />
                                    <DataGridTextColumn Header="Vervalt" Binding="{Binding Vervaldatum}" Width="Auto" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <TextBlock Grid.Column="2" Style="{StaticResource Toelichting}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Selecteer een conceptfactuur of kies Nieuwe factuur. Een definitieve factuur is onveranderlijk; corrigeren gaat met een creditfactuur."
                                   Visibility="{Binding FactuurEditor, Converter={StaticResource NullNaarZichtbaar}}" />
                        <Border Grid.Column="2" Style="{StaticResource Kaart}" DataContext="{Binding FactuurEditor}" d:DataContext="{d:DesignInstance Type=vm:FactuurEditor}"
                                Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}" AutomationProperties.AutomationId="FactuurEditor">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Titel}" Style="{StaticResource Sectietitel}" />
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Content="Rela_tie" Target="{Binding ElementName=Factuurrelatie}" Padding="0,0,0,4" />
                                    <ComboBox x:Name="Factuurrelatie" Grid.Row="1" ItemsSource="{Binding Relatiekeuzes}" SelectedItem="{Binding Relatie}" DisplayMemberPath="Naam"
                                              IsTextSearchEnabled="True" IsEnabled="{Binding IsCreditfactuur, Converter={StaticResource Niet}}"
                                              AutomationProperties.AutomationId="FactuurRelatie" />
                                    <Label Grid.Column="2" Content="Factuurdat_um" Target="{Binding ElementName=Factuurdatum}" Padding="0,0,0,4" />
                                    <DatePicker x:Name="Factuurdatum" Grid.Column="2" Grid.Row="1" SelectedDate="{Binding Datum}" Width="140"
                                                AutomationProperties.AutomationId="FactuurDatum" />
                                    <Label Grid.Column="4" Content="Ter_mijn (dagen)" Target="{Binding ElementName=Factuurtermijn}" Padding="0,0,0,4" />
                                    <TextBox x:Name="Factuurtermijn" Grid.Column="4" Grid.Row="1" Width="80" Text="{Binding Termijn, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FactuurTermijn" />
                                </Grid>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <TextBlock>
                                        <Run Text="Totaal " /><Run Text="{Binding Totaaltekst, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  geen btw" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Fouttekst}" Style="{StaticResource Foutmelding}" Margin="0,4,0,0" AutomationProperties.AutomationId="FactuurFouten"
                                               Visibility="{Binding Fouttekst, Converter={StaticResource NietNullNaarZichtbaar}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Definitief ma_ken..." MinWidth="96" Style="{DynamicResource AccentButtonStyle}"
                                                Command="{Binding DataContext.MaakFactuurDefinitiefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Nummer toekennen en boeken in het verkoopdagboek. Daarna kan de factuur niet meer worden gewijzigd."
                                                AutomationProperties.AutomationId="FactuurDefinitief" />
                                    </StackPanel>
                                </StackPanel>

                                <Button DockPanel.Dock="Bottom" Content="E_xtra regel" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding RegelToevoegenCommand}"
                                        AutomationProperties.AutomationId="FactuurregelToevoegen" />
                                <DataGrid ItemsSource="{Binding Regels}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserSortColumns="False" HeadersVisibility="Column"
                                          AutomationProperties.Name="Factuurregels" AutomationProperties.AutomationId="Factuurregels">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Omschrijving" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:FactuurregelRij}">
                                                    <TextBox Text="{Binding Omschrijving, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Omschrijving" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Aantal" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:FactuurregelRij}">
                                                    <TextBox Text="{Binding Aantal, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Aantal" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Prijs" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:FactuurregelRij}">
                                                    <TextBox Text="{Binding Prijs, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Prijs" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Opbrengstrekening" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:FactuurregelRij}">
                                                    <ComboBox ItemsSource="{Binding DataContext.Rekeningkeuzes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              SelectedItem="{Binding Rekening, UpdateSourceTrigger=PropertyChanged}"
                                                              IsTextSearchEnabled="True" AutomationProperties.Name="Opbrengstrekening" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Bedrag" Binding="{Binding Bedragtekst}" IsReadOnly="True" Width="Auto" />
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:FactuurregelRij}">
                                                    <Button FontFamily="{StaticResource Pictogrammen}" Content="&#xE74D;" Padding="6,2" ToolTip="Regel verwijderen"
                                                            AutomationProperties.Name="Regel verwijderen"
                                                            Command="{Binding DataContext.RegelVerwijderenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== Relaties (gedeeld door beide administraties, besluiten 105 en 108) ===== -->
                <TabItem Header="Re_laties" AutomationProperties.AutomationId="SubtabRelaties">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="3*" MinWidth="420" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Content="Nieu_we relatie" Command="{Binding NieuweRelatieCommand}" AutomationProperties.AutomationId="NieuweRelatie" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Relaties (zoals huurders en sponsors) gelden voor beide administraties en staan los van de leden. Opslaan met Ctrl+S." />
                            <DataGrid ItemsSource="{Binding Relaties}" SelectedItem="{Binding GeselecteerdeRelatie}" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Relaties"
                                      AutomationProperties.AutomationId="Relaties">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="*" />
                                    <DataGridTextColumn Header="Plaats" Binding="{Binding Plaats}" Width="Auto" />
                                    <DataGridTextColumn Header="Soort" Binding="{Binding Rol}" Width="Auto" />
                                    <DataGridCheckBoxColumn Header="Actief" Binding="{Binding IsActief}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <TextBlock Grid.Column="2" Text="Selecteer een relatie of kies Nieuwe relatie." Style="{StaticResource Toelichting}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding GeselecteerdeRelatie, Converter={StaticResource NullNaarZichtbaar}}" />
                        <Border Grid.Column="2" Style="{StaticResource Kaart}" DataContext="{Binding GeselecteerdeRelatie}" d:DataContext="{d:DesignInstance Type=vm:RelatieRegel}"
                                Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}" AutomationProperties.AutomationId="RelatieEditor">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Content="_Naam" Target="{Binding ElementName=RelatieNaam}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieNaam" Grid.Column="1" Margin="0,0,0,8" MaxLength="100" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="RelatieNaam" />
                                <Label Grid.Row="1" Content="C_ontactpersoon" Target="{Binding ElementName=RelatieContact}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieContact" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" MaxLength="100" Text="{Binding Contactpersoon, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Grid.Row="2" Content="Straat en n_ummer" Target="{Binding ElementName=RelatieStraat}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieStraat" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" MaxLength="100" Text="{Binding Straat, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Grid.Row="3" Content="Pos_tcode en plaats" Target="{Binding ElementName=RelatiePostcode}" VerticalAlignment="Center" />
                                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBox x:Name="RelatiePostcode" Width="90" MaxLength="10" Margin="0,0,8,0" Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Postcode" />
                                    <TextBox MaxLength="100" Text="{Binding Plaats, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Plaats" />
                                </DockPanel>
                                <Label Grid.Row="4" Content="E-_mail" Target="{Binding ElementName=RelatieEmail}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieEmail" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" MaxLength="254" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Grid.Row="5" Content="Telefoon" Target="{Binding ElementName=RelatieTelefoon}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieTelefoon" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" MaxLength="20" Text="{Binding Telefoon, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Grid.Row="6" Content="_IBAN" Target="{Binding ElementName=RelatieIban}" VerticalAlignment="Center" />
                                <TextBox x:Name="RelatieIban" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas" MaxLength="42"
                                         Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}" ToolTip="Wordt gebruikt om betalingen in de bank te herkennen"
                                         AutomationProperties.AutomationId="RelatieIban" />
                                <TextBlock Grid.Row="7" Text="Soort" VerticalAlignment="Center" Margin="5,0,0,8" />
                                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="Debiteur" IsChecked="{Binding IsDebiteur}" Margin="0,0,16,0" />
                                    <CheckBox Content="Crediteur" IsChecked="{Binding IsCrediteur}" Margin="0,0,16,0" />
                                    <CheckBox Content="Actief" IsChecked="{Binding IsActief}" />
                                </StackPanel>
                                <Label Grid.Row="8" Content="Notitie" Target="{Binding ElementName=RelatieNotitie}" VerticalAlignment="Top" />
                                <TextBox x:Name="RelatieNotitie" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"
                                         MaxLength="2000" Text="{Binding Notitie, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Fout}" Style="{StaticResource Foutmelding}" AutomationProperties.AutomationId="RelatieFout"
                                           Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== Rekeningschema ===== -->
                <TabItem Header="_Rekeningschema" AutomationProperties.AutomationId="SubtabRekeningschema">
                    <DockPanel Margin="0,12,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button Content="Nieuwe _rekening" Command="{Binding NieuweRekeningCommand}" Margin="0,0,24,0" AutomationProperties.AutomationId="NieuweRekening" />
                            <TextBox Width="200" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding NieuweRubriekNaam, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Naam van de nieuwe rubriek" />
                            <Button Content="R_ubriek toevoegen" Command="{Binding NieuweRubriekCommand}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0"
                                   Text="Opslaan met Ctrl+S. Het nummer van een bestaande rekening en de soort van een rekening waarop al is geboekt staan vast; een rekening die niet meer wordt gebruikt kunt u inactief maken." />
                        <DataGrid ItemsSource="{Binding Rekeningen}" SelectedItem="{Binding GeselecteerdeRekening}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                                  AutomationProperties.Name="Rekeningschema" AutomationProperties.AutomationId="Rekeningschema">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Nummer" Width="90" SortMemberPath="Nummer">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <TextBox Text="{Binding Nummertekst, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsNieuw, Converter={StaticResource Niet}}"
                                                     AutomationProperties.Name="Rekeningnummer" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Naam" Width="2*" SortMemberPath="Naam">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <TextBox Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Naam van de rekening" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Rubriek" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <ComboBox ItemsSource="{Binding DataContext.Rubrieken, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding GekozenRubriek, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Naam"
                                                      AutomationProperties.Name="Rubriek" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Soort" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <ComboBox ItemsSource="{Binding DataContext.Soorten, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Soort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Soort" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Rol" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <ComboBox ItemsSource="{Binding DataContext.Rollen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Rol, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rol"
                                                      ToolTip="Reserve: hierheen gaat het resultaat bij de jaarafsluiting. Kruisposten: tussenrekening voor overboekingen. Kas: rekening van het kasboek." />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actief" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RekeningRegel}">
                                            <CheckBox IsChecked="{Binding IsActief, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" AutomationProperties.Name="Actief" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldotekst}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Let op" Binding="{Binding Fout}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Grootboekkaart ===== -->
                <TabItem Header="_Grootboekkaart" AutomationProperties.AutomationId="SubtabGrootboekkaart">
                    <DockPanel Margin="0,12,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Label Content="Re_kening" Target="{Binding ElementName=Kaartrekening}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <ComboBox x:Name="Kaartrekening" ItemsSource="{Binding Rekeningkeuzes}" SelectedItem="{Binding KaartRekening}" Width="280"
                                      IsTextSearchEnabled="True" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.AutomationId="KaartRekening" />
                            <Label Content="_Van" Target="{Binding ElementName=KaartVan}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <DatePicker x:Name="KaartVan" SelectedDate="{Binding KaartVan}" Width="130" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Label Content="_Tot en met" Target="{Binding ElementName=KaartTot}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <DatePicker x:Name="KaartTot" SelectedDate="{Binding KaartTot}" Width="130" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Run Text="Beginsaldo " /><Run Text="{Binding KaartBeginsaldo, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="   ·   eindsaldo " /><Run Text="{Binding KaartEindsaldo, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="   (positief = debet)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding KaartMutaties}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  AutomationProperties.Name="Mutaties op de grootboekkaart" AutomationProperties.AutomationId="KaartMutaties">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="Auto" />
                                <DataGridTextColumn Header="Nummer" Binding="{Binding Nummer}" Width="Auto" />
                                <DataGridTextColumn Header="Omschrijving" Binding="{Binding Omschrijving}" Width="*" />
                                <DataGridTextColumn Header="Debet" Binding="{Binding Debet}" Width="Auto" />
                                <DataGridTextColumn Header="Credit" Binding="{Binding Credit}" Width="Auto" />
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Rapporten ===== -->
                <TabItem Header="Ra_pporten" AutomationProperties.AutomationId="SubtabRapporten">
                    <DockPanel Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Label Content="Rapport" Target="{Binding ElementName=Rapportkeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <ComboBox x:Name="Rapportkeuze" ItemsSource="{Binding Rapportkeuzes}" SelectedValuePath="Soort" DisplayMemberPath="Naam"
                                      SelectedValue="{Binding Rapportsoort}" Width="240" AutomationProperties.AutomationId="Rapportkeuze" />
                            <TextBlock Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Text="Alleen geboekte posten tellen mee." />
                        </StackPanel>
                        <FlowDocumentScrollViewer Document="{Binding Rapport, Converter={StaticResource RapportNaarDocument}}" VerticalScrollBarVisibility="Auto"
                                                  IsToolBarVisible="False" AutomationProperties.Name="Rapport" AutomationProperties.AutomationId="Rapport" />
                    </DockPanel>
                </TabItem>

                <!-- ===== Boekjaren ===== -->
                <TabItem Header="Boek_jaren" AutomationProperties.AutomationId="SubtabBoekjaren">
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Volgend boekjaar _openen" Command="{Binding OpenVolgendBoekjaarCommand}"
                                Margin="0,0,0,12" ToolTip="Om alvast in het volgende jaar te boeken, voordat het huidige jaar is afgesloten" />
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0"
                                   Text="Afsluiten kan als er geen concepten meer zijn en eerdere jaren zijn afgesloten. Het resultaat gaat naar de reserverekening; vooraf wordt een back-up gemaakt." />
                        <DataGrid ItemsSource="{Binding Jaren}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  AutomationProperties.Name="Boekjaren" AutomationProperties.AutomationId="Boekjaren">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Boekjaar" Binding="{Binding Jaartekst}" Width="Auto" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Statustekst}" Width="Auto" />
                                <DataGridTextColumn Header="Geboekt" Binding="{Binding AantalGeboekt}" Width="Auto" />
                                <DataGridTextColumn Header="Concepten" Binding="{Binding AantalConcepten}" Width="Auto" />
                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:JaarRegel}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Afsluiten..." Margin="0,0,8,0" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.SluitBoekjaarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding IsOpen, Converter={StaticResource BoolNaarZichtbaar}}"
                                                        AutomationProperties.Name="{Binding Jaartekst, StringFormat=Boekjaar {0} afsluiten}" />
                                                <Button Content="Heropenen..." CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.HeropenBoekjaarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding IsAfgesloten, Converter={StaticResource BoolNaarZichtbaar}}"
                                                        AutomationProperties.Name="{Binding Jaartekst, StringFormat=Boekjaar {0} heropenen}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</UserControl>
