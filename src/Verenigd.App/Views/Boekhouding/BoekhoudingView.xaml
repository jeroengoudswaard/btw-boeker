<UserControl x:Class="Verenigd.App.Views.Boekhouding.BoekhoudingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tg="clr-namespace:Verenigd.App.Views.Toegankelijkheid"
             xmlns:v="clr-namespace:Verenigd.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Verenigd.App.ViewModels.Boekhouding"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BoekhoudingViewModel}"
             AutomationProperties.AutomationId="BoekhoudingTabblad"
             PreviewKeyDown="Tabblad_PreviewKeyDown">
    <UserControl.Resources>
        <v:Bindingsproxy x:Key="Kaartproxy" Data="{Binding}" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding VernieuwCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NieuwePostCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ConceptenBoekenCommand}" />
    </UserControl.InputBindings>
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Zoeken_Executed" />
    </UserControl.CommandBindings>

    <DockPanel Margin="{StaticResource PaginaMarge}">
        <!-- ===== Opdrachtbalk onderaan ===== -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Opslaan" MinWidth="96" Command="{Binding OpslaanCommand}"
                    Style="{DynamicResource AccentButtonStyle}" ToolTip="Concept en rekeningen opslaan (Ctrl+S)" AutomationProperties.AutomationId="BoekhoudingOpslaan" />
            <TextBlock DockPanel.Dock="Right" Text="Niet-opgeslagen wijzigingen" Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Visibility="{Binding HeeftOnopgeslagenWijzigingen, Converter={StaticResource BoolNaarZichtbaar}}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}" Margin="0" AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.AutomationId="BoekhoudingFout"
                           Visibility="{Binding Foutmelding, Converter={StaticResource NietNullNaarZichtbaar}}" />
                <TextBlock Text="{Binding Melding}" Style="{StaticResource Toelichting}" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="BoekhoudingMelding"
                           Visibility="{Binding Melding, Converter={StaticResource NietNullNaarZichtbaar}}" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Nog niet ingericht ===== -->
        <tg:Groepskader DockPanel.Dock="Top" Style="{StaticResource Kaart}" MaxWidth="640" HorizontalAlignment="Left"
                Visibility="{Binding IsLeeg, Converter={StaticResource BoolNaarZichtbaar}}" AutomationProperties.Name="Boekhouding inrichten" AutomationProperties.AutomationId="BoekhoudingLeeg">
            <StackPanel>
                <TextBlock Text="Deze administratie heeft nog geen boekhouding" Style="{StaticResource Sectietitel}" />
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,12" TextWrapping="Wrap"
                           Text="Begin met het standaardschema voor scoutinggroepen, met een sjabloon van een andere groep, met een overname uit de huidige Excel-boekhouding of met een leeg rekeningschema. Bij een sjabloon voert u daarna de beginsaldi in." />
                <WrapPanel>
                    <Button Content="_Standaardschema gebruiken..." Command="{Binding StandaardInrichtenCommand}" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}"
                            Margin="0,0,8,8" ToolTip="Een compact rekeningschema met rubrieken, aan te passen vóór het inrichten"
                            AutomationProperties.AutomationId="StandaardInrichten" />
                    <Button Content="Sjabloon_bestand..." Command="{Binding SjabloonInlezenCommand}" Margin="0,0,8,8"
                            ToolTip="Een rekeningschema-sjabloon (.vsjabloon) van een andere groep" AutomationProperties.AutomationId="SjabloonInlezen" />
                    <Button Content="_Overnemen uit Excel..." Command="{Binding OvernemenUitExcelCommand}"
                            Margin="0,0,8,8" AutomationProperties.AutomationId="OvernemenUitExcel" />
                    <Button Content="_Leeg beginnen" Command="{Binding LeegBeginnenCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="LeegBeginnen" />
                </WrapPanel>
            </StackPanel>
        </tg:Groepskader>

        <DockPanel Visibility="{Binding IsIngericht, Converter={StaticResource BoolNaarZichtbaar}}">
            <!-- ===== Boekjaar en uitvoer ===== -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Label Content="_Boekjaar" Target="{Binding ElementName=Jaarkeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                <ComboBox x:Name="Jaarkeuze" ItemsSource="{Binding Boekjaren}" SelectedItem="{Binding Jaar}" Width="100" Margin="0,0,24,0"
                          VerticalAlignment="Center" AutomationProperties.AutomationId="Boekjaarkeuze" />
                <Button Command="{Binding AfdrukkenCommand}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Afdrukken, ook naar PDF (Ctrl+P)"
                        AutomationProperties.AutomationId="Afdrukken">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE749;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <AccessText Text="Af_drukken..." />
                    </StackPanel>
                </Button>
                <Button Content="Naar _Excel..." Command="{Binding ExporteerExcelCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                        ToolTip="Het rapport of de grootboekkaart opslaan als .xlsx" AutomationProperties.AutomationId="ExporteerExcel" />
                <Button Content="Naar _CSV..." Command="{Binding ExporteerCsvCommand}" VerticalAlignment="Center"
                        ToolTip="Het rapport of de grootboekkaart opslaan als .csv" AutomationProperties.AutomationId="ExporteerCsv" />
            </WrapPanel>

            <!-- ===== Historisch boekjaar (besluit 122) ===== -->
            <tg:Groepskader DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,8" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="{Binding IsHistorischJaar, Converter={StaticResource BoolNaarZichtbaar}}"
                            AutomationProperties.Name="Historisch boekjaar" AutomationProperties.AutomationId="HistorischBoekjaar">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE81C;" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                        <Run Text="{DynamicResource T.Band.Historisch}" FontWeight="SemiBold" />
                        <Run Text="{DynamicResource T.Band.HistorischUitleg}" />
                    </TextBlock>
                </StackPanel>
            </tg:Groepskader>

            <TabControl SelectedIndex="{Binding Subtab, Converter={StaticResource EnumNaarIndex}}" AutomationProperties.AutomationId="BoekhoudingSubtabbladen">
                <!-- ===== Journaal ===== -->
                <TabItem Header="{DynamicResource T.Tab.Journaal}" ToolTip="{DynamicResource U.Journaal}" AutomationProperties.AutomationId="SubtabJournaal">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="3*" MinWidth="420" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Content="{DynamicResource T.Knop.NieuwePost}" Command="{Binding NieuwePostCommand}" Margin="0,0,16,0" ToolTip="Ctrl+N"
                                        AutomationProperties.AutomationId="NieuwePost" />
                                <TextBox x:Name="Zoekveld" Width="200" VerticalAlignment="Center" Text="{Binding Zoektekst, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Zoeken op nummer of omschrijving (Ctrl+F)" AutomationProperties.Name="Zoeken op nummer of omschrijving" />
                                <CheckBox Content="{DynamicResource T.Knop.ZonderBon}" ContentTemplate="{StaticResource Toegangstekst}" IsChecked="{Binding AlleenZonderBon}"
                                          Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Uitgaven en ontvangsten van bank of kas boven € 10 zonder bijlage"
                                          AutomationProperties.Name="Alleen boekingen zonder bon" AutomationProperties.AutomationId="FilterZonderBon" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Aantaltekst}" Style="{StaticResource Toelichting}" Margin="0,8,0,0" />
                            <DataGrid ItemsSource="{Binding Posten}" SelectedItem="{Binding GeselecteerdePost}" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Journaalposten"
                                      AutomationProperties.AutomationId="Journaalposten">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="Auto" SortMemberPath="HeeftBijlage">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE723;" ToolTip="{DynamicResource T.Bijlagen}"
                                                       AutomationProperties.Name="{DynamicResource T.Bijlagen}" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:PostRegel}">
                                                <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE723;" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           ToolTip="{Binding AantalBijlagen}" AutomationProperties.Name="Heeft een bijlage"
                                                           Visibility="{Binding HeeftBijlage, Converter={StaticResource BoolNaarZichtbaar}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Nummer" Binding="{Binding Nummer}" Width="Auto" />
                                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="Auto" />
                                    <DataGridTextColumn Header="Omschrijving" Binding="{Binding Omschrijving}" Width="*" />
                                    <DataGridTextColumn Header="Bedrag" Binding="{Binding Bedrag}" Width="Auto" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <TextBlock Grid.Column="2" Text="{DynamicResource T.Tekst.SelecteerPost}" Style="{StaticResource Toelichting}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Editor, Converter={StaticResource NullNaarZichtbaar}}" />
                        <tg:Groepskader Grid.Column="2" Style="{StaticResource Kaart}" DataContext="{Binding Editor}" d:DataContext="{d:DesignInstance Type=vm:PostEditor}"
                                Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}" AutomationProperties.Name="Journaalpost" AutomationProperties.AutomationId="PostEditor">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sectietitel}">
                                    <Run Text="{Binding Nummer, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Statustekst, Mode=OneWay}" />
                                </TextBlock>
                                <Grid DockPanel.Dock="Top" IsEnabled="{Binding IsBewerkbaar}" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Content="{DynamicResource T.Label.Dagboek}" Target="{Binding ElementName=Dagboekkeuze}" Padding="0,0,0,4" />
                                    <ComboBox x:Name="Dagboekkeuze" Grid.Row="1" ItemsSource="{Binding Dagboeken}" SelectedItem="{Binding GekozenDagboek}" DisplayMemberPath="Naam"
                                              MinWidth="140" AutomationProperties.AutomationId="PostDagboek" />
                                    <Label Grid.Column="2" Content="_Datum" Target="{Binding ElementName=Postdatum}" Padding="0,0,0,4" />
                                    <DatePicker x:Name="Postdatum" Grid.Column="2" Grid.Row="1" SelectedDate="{Binding Datum}" Width="140"
                                                AutomationProperties.AutomationId="PostDatum" />
                                    <Label Grid.Column="4" Content="_Omschrijving" Target="{Binding ElementName=Postomschrijving}" Padding="0,0,0,4" />
                                    <TextBox x:Name="Postomschrijving" Grid.Column="4" Grid.Row="1" Text="{Binding Omschrijving, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="200" AutomationProperties.AutomationId="PostOmschrijving" />
                                </Grid>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <TextBlock>
                                        <Run Text="Debet " /><Run Text="{Binding TotaalDebettekst, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="   ·   credit " /><Run Text="{Binding TotaalCredittekst, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Boekmelding}" Style="{StaticResource Foutmelding}" Margin="0,4,0,0" AutomationProperties.AutomationId="PostBoekmelding"
                                               Visibility="{Binding IsBewerkbaar, Converter={StaticResource BoolNaarZichtbaar}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{DynamicResource T.Knop.Boeken}" MinWidth="96" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}"
                                                Command="{Binding DataContext.BoekenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Ctrl+Enter" AutomationProperties.AutomationId="PostBoeken"
                                                Visibility="{Binding IsBewerkbaar, Converter={StaticResource BoolNaarZichtbaar}}" />
                                        <Button Content="{DynamicResource T.Knop.ConceptVerwijderen}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.VerwijderConceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AutomationProperties.AutomationId="ConceptVerwijderen"
                                                Visibility="{Binding IsBewerkbaar, Converter={StaticResource BoolNaarZichtbaar}}" />
                                        <Button Content="{DynamicResource T.Knop.Tegenboeken}"
                                                Command="{Binding DataContext.TegenboekenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="{DynamicResource T.Tip.Tegenboeken}" AutomationProperties.AutomationId="Tegenboeken"
                                                Visibility="{Binding IsAlleenLezen, Converter={StaticResource BoolNaarZichtbaar}}" />
                                    </StackPanel>

                                    <!-- ===== Bijlagen (besluiten 83–86, 136 en 140) ===== -->
                                    <tg:Groepspaneel Margin="0,16,0,0" AllowDrop="True" Background="Transparent" DragOver="Bijlagen_DragOver" Drop="Postbijlagen_Drop"
                                                     DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     AutomationProperties.Name="{DynamicResource T.Bijlagen}" AutomationProperties.AutomationId="PostBijlagen">
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource T.Knop.BijlageToevoegen}" Command="{Binding BijlageToevoegenCommand}"
                                                    ToolTip="PDF, JPG of PNG, maximaal 10 MB" AutomationProperties.AutomationId="BijlageToevoegen" />
                                            <TextBlock Text="{DynamicResource T.Bijlagen}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{DynamicResource U.Bijlagen}" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Postbijlagen}" AutomationProperties.AutomationId="PostBijlagenlijst" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:BijlageRegel}">
                                                    <DockPanel Margin="0,2">
                                                        <Button DockPanel.Dock="Right" FontFamily="{StaticResource Pictogrammen}" Content="&#xE74D;" Padding="6,2" Margin="4,0,0,0"
                                                                ToolTip="Verwijderen" AutomationProperties.Name="{Binding Bestandsnaam, StringFormat=Verwijder {0}}"
                                                                Command="{Binding DataContext.BijlageVerwijderenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button DockPanel.Dock="Right" FontFamily="{StaticResource Pictogrammen}" Content="&#xE74E;" Padding="6,2" Margin="4,0,0,0"
                                                                ToolTip="Opslaan als..." AutomationProperties.Name="{Binding Bestandsnaam, StringFormat=Sla {0} op als}"
                                                                Command="{Binding DataContext.BijlageOpslaanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button DockPanel.Dock="Right" FontFamily="{StaticResource Pictogrammen}" Content="&#xE8A7;" Padding="6,2" Margin="4,0,0,0"
                                                                ToolTip="Bekijken" AutomationProperties.Name="{Binding Bestandsnaam, StringFormat=Bekijk {0}}"
                                                                Command="{Binding DataContext.BijlageBekijkenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="{Binding Pictogram}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding Toegankelijkenaam}">
                                                            <Run Text="{Binding Bestandsnaam, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Grootte, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource Toelichting}" Margin="0,4,0,0" Text="{Binding Bijlagenuitleg}" TextWrapping="Wrap" />
                                    </tg:Groepspaneel>
                                </StackPanel>

                                <Button DockPanel.Dock="Bottom" Content="_Regel toevoegen" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding NieuweRegelCommand}"
                                        AutomationProperties.AutomationId="RegelToevoegen"
                                        Visibility="{Binding IsBewerkbaar, Converter={StaticResource BoolNaarZichtbaar}}" />
                                <DataGrid ItemsSource="{Binding Regels}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserSortColumns="False" HeadersVisibility="Column" IsEnabled="{Binding IsBewerkbaar}"
                                          AutomationProperties.Name="Boekingsregels" AutomationProperties.AutomationId="PostRegels">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Rekening" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:PostRegelEditor}">
                                                    <ComboBox ItemsSource="{Binding DataContext.Rekeningen, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              SelectedItem="{Binding GekozenRekening, UpdateSourceTrigger=PropertyChanged}"
                                                              IsTextSearchEnabled="True" AutomationProperties.Name="Rekening" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Omschrijving" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:PostRegelEditor}">
                                                    <TextBox Text="{Binding Omschrijving, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Omschrijving van de regel" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Debet" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:PostRegelEditor}">
                                                    <TextBox Text="{Binding Debettekst, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Debet" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Credit" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:PostRegelEditor}">
                                                    <TextBox Text="{Binding Credittekst, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Credit" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:PostRegelEditor}">
                                                    <Button FontFamily="{StaticResource Pictogrammen}" Content="&#xE74D;" Padding="6,2" ToolTip="Regel verwijderen"
                                                            AutomationProperties.Name="Regel verwijderen"
                                                            Command="{Binding DataContext.VerwijderRegelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </tg:Groepskader>
                    </Grid>
                </TabItem>

                <!-- ===== Bank (besluiten 74–82) ===== -->
                <TabItem Header="{DynamicResource T.Tab.Bank}" ToolTip="{DynamicResource U.Bank}" AutomationProperties.AutomationId="SubtabBank">
                    <DockPanel Margin="0,12,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Label Content="Bank_rekening" Target="{Binding ElementName=Bankkeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <ComboBox x:Name="Bankkeuze" ItemsSource="{Binding Bankrekeningen}" SelectedItem="{Binding GekozenBankrekening}" DisplayMemberPath="Naam"
                                      Width="240" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Bankrekeningkeuze" />
                            <TextBlock Text="{Binding Banksaldotekst}" VerticalAlignment="Center" AutomationProperties.AutomationId="Banksaldo"
                                       AutomationProperties.LiveSetting="Polite" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button Content="Bankafschrift _inlezen..." Command="{Binding BankInlezenCommand}" Margin="0,0,16,0"
                                    Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}" AutomationProperties.AutomationId="BankInlezen" />
                            <Label Content="_Tonen" Target="{Binding ElementName=Bankfilterkeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <ComboBox x:Name="Bankfilterkeuze" ItemsSource="{Binding Bankfilters}" SelectedValuePath="Filter" DisplayMemberPath="Naam"
                                      SelectedValue="{Binding Bankfilter}" Width="150" Margin="0,0,16,0" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="Bankfilter" />
                            <TextBlock Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Run Text="{Binding AantalTeVerwerken, Mode=OneWay}" /><Run Text="{DynamicResource T.Tekst.TeVerwerken}" /><Run Text="{Binding AantalConcept, Mode=OneWay}" /><Run Text="{DynamicResource T.Tekst.ConceptAantal}" />
                            </TextBlock>
                            <Button Content="Regels _toepassen" Command="{Binding PasRegelsToeCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                                    ToolTip="De boekingsregels opnieuw toepassen op de werkvoorraad" />
                            <Button Content="{DynamicResource T.Knop.ConceptenBoeken}" Command="{Binding ConceptenBoekenCommand}" VerticalAlignment="Center"
                                    ToolTip="Ctrl+B" AutomationProperties.AutomationId="ConceptenBoeken" />
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2*" MinWidth="340" />
                            </Grid.ColumnDefinitions>
                            <DataGrid ItemsSource="{Binding Mutaties}" SelectedItem="{Binding GeselecteerdeMutatie}" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Banktransacties"
                                      AutomationProperties.AutomationId="Banktransacties">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="Auto" />
                                    <DataGridTextColumn Header="Tegenpartij" Binding="{Binding Tegenpartij}" Width="2*" />
                                    <DataGridTextColumn Header="Omschrijving" Binding="{Binding Omschrijving}" Width="2*" />
                                    <DataGridTextColumn Header="Bedrag" Binding="{Binding Bedragtekst}" Width="Auto" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Column="2" Text="Selecteer een transactie." Style="{StaticResource Toelichting}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding GeselecteerdeMutatie, Converter={StaticResource NullNaarZichtbaar}}" />
                            <tg:Groepskader Grid.Column="2" Style="{StaticResource Kaart}" AutomationProperties.Name="Banktransactie" AutomationProperties.AutomationId="Bankdetail"
                                    Visibility="{Binding GeselecteerdeMutatie, Converter={StaticResource NietNullNaarZichtbaar}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Sectietitel}">
                                            <Run Text="{Binding GeselecteerdeMutatie.Datum, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding GeselecteerdeMutatie.Bedragtekst, Mode=OneWay}" />
                                        </TextBlock>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Margin" Value="0,0,12,4" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                </Style>
                                            </Grid.Resources>
                                            <TextBlock Text="Tegenpartij" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding GeselecteerdeMutatie.Tegenpartij}" />
                                            <TextBlock Grid.Row="1" Text="Rekening" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GeselecteerdeMutatie.Tegenrekening}" FontFamily="Consolas" />
                                            <TextBlock Grid.Row="2" Text="Omschrijving" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GeselecteerdeMutatie.Omschrijving}" />
                                            <TextBlock Grid.Row="3" Text="Soort" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GeselecteerdeMutatie.Soort}" ToolTip="{Binding GeselecteerdeMutatie.Code}" />
                                            <TextBlock Grid.Row="4" Text="Status" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1">
                                                <Run Text="{Binding GeselecteerdeMutatie.Status, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding GeselecteerdeMutatie.Postnummer, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                        <StackPanel Visibility="{Binding GeselecteerdeMutatie.IsTeVerwerken, Converter={StaticResource BoolNaarZichtbaar}}">
                                            <Label Content="{DynamicResource T.Label.Rekening}" Target="{Binding ElementName=Toewijsrekening}" Padding="0,0,0,4" />
                                            <ComboBox x:Name="Toewijsrekening" ItemsSource="{Binding Toewijsrekeningen}" SelectedItem="{Binding ToewijsRekening}"
                                                      IsTextSearchEnabled="True" Margin="0,0,0,8" AutomationProperties.AutomationId="Toewijsrekening" />
                                            <Label Content="Om_schrijving (leeg = van de bank)" Target="{Binding ElementName=Toewijsomschrijving}" Padding="0,0,0,4" />
                                            <TextBox x:Name="Toewijsomschrijving" Text="{Binding ToewijsOmschrijving, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,12">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ToewijzenCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </StackPanel>
                                        <tg:Groepskader Margin="0,0,0,12" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                Visibility="{Binding KanAfletteren, Converter={StaticResource BoolNaarZichtbaar}}" AutomationProperties.Name="Afletteren" AutomationProperties.AutomationId="Afletteren">
                                            <StackPanel>
                                                <TextBlock Text="Afletteren met openstaande contributie" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding Afletterkeuzes}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:AfletterKeuze}">
                                                            <CheckBox IsChecked="{Binding IsGekozen}" Content="{Binding Tekst}" Margin="0,0,0,4" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <DockPanel Margin="0,4,0,0">
                                                    <Button DockPanel.Dock="Right" Content="A_fletteren" Command="{Binding AfletterenCommand}"
                                                            ToolTip="De gekozen posten moeten samen precies het ontvangen bedrag zijn" AutomationProperties.AutomationId="AfletterenKnop" />
                                                    <TextBlock VerticalAlignment="Center"><Run Text="Gekozen: " /><Run Text="{Binding Afletterentotaal, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                                </DockPanel>
                                            </StackPanel>
                                        </tg:Groepskader>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource T.Knop.Toewijzen}" MinWidth="96" Margin="0,0,8,0" Command="{Binding ToewijzenCommand}" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}"
                                                    ToolTip="{DynamicResource T.Tip.Toewijzen}" AutomationProperties.AutomationId="Toewijzen"
                                                    Visibility="{Binding GeselecteerdeMutatie.IsTeVerwerken, Converter={StaticResource BoolNaarZichtbaar}}" />
                                            <Button Content="Regel _maken van deze boeking..." Command="{Binding RegelMakenCommand}"
                                                    AutomationProperties.AutomationId="RegelMaken" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Toelichting}" Margin="0,12,0,0"
                                                   Text="{DynamicResource T.Tekst.ConceptBank}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </tg:Groepskader>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Postvak bonnen (besluiten 85, 96 en 135) ===== -->
                <TabItem Header="{DynamicResource T.Tab.Postvak}" ToolTip="{DynamicResource U.Tab.Postvak}" AutomationProperties.AutomationId="SubtabPostvak">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" MinWidth="360" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Content="_Bonnen toevoegen..." Command="{Binding BonnenToevoegenCommand}" Margin="0,0,16,0"
                                        ToolTip="PDF, JPG of PNG, maximaal 10 MB per bestand" AutomationProperties.AutomationId="BonnenToevoegen" />
                                <TextBlock Text="{Binding Postvaktekst}" Style="{StaticResource Toelichting}" VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Sleep bonnen op deze lijst. Van een PDF leest Verenigd datum en bedrag; bij een foto vult u die zelf in." />
                            <DataGrid ItemsSource="{Binding Postvak}" SelectedItem="{Binding GeselecteerdeBon}" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column" AllowDrop="True" DragOver="Bijlagen_DragOver" Drop="Postvak_Drop"
                                      AutomationProperties.Name="Postvak bonnen" AutomationProperties.AutomationId="Postvak">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Bestand" Binding="{Binding Bestandsnaam}" Width="2*" />
                                    <DataGridTextColumn Header="Soort" Binding="{Binding Soort}" Width="Auto" />
                                    <DataGridTextColumn Header="Datum" Binding="{Binding Datumtekst}" Width="Auto" />
                                    <DataGridTextColumn Header="Bedrag" Binding="{Binding Bedragtekst}" Width="Auto">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Style.Triggers>
                                                    <!-- Creditnota in groen; het minteken blijft (besluit 144). -->
                                                    <DataTrigger Binding="{Binding IsNegatief}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Voorstel" Binding="{Binding Voorsteltekst}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <TextBlock Grid.Column="2" Text="Kies een bon in de lijst." Style="{StaticResource Toelichting}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding GeselecteerdeBon, Converter={StaticResource NullNaarZichtbaar}}" />
                        <tg:Groepskader Grid.Column="2" Style="{StaticResource Kaart}" DataContext="{Binding GeselecteerdeBon}" d:DataContext="{d:DesignInstance Type=vm:BonRegel}"
                                        Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}"
                                        AutomationProperties.Name="Bon" AutomationProperties.AutomationId="BonDetail">
                            <StackPanel>
                                <TextBlock Text="{Binding Bestandsnaam}" Style="{StaticResource Sectietitel}" TextTrimming="CharacterEllipsis" />
                                <Label Content="_Datum op de bon" Target="{Binding ElementName=Bondatum}" Padding="0,0,0,4" />
                                <DatePicker x:Name="Bondatum" SelectedDate="{Binding Datum}" Width="160" HorizontalAlignment="Left" AutomationProperties.AutomationId="BonDatum" />
                                <Label Content="B_edrag" Target="{Binding ElementName=Bonbedrag}" Padding="0,12,0,4" />
                                <TextBox x:Name="Bonbedrag" Text="{Binding Bedragtekst, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"
                                         TextAlignment="Right" AutomationProperties.AutomationId="BonBedrag" ToolTip="Bij een creditnota met minteken, bijvoorbeeld -15,00">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNegatief}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}" AutomationProperties.LiveSetting="Assertive" />
                                <Label Content="_Hoort bij post" Target="{Binding ElementName=Bonpost}" Padding="0,12,0,4" />
                                <ComboBox x:Name="Bonpost" ItemsSource="{Binding Postkeuzes}" SelectedItem="{Binding GekozenPost}" DisplayMemberPath="Tekst"
                                          IsTextSearchEnabled="True" TextSearch.TextPath="Tekst" AutomationProperties.AutomationId="BonPost"
                                          ToolTip="Voorstellen (✓) hebben precies hetzelfde bedrag en een datum binnen 7 dagen" />
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Content="Koppele_n" MinWidth="96" Margin="0,0,8,8" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}"
                                            Command="{Binding DataContext.BonKoppelenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            AutomationProperties.AutomationId="BonKoppelen" />
                                    <Button Content="_Tonen..." Margin="0,0,8,8"
                                            Command="{Binding DataContext.BonBekijkenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            AutomationProperties.AutomationId="BonBekijken" />
                                    <Button Content="Datum en bedrag be_waren" Margin="0,0,8,8"
                                            Command="{Binding DataContext.BonGegevensOpslaanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            AutomationProperties.AutomationId="BonBewaren" />
                                    <Button Content="_Uit postvak verwijderen..." Margin="0,0,8,8"
                                            Command="{Binding DataContext.BonVerwijderenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            AutomationProperties.AutomationId="BonVerwijderen" />
                                </WrapPanel>
                            </StackPanel>
                        </tg:Groepskader>
                    </Grid>
                </TabItem>

                <!-- ===== Boekingsregels ===== -->
                <TabItem Header="{DynamicResource T.Tab.Boekingsregels}" ToolTip="{DynamicResource U.Boekingsregels}" AutomationProperties.AutomationId="SubtabBoekingsregels">
                    <DockPanel Margin="0,12,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button Content="_Nieuwe regel" Command="{Binding NieuweRegelCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="NieuweBoekingsregel" />
                            <Button Content="_Verwijderen..." Command="{Binding VerwijderRegelCommand}" Margin="0,0,24,0" />
                            <Button FontFamily="{StaticResource Pictogrammen}" Content="&#xE70E;" Padding="8,4" Margin="0,0,4,0" Command="{Binding RegelOmhoogCommand}"
                                    ToolTip="Omhoog (Alt+↑)" AutomationProperties.Name="Regel omhoog" />
                            <Button FontFamily="{StaticResource Pictogrammen}" Content="&#xE70D;" Padding="8,4" Margin="0,0,24,0" Command="{Binding RegelOmlaagCommand}"
                                    ToolTip="Omlaag (Alt+↓)" AutomationProperties.Name="Regel omlaag" />
                            <Button Content="Regels _toepassen op werkvoorraad" Command="{Binding PasRegelsToeCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0"
                                   Text="De eerste passende regel in deze volgorde wint. Lege voorwaarden doen niet mee. Overboekingen tussen eigen rekeningen gaan altijd via Kruisposten. Opslaan met Ctrl+S." />
                        <DataGrid ItemsSource="{Binding Boekingsregels}" SelectedItem="{Binding GeselecteerdeRegel}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                                  AutomationProperties.Name="Boekingsregels" AutomationProperties.AutomationId="Boekingsregels">
                            <DataGrid.InputBindings>
                                <KeyBinding Gesture="Alt+Up" Command="{Binding RegelOmhoogCommand}" />
                                <KeyBinding Gesture="Alt+Down" Command="{Binding RegelOmlaagCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Naam" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoekingsregelRegel}">
                                            <TextBox Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Naam van de regel" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tegen-IBAN" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoekingsregelRegel}">
                                            <TextBox Text="{Binding TegenIban, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Tegen-IBAN" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Naam bevat" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoekingsregelRegel}">
                                            <TextBox Text="{Binding NaamBevat, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Naam bevat" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Omschrijving bevat" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoekingsregelRegel}">
                                            <TextBox Text="{Binding OmschrijvingBevat, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Omschrijving bevat" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Bij/af" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoekingsregelRegel}">
                                            <ComboBox ItemsSource="{Binding DataContext.Richtingen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Richting, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bij of af" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Bedrag van" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoekingsregelRegel}">
                                            <TextBox Text="{Binding BedragVanTekst, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Bedrag van" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="tot" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoekingsregelRegel}">
                                            <TextBox Text="{Binding BedragTotTekst, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Bedrag tot" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Transactiecode" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoekingsregelRegel}">
                                            <ComboBox IsEditable="True" Text="{Binding Transactiecode, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DataContext.Transactiecodekeuzes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      TextSearch.TextPath="Code" AutomationProperties.Name="Transactiecode">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:TransactiecodeKeuze}">
                                                        <TextBlock Text="{Binding}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Rekening" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoekingsregelRegel}">
                                            <ComboBox ItemsSource="{Binding DataContext.Toewijsrekeningen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding GekozenRekening, UpdateSourceTrigger=PropertyChanged}" IsTextSearchEnabled="True"
                                                      AutomationProperties.Name="Rekening" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Omschrijving post" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoekingsregelRegel}">
                                            <TextBox Text="{Binding Omschrijving, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Omschrijving van de post" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actief" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoekingsregelRegel}">
                                            <CheckBox IsChecked="{Binding IsActief, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" AutomationProperties.Name="Actief" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Let op" Binding="{Binding Fout}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Facturen (stap 4c-2, besluiten 66 en 105–112) ===== -->
                <TabItem Header="_Facturen" AutomationProperties.AutomationId="SubtabFacturen">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="3*" MinWidth="460" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Content="Nieu_we factuur" Command="{Binding NieuweFactuurCommand}" Margin="0,0,16,0"
                                        ToolTip="Een nieuwe verkoopfactuur (Ctrl+N blijft Nieuwe post)" AutomationProperties.AutomationId="NieuweFactuur" />
                                <Label Content="T_onen" Target="{Binding ElementName=Factuurfilterkeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                                <ComboBox x:Name="Factuurfilterkeuze" ItemsSource="{Binding Factuurfilters}" SelectedItem="{Binding Factuurfilter}" Width="120"
                                          VerticalAlignment="Center" AutomationProperties.AutomationId="Factuurfilter" />
                            </WrapPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Factuuraantaltekst}" Style="{StaticResource Toelichting}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Command="{Binding FactuurPdfCommand}" Margin="0,0,8,0" ToolTip="De factuur opslaan als PDF met betaal-QR-code"
                                        AutomationProperties.AutomationId="FactuurPdf">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xEA90;" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <AccessText Text="Als PDF opslaa_n..." />
                                    </StackPanel>
                                </Button>
                                <Button Content="Cred_itfactuur..." Command="{Binding CreditfactuurCommand}" Margin="0,0,8,0"
                                        ToolTip="Een definitieve factuur corrigeren of intrekken" AutomationProperties.AutomationId="Creditfactuur" />
                                <Button Content="Concept _verwijderen" Command="{Binding VerwijderFactuurconceptCommand}" AutomationProperties.AutomationId="FactuurconceptVerwijderen" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Facturen}" SelectedItem="{Binding GeselecteerdeFactuur}" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Verkoopfacturen"
                                      AutomationProperties.AutomationId="Verkoopfacturen">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVervallen}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="ToolTip" Value="Vervallen: de betaaltermijn is verstreken" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nummer" Binding="{Binding Nummer}" Width="Auto" />
                                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="Auto" />
                                    <DataGridTextColumn Header="Relatie" Binding="{Binding Relatie}" Width="*" />
                                    <DataGridTextColumn Header="Totaal" Binding="{Binding Totaal}" Width="Auto" />
                                    <DataGridTextColumn Header="Open" Binding="{Binding Open}" Width="Auto" />
                                    <DataGridTextColumn Header="Vervalt" Binding="{Binding Vervaldatum}" Width="Auto" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <TextBlock Grid.Column="2" Style="{StaticResource Toelichting}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Selecteer een conceptfactuur of kies Nieuwe factuur. Een definitieve factuur is onveranderlijk; corrigeren gaat met een creditfactuur."
                                   Visibility="{Binding FactuurEditor, Converter={StaticResource NullNaarZichtbaar}}" />
                        <tg:Groepskader Grid.Column="2" Style="{StaticResource Kaart}" DataContext="{Binding FactuurEditor}" d:DataContext="{d:DesignInstance Type=vm:FactuurEditor}"
                                Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}" AutomationProperties.Name="Factuur" AutomationProperties.AutomationId="FactuurEditor">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Titel}" Style="{StaticResource Sectietitel}" />
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Content="Rela_tie" Target="{Binding ElementName=Factuurrelatie}" Padding="0,0,0,4" />
                                    <ComboBox x:Name="Factuurrelatie" Grid.Row="1" ItemsSource="{Binding Relatiekeuzes}" SelectedItem="{Binding Relatie}" DisplayMemberPath="Naam"
                                              IsTextSearchEnabled="True" IsEnabled="{Binding IsCreditfactuur, Converter={StaticResource Niet}}"
                                              AutomationProperties.AutomationId="FactuurRelatie" />
                                    <Label Grid.Column="2" Content="Factuurdat_um" Target="{Binding ElementName=Factuurdatum}" Padding="0,0,0,4" />
                                    <DatePicker x:Name="Factuurdatum" Grid.Column="2" Grid.Row="1" SelectedDate="{Binding Datum}" Width="140"
                                                AutomationProperties.AutomationId="FactuurDatum" />
                                    <Label Grid.Column="4" Content="Ter_mijn (dagen)" Target="{Binding ElementName=Factuurtermijn}" Padding="0,0,0,4" />
                                    <TextBox x:Name="Factuurtermijn" Grid.Column="4" Grid.Row="1" Width="80" Text="{Binding Termijn, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FactuurTermijn" />
                                </Grid>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <TextBlock>
                                        <Run Text="Totaal " /><Run Text="{Binding Totaaltekst, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  geen btw" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Fouttekst}" Style="{StaticResource Foutmelding}" Margin="0,4,0,0" AutomationProperties.AutomationId="FactuurFouten"
                                               Visibility="{Binding Fouttekst, Converter={StaticResource NietNullNaarZichtbaar}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Definitief ma_ken..." MinWidth="96" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}"
                                                Command="{Binding DataContext.MaakFactuurDefinitiefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Nummer toekennen en boeken in het verkoopdagboek. Daarna kan de factuur niet meer worden gewijzigd."
                                                AutomationProperties.AutomationId="FactuurDefinitief" />
                                    </StackPanel>
                                </StackPanel>

                                <Button DockPanel.Dock="Bottom" Content="E_xtra regel" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding RegelToevoegenCommand}"
                                        AutomationProperties.AutomationId="FactuurregelToevoegen" />
                                <DataGrid ItemsSource="{Binding Regels}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserSortColumns="False" HeadersVisibility="Column"
                                          AutomationProperties.Name="Factuurregels" AutomationProperties.AutomationId="Factuurregels">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Omschrijving" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
