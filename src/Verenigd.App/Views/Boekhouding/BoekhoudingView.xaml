                            <ComboBox ItemsSource="{Binding Begrotingsbronnen}" SelectedItem="{Binding OvernemenBron}" Width="130" Margin="0,0,8,0" VerticalAlignment="Center"
                                      AutomationProperties.Name="Overnemen van" AutomationProperties.AutomationId="OvernemenBron" />
                            <TextBox Text="{Binding OvernemenJaar, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,8,0" VerticalAlignment="Center"
                                     AutomationProperties.Name="Jaar om over te nemen" AutomationProperties.AutomationId="OvernemenJaar" />
                            <TextBlock Text="plus" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding OvernemenPercentage, UpdateSourceTrigger=PropertyChanged}" Width="60" TextAlignment="Right" VerticalAlignment="Center"
                                     AutomationProperties.Name="Percentage" AutomationProperties.AutomationId="OvernemenPercentage" />
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,8,0" />
                            <Button Content="{DynamicResource T.Knop.Overnemen}" Command="{Binding BegrotingOvernemenCommand}" Margin="0,0,24,0" VerticalAlignment="Center"
                                    ToolTip="Vervangt alle bedragen; afgerond op tientallen euro's. Daarna kunt u elk bedrag zelf aanpassen." AutomationProperties.AutomationId="BegrotingOvernemen" />
                            <Label Content="Vastgesteld _op" Target="{Binding ElementName=Vaststellingsdatum}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <DatePicker x:Name="Vaststellingsdatum" SelectedDate="{Binding VaststellenOp}" Width="130" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding VaststellenOmschrijving, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0" VerticalAlignment="Center"
                                     ToolTip="Bijvoorbeeld: Vastgesteld ALV 12-12-2026" AutomationProperties.Name="Omschrijving bij vaststellen" />
                            <Button Content="{DynamicResource T.Knop.Vaststellen}" Command="{Binding BegrotingVaststellenCommand}" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="BegrotingVaststellen" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="{DynamicResource T.Knop.Herzien}" Command="{Binding BegrotingHerzienCommand}" VerticalAlignment="Center"
                                    ToolTip="Een nieuwe conceptversie van de vastgestelde begroting; de vastgestelde versie blijft bewaard" AutomationProperties.AutomationId="BegrotingHerzien" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Begrotingstotalen}" FontWeight="SemiBold" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0"
                                   Text="Bedragen per jaar. In het lopende jaar wordt vergeleken met het bedrag naar rato. Ctrl+S slaat op; Ctrl+P drukt de begroting voor de ALV af." />
                        <TextBlock Style="{StaticResource Toelichting}" Text="Er is nog geen begroting voor dit jaar."
                                   Visibility="{Binding HeeftBegroting, Converter={StaticResource OnwaarNaarZichtbaar}}" DockPanel.Dock="Top" />
                        <DataGrid ItemsSource="{Binding Begrotingsrijen}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" IsReadOnly="{Binding IsBegrotingBewerkbaar, Converter={StaticResource Niet}}"
                                  AutomationProperties.Name="Begroting per rekening" AutomationProperties.AutomationId="Begrotingsrijen"
                                  Visibility="{Binding HeeftBegroting, Converter={StaticResource BoolNaarZichtbaar}}">
