<UserControl x:Class="BtwBoeker.App.Views.InstellingenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BtwBoeker.App.ViewModels"
             xmlns:inst="clr-namespace:BtwBoeker.Application.Instellingen;assembly=BtwBoeker.Application"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstellingenViewModel}"
             AutomationProperties.AutomationId="Instellingen">
    <!-- Besluit 42: alles wordt direct bewaard, zoals in Windows-Instellingen; er is geen knop Opslaan. Thema en weergave zijn
         die van de shell (GekozenThema, GekozenWeergave), zodat ze gelijk lopen met het menu Beeld. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PaginaMarge}" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Administratie" Style="{StaticResource Sectietitel}" Margin="0,0,0,8" />
            <Border Style="{StaticResource Kaart}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="_Naam" Target="{Binding ElementName=Naamveld}" VerticalAlignment="Center" />
                    <TextBox x:Name="Naamveld" Grid.Column="1" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}" LostFocus="Naamveld_LostFocus"
                             AutomationProperties.AutomationId="AdministratieNaam">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding BevestigNaamCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Fout}" Style="{StaticResource Foutmelding}" Margin="0,4,0,0"
                               Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Toelichting}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Staat in de titelbalk en op afdrukken." />
                </Grid>
            </Border>

            <TextBlock Text="Uiterlijk" Style="{StaticResource Sectietitel}" Margin="0,0,0,8" />
            <Border Style="{StaticResource Kaart}">
                <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Thema" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton GroupName="Thema" Content="_Systeem" ContentTemplate="{StaticResource Toegangstekst}" Margin="0,0,16,0" ToolTip="Volgt de instelling van Windows"
                                     IsChecked="{Binding GekozenThema, Converter={StaticResource Keuze}, ConverterParameter={x:Static inst:Thema.Systeem}}"
                                     AutomationProperties.AutomationId="ThemaSysteem" />
                        <RadioButton GroupName="Thema" Content="L_icht" ContentTemplate="{StaticResource Toegangstekst}" Margin="0,0,16,0"
                                     IsChecked="{Binding GekozenThema, Converter={StaticResource Keuze}, ConverterParameter={x:Static inst:Thema.Licht}}"
                                     AutomationProperties.AutomationId="ThemaLicht" />
                        <RadioButton GroupName="Thema" Content="_Donker" ContentTemplate="{StaticResource Toegangstekst}"
                                     IsChecked="{Binding GekozenThema, Converter={StaticResource Keuze}, ConverterParameter={x:Static inst:Thema.Donker}}"
                                     AutomationProperties.AutomationId="ThemaDonker" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Woorden" VerticalAlignment="Center" Margin="4,16,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                        <RadioButton GroupName="Weergave" Content="_Expert" ContentTemplate="{StaticResource Toegangstekst}" Margin="0,0,16,0"
                                     IsChecked="{Binding GekozenWeergave, Converter={StaticResource Keuze}, ConverterParameter={x:Static inst:Weergavemodus.Expert}}"
                                     AutomationProperties.AutomationId="WeergaveExpert" />
                        <RadioButton GroupName="Weergave" Content="Een_voudig" ContentTemplate="{StaticResource Toegangstekst}"
                                     IsChecked="{Binding GekozenWeergave, Converter={StaticResource Keuze}, ConverterParameter={x:Static inst:Weergavemodus.Eenvoudig}}"
                                     AutomationProperties.AutomationId="WeergaveEenvoudig" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Toelichting}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Eenvoudig gebruikt woorden als uitgave en inkomst in plaats van debet en credit. Ook te kiezen in het menu Beeld." />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
