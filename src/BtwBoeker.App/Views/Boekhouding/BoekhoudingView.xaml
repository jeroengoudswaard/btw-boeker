<UserControl x:Class="BtwBoeker.App.Views.Boekhouding.BoekhoudingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:BtwBoeker.App.Views.Gedeeld"
        xmlns:tg="clr-namespace:BtwBoeker.App.Views.Toegankelijkheid"
             xmlns:v="clr-namespace:BtwBoeker.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BtwBoeker.App.ViewModels.Boekhouding"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BoekhoudingViewModel}"
             AutomationProperties.AutomationId="BoekhoudingTabblad"
             PreviewKeyDown="Tabblad_PreviewKeyDown">
    <UserControl.Resources>
        <v:Bindingsproxy x:Key="Kaartproxy" Data="{Binding}" />

        <!-- Besluit 38: het jaar rechts in de werkbalk, alleen bij meer dan één jaar en alleen waar het jaar iets doet. -->
        <DataTemplate x:Key="Jaarkeuze" DataType="{x:Type vm:BoekhoudingViewModel}">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Visibility="{Binding IsJaarkeuzeZichtbaar, Converter={StaticResource BoolNaarZichtbaar}}">
                <Label Content="_Jaar" Target="{Binding ElementName=Jaarkeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                <ComboBox x:Name="Jaarkeuze" ItemsSource="{Binding Boekjaren}" SelectedItem="{Binding Jaar}" Width="100" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="Boekjaarkeuze" />
            </StackPanel>
        </DataTemplate>

        <!-- Afdrukken en exporteren alleen waar er iets af te drukken is (rapporten en grootboekkaart). -->
        <DataTemplate x:Key="Uitvoer" DataType="{x:Type vm:BoekhoudingViewModel}">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                <Button Command="{Binding AfdrukkenCommand}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Afdrukken, ook naar PDF (Ctrl+P)"
                        AutomationProperties.AutomationId="Afdrukken">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE749;" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <AccessText Text="Af_drukken…" />
                    </StackPanel>
                </Button>
                <Button VerticalAlignment="Center" Click="Knopmenu_Click" ToolTip="Opslaan als Excel (.xlsx) of CSV"
                        AutomationProperties.AutomationId="Exporteren">
                    <StackPanel Orientation="Horizontal">
                        <AccessText Text="_Exporteren" />
                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE70D;" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Naar _Excel (.xlsx)…" Command="{Binding ExporteerExcelCommand}" AutomationProperties.AutomationId="ExporteerExcel" />
                            <MenuItem Header="Naar _CSV…" Command="{Binding ExporteerCsvCommand}" AutomationProperties.AutomationId="ExporteerCsv" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding VernieuwCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NieuwePostCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ConceptenBoekenCommand}" />
        <KeyBinding Key="Escape" Command="{Binding SluitDetailCommand}" />
    </UserControl.InputBindings>
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Zoeken_Executed" />
    </UserControl.CommandBindings>

    <DockPanel Margin="{StaticResource PaginaMarge}">
        <!-- ===== Opdrachtbalk onderaan ===== -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <!-- UX-review stap 1 en 3: alleen als er iets op te slaan is en er geen detail open is (dan staat Opslaan in het detail);
                 Ctrl+S werkt altijd. -->
            <Button DockPanel.Dock="Right" Content="Opslaan" MinWidth="96" Command="{Binding OpslaanCommand}"
                    Visibility="{Binding HeeftOnopgeslagenWijzigingenZonderDetail, Converter={StaticResource BoolNaarZichtbaar}}"
                    Style="{Binding HeeftOnopgeslagenWijzigingen, Converter={StaticResource HoofdactieStijl}}" ToolTip="Opslaan (Ctrl+S)" AutomationProperties.AutomationId="BoekhoudingOpslaan" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}" Margin="0" AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.AutomationId="BoekhoudingFout"
                           Visibility="{Binding Foutmelding, Converter={StaticResource NietNullNaarZichtbaar}}" />
                <TextBlock Text="{Binding Melding}" Style="{StaticResource Toelichting}" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="BoekhoudingMelding"
                           Visibility="{Binding Melding, Converter={StaticResource NietNullNaarZichtbaar}}" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Nog niet ingericht ===== -->
        <tg:Groepskader DockPanel.Dock="Top" Style="{StaticResource Kaart}" MaxWidth="640" HorizontalAlignment="Left"
                Visibility="{Binding IsLeeg, Converter={StaticResource BoolNaarZichtbaar}}" AutomationProperties.Name="Boekhouding inrichten" AutomationProperties.AutomationId="BoekhoudingLeeg">
            <StackPanel>
                <TextBlock Text="Deze administratie heeft nog geen boekhouding" Style="{StaticResource Sectietitel}" />
                <TextBlock Style="{StaticResource Toelichting}" Margin="0,0,0,12" TextWrapping="Wrap"
                           Text="Begin met een rekeningschema-sjabloon of met een leeg rekeningschema. Bij een sjabloon voert u daarna de beginsaldi in." />
                <WrapPanel>
                    <Button Content="Sjabloon_bestand..." Command="{Binding SjabloonInlezenCommand}" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}"
                            Margin="0,0,8,8" ToolTip="Een rekeningschema-sjabloon (.btwsjabloon), bijvoorbeeld geëxporteerd uit een andere administratie"
                            AutomationProperties.AutomationId="SjabloonInlezen" />
                    <Button Content="_Leeg beginnen" Command="{Binding LeegBeginnenCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="LeegBeginnen" />
                </WrapPanel>
            </StackPanel>
        </tg:Groepskader>

        <DockPanel Visibility="{Binding IsIngericht, Converter={StaticResource BoolNaarZichtbaar}}">
            <!-- De navigatiebalk kiest het onderdeel; geen tabkoppen en geen lege lijn waar die stonden. -->
            <TabControl Style="{StaticResource Onderdeelpaneel}" SelectedIndex="{Binding Subtab, Converter={StaticResource EnumNaarIndex}}" AutomationProperties.AutomationId="BoekhoudingSubtabbladen">
                <!-- ===== Journaal ===== -->
                <TabItem Header="{DynamicResource T.Tab.Journaal}" ToolTip="{DynamicResource U.Journaal}" AutomationProperties.AutomationId="SubtabJournaal">
                    <DockPanel Margin="0,12,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Jaarkeuze}" Focusable="False" IsTabStop="False" />
                            <WrapPanel>
                                <Button Content="{DynamicResource T.Knop.NieuwePost}" Command="{Binding NieuwePostCommand}" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}" Margin="0,0,8,0" ToolTip="Ctrl+N"
                                        AutomationProperties.AutomationId="NieuwePost" />
                                <Grid VerticalAlignment="Center">
                                    <TextBox x:Name="Zoekveld" Width="240" Text="{Binding Zoektekst, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Zoeken op nummer of omschrijving (Ctrl+F)" AutomationProperties.Name="Zoeken op nummer of omschrijving" />
                                    <TextBlock Text="Zoeken" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding Text.Length, ElementName=Zoekveld, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=0}" />
                                </Grid>
                                <!-- Het filter verschijnt als teller, alleen als er posten zonder bon zijn. -->
                                <ToggleButton Content="{Binding ZonderBonTekst}" IsChecked="{Binding AlleenZonderBon}" Margin="8,0,0,0" VerticalAlignment="Center"
                                              ToolTip="{DynamicResource T.Knop.ZonderBon}" Visibility="{Binding IsZonderBonZichtbaar, Converter={StaticResource BoolNaarZichtbaar}}"
                                              AutomationProperties.Name="Alleen boekingen zonder bon" AutomationProperties.AutomationId="FilterZonderBon" />
                            </WrapPanel>
                        </DockPanel>

                        <!-- Het detail schuift rechts in bij een gekozen post of Nieuwe post (besluit 38). -->
                        <g:Detailpaneel DockPanel.Dock="Right" DataContext="{Binding Editor}" d:DataContext="{d:DesignInstance Type=vm:PostEditor}"
                                        SluitOpdracht="{Binding DataContext.SluitDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}" AutomationProperties.Name="Journaalpost" AutomationProperties.AutomationId="PostEditor">
                            <g:Detailpaneel.Header>
                                <TextBlock>
                                    <Run Text="{Binding Nummer, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Statustekst, Mode=OneWay}" />
                                </TextBlock>
                            </g:Detailpaneel.Header>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" IsEnabled="{Binding IsBewerkbaar}" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Content="{DynamicResource T.Label.Dagboek}" Target="{Binding ElementName=Dagboekkeuze}" Padding="0,0,0,4" />
                                    <ComboBox x:Name="Dagboekkeuze" Grid.Row="1" ItemsSource="{Binding Dagboeken}" SelectedItem="{Binding GekozenDagboek}" DisplayMemberPath="Naam"
                                              MinWidth="140" AutomationProperties.AutomationId="PostDagboek" />
                                    <Label Grid.Column="2" Content="_Datum" Target="{Binding ElementName=Postdatum}" Padding="0,0,0,4" />
                                    <DatePicker x:Name="Postdatum" Grid.Column="2" Grid.Row="1" SelectedDate="{Binding Datum}" HorizontalAlignment="Left" Width="140"
                                                AutomationProperties.AutomationId="PostDatum" />
                                    <Label Grid.Row="2" Grid.ColumnSpan="3" Content="_Omschrijving" Target="{Binding ElementName=Postomschrijving}" Padding="0,12,0,4" />
                                    <TextBox x:Name="Postomschrijving" Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Omschrijving, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="200" AutomationProperties.AutomationId="PostOmschrijving" />
                                </Grid>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <TextBlock>
                                        <Run Text="Debet " /><Run Text="{Binding TotaalDebettekst, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="   ·   credit " /><Run Text="{Binding TotaalCredittekst, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Boekmelding}" Style="{StaticResource Foutmelding}" Margin="0,4,0,0" AutomationProperties.AutomationId="PostBoekmelding"
                                               Visibility="{Binding IsBewerkbaar, Converter={StaticResource BoolNaarZichtbaar}}" />

                                    <!-- ===== Bijlagen: één knop, plus slepen ===== -->
                                    <tg:Groepspaneel Margin="0,16,0,0" AllowDrop="True" Background="Transparent" DragOver="Bijlagen_DragOver" Drop="Postbijlagen_Drop"
                                                     DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     AutomationProperties.Name="{DynamicResource T.Bijlagen}" AutomationProperties.AutomationId="PostBijlagen">
                                        <ItemsControl ItemsSource="{Binding Postbijlagen}" AutomationProperties.AutomationId="PostBijlagenlijst" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:BijlageRegel}">
                                                    <DockPanel Margin="0,4">
                                                        <Button DockPanel.Dock="Right" FontFamily="{StaticResource Pictogrammen}" Content="&#xE74D;" Padding="8,4" Margin="4,0,0,0"
                                                                ToolTip="Verwijderen" AutomationProperties.Name="{Binding Bestandsnaam, StringFormat=Verwijder {0}}"
                                                                Command="{Binding DataContext.BijlageVerwijderenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button DockPanel.Dock="Right" FontFamily="{StaticResource Pictogrammen}" Content="&#xE74E;" Padding="8,4" Margin="4,0,0,0"
                                                                ToolTip="Opslaan als…" AutomationProperties.Name="{Binding Bestandsnaam, StringFormat=Sla {0} op als}"
                                                                Command="{Binding DataContext.BijlageOpslaanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button DockPanel.Dock="Right" FontFamily="{StaticResource Pictogrammen}" Content="&#xE8A7;" Padding="8,4" Margin="4,0,0,0"
                                                                ToolTip="Bekijken" AutomationProperties.Name="{Binding Bestandsnaam, StringFormat=Bekijk {0}}"
                                                                Command="{Binding DataContext.BijlageBekijkenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="{Binding Pictogram}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding Toegankelijkenaam}">
                                                            <Run Text="{Binding Bestandsnaam, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Grootte, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{DynamicResource T.Knop.BijlageToevoegen}" Command="{Binding BijlageToevoegenCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                Style="{StaticResource Linkknop}" ToolTip="PDF, JPG of PNG, maximaal 10 MB; of sleep bestanden hierheen" AutomationProperties.AutomationId="BijlageToevoegen" />
                                        <TextBlock Style="{StaticResource Toelichting}" Margin="0,4,0,0" Text="{Binding Bijlagenuitleg}" TextWrapping="Wrap" />
                                    </tg:Groepspaneel>

                                    <!-- Acties volgens de status: concept → Verwijderen en Boeken; geboekt → Tegenboeken. -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                        <Button Content="{DynamicResource T.Knop.ConceptVerwijderen}"
                                                Command="{Binding DataContext.VerwijderConceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AutomationProperties.AutomationId="ConceptVerwijderen"
                                                Visibility="{Binding IsBewerkbaar, Converter={StaticResource BoolNaarZichtbaar}}" />
                                        <Button Content="{DynamicResource T.Knop.Tegenboeken}"
                                                Command="{Binding DataContext.TegenboekenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="{DynamicResource T.Tip.Tegenboeken}" AutomationProperties.AutomationId="Tegenboeken"
                                                Visibility="{Binding IsAlleenLezen, Converter={StaticResource BoolNaarZichtbaar}}" />
                                        <Button Content="Opslaan" MinWidth="96" Margin="8,0,0,0" Command="{Binding DataContext.OpslaanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding DataContext.HeeftOnopgeslagenWijzigingenMetDetail, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolNaarZichtbaar}}"
                                                ToolTip="Opslaan (Ctrl+S)" AutomationProperties.AutomationId="DetailOpslaan" />
                                        <Button Content="{DynamicResource T.Knop.Boeken}" MinWidth="96" Margin="8,0,0,0" ContentTemplate="{StaticResource Toegangstekst}"
                                                Command="{Binding DataContext.BoekenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Ctrl+Enter" AutomationProperties.AutomationId="PostBoeken"
                                                Visibility="{Binding IsBewerkbaar, Converter={StaticResource BoolNaarZichtbaar}}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button DockPanel.Dock="Bottom" Content="_Regel toevoegen" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding NieuweRegelCommand}"
                                        Style="{StaticResource Linkknop}" AutomationProperties.AutomationId="RegelToevoegen"
                                        Visibility="{Binding IsBewerkbaar, Converter={StaticResource BoolNaarZichtbaar}}" />

                                <!-- Een geboekte post is alleen tekst: rekening en bedrag, zonder invulvelden en prullenbakjes. -->
                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Regels}" Focusable="False" AutomationProperties.Name="Boekingsregels"
                                              AutomationProperties.AutomationId="PostRegelsAlleenLezen"
                                              Visibility="{Binding IsAlleenLezen, Converter={StaticResource BoolNaarZichtbaar}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PostRegelEditor}">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="96" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding GekozenRekening}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Omschrijving}" Style="{StaticResource Toelichting}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Omschrijving, Converter={StaticResource NietNullNaarZichtbaar}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Debettekst}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Credittekst}" TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DataGrid ItemsSource="{Binding Regels}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserSortColumns="False" HeadersVisibility="Column"
                                          Visibility="{Binding IsBewerkbaar, Converter={StaticResource BoolNaarZichtbaar}}"
                                          AutomationProperties.Name="Boekingsregels" AutomationProperties.AutomationId="PostRegels">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Rekening" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:PostRegelEditor}">
                                                    <ComboBox ItemsSource="{Binding Rekeningen}"
                                                              SelectedItem="{Binding GekozenRekening, UpdateSourceTrigger=PropertyChanged}"
                                                              IsTextSearchEnabled="True" AutomationProperties.Name="Rekening" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Omschrijving" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:PostRegelEditor}">
                                                    <TextBox Text="{Binding Omschrijving, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Omschrijving van de regel" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Debet" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:PostRegelEditor}">
                                                    <TextBox Text="{Binding Debettekst, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Debet" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Credit" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:PostRegelEditor}">
                                                    <TextBox Text="{Binding Credittekst, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Credit" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:PostRegelEditor}">
                                                    <Button FontFamily="{StaticResource Pictogrammen}" Content="&#xE74D;" Padding="8,4" ToolTip="Regel verwijderen"
                                                            AutomationProperties.Name="Regel verwijderen"
                                                            Command="{Binding DataContext.VerwijderRegelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </g:Detailpaneel>

                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Aantaltekst}" Style="{StaticResource Toelichting}" Margin="0,8,0,0" />
                        <g:LeegScherm DockPanel.Dock="Top" Lijst="Posten" Titel="Geen boekingen in deze lijst" Tekst="Maak een post of lees een bankafschrift in. Controleer anders het jaar en de filters." Knoptekst="Nieuwe post" Opdracht="{Binding NieuwePostCommand}"
                                       Visibility="{Binding Posten.Count, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=0}" />
                        <DataGrid ItemsSource="{Binding Posten}" SelectedItem="{Binding GeselecteerdePost}" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Journaalposten"
                                  Visibility="{Binding Posten.Count, Converter={StaticResource GroterDanNulNaarZichtbaar}}"
                                  AutomationProperties.AutomationId="Journaalposten">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto" SortMemberPath="HeeftBijlage">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE723;" ToolTip="{DynamicResource T.Bijlagen}"
                                                   AutomationProperties.Name="{DynamicResource T.Bijlagen}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:PostRegel}">
                                            <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE723;" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       ToolTip="{Binding AantalBijlagen}" AutomationProperties.Name="Heeft een bijlage"
                                                       Visibility="{Binding HeeftBijlage, Converter={StaticResource BoolNaarZichtbaar}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="Auto" />
                                <DataGridTextColumn Header="Omschrijving" Binding="{Binding Omschrijving}" Width="*" />
                                <DataGridTextColumn Header="Bedrag" Binding="{Binding Bedrag}" Width="Auto" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Bank ===== -->
                <TabItem Header="{DynamicResource T.Tab.Bank}" ToolTip="{DynamicResource U.Bank}" AutomationProperties.AutomationId="SubtabBank">
                    <DockPanel Margin="0,12,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Jaarkeuze}" Focusable="False" IsTabStop="False" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Banksaldotekst}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.AutomationId="Banksaldo"
                                       AutomationProperties.LiveSetting="Polite" />
                            <WrapPanel>
                                <!-- De keuze alleen bij meer dan één bankrekening. -->
                                <Label Content="Bank_rekening" Target="{Binding ElementName=Bankkeuze}" VerticalAlignment="Center" Padding="0,0,8,0"
                                       Visibility="{Binding HeeftMeerdereBankrekeningen, Converter={StaticResource BoolNaarZichtbaar}}" />
                                <ComboBox x:Name="Bankkeuze" ItemsSource="{Binding Bankrekeningen}" SelectedItem="{Binding GekozenBankrekening}"
                                          Width="240" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Bankrekeningkeuze"
                                          Visibility="{Binding HeeftMeerdereBankrekeningen, Converter={StaticResource BoolNaarZichtbaar}}">
                                    <ComboBox.ItemTemplate>
                                        <!-- Het aantal te verwerken achter de naam, zodat het totaal in de navigatiebalk te verklaren is. -->
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource BankkeuzeTekst}">
                                                        <Binding />
                                                        <Binding Path="DataContext.TeVerwerkenPerRekening" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- De hoofdactie is boeken zodra er concepten zijn; regels toepassen gaat vanzelf (besluit 38). -->
                                <Button Content="{Binding ConceptenBoekenTekst}" Command="{Binding ConceptenBoekenCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}"
                                        ToolTip="Ctrl+B" AutomationProperties.AutomationId="ConceptenBoeken"
                                        Visibility="{Binding AantalConceptAlleRekeningen, Converter={StaticResource GroterDanNulNaarZichtbaar}}" />
                                <Button Content="Bankafschrift _inlezen…" Command="{Binding BankInlezenCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                                        ContentTemplate="{StaticResource Toegangstekst}" AutomationProperties.AutomationId="BankInlezen" />
                                <ComboBox ItemsSource="{Binding Bankfilters}" SelectedValuePath="Filter" DisplayMemberPath="Naam"
                                          SelectedValue="{Binding Bankfilter}" Width="150" VerticalAlignment="Center"
                                          AutomationProperties.Name="Tonen" AutomationProperties.AutomationId="Bankfilter" />
                            </WrapPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Bankverschiltekst}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding Bankverschiltekst, Converter={StaticResource NietNullNaarZichtbaar}}"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="Bankverschil" />

                        <g:Detailpaneel DockPanel.Dock="Right" SluitOpdracht="{Binding DataContext.SluitDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding GeselecteerdeMutatie, Converter={StaticResource NietNullNaarZichtbaar}}"
                                        AutomationProperties.Name="Banktransactie" AutomationProperties.AutomationId="Bankdetail">
                            <g:Detailpaneel.Header>
                                <TextBlock>
                                    <Run Text="{Binding GeselecteerdeMutatie.Datum, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding GeselecteerdeMutatie.Bedragtekst, Mode=OneWay}" />
                                </TextBlock>
                            </g:Detailpaneel.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="0,0,12,4" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </Grid.Resources>
                                        <TextBlock Text="Tegenpartij" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding GeselecteerdeMutatie.Tegenpartij}" />
                                        <TextBlock Grid.Row="1" Text="Rekening" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GeselecteerdeMutatie.Tegenrekening}" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="2" Text="Omschrijving" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GeselecteerdeMutatie.Omschrijving}" />
                                        <TextBlock Grid.Row="3" Text="Soort" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GeselecteerdeMutatie.Soort}" ToolTip="{Binding GeselecteerdeMutatie.Code}" />
                                        <TextBlock Grid.Row="4" Text="Status" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1">
                                            <Run Text="{Binding GeselecteerdeMutatie.Status, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding GeselecteerdeMutatie.Postnummer, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Visibility="{Binding GeselecteerdeMutatie.IsTeVerwerken, Converter={StaticResource BoolNaarZichtbaar}}">
                                        <Label Content="{DynamicResource T.Label.Rekening}" Target="{Binding ElementName=Toewijsrekening}" Padding="0,0,0,4" />
                                        <ComboBox x:Name="Toewijsrekening" ItemsSource="{Binding Toewijsrekeningen}" SelectedItem="{Binding ToewijsRekening}"
                                                  IsTextSearchEnabled="True" Margin="0,0,0,8" AutomationProperties.AutomationId="Toewijsrekening" />
                                        <Label Content="Om_schrijving (leeg = van de bank)" Target="{Binding ElementName=Toewijsomschrijving}" Padding="0,0,0,4" />
                                        <TextBox x:Name="Toewijsomschrijving" Text="{Binding ToewijsOmschrijving, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,12">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ToewijzenCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource T.Knop.Toewijzen}" MinWidth="96" Command="{Binding ToewijzenCommand}" ContentTemplate="{StaticResource Toegangstekst}"
                                                    ToolTip="{DynamicResource T.Tip.Toewijzen}" AutomationProperties.AutomationId="Toewijzen" />
                                            <Button Content="Regel _maken…" Command="{Binding RegelMakenCommand}" Style="{StaticResource Linkknop}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    ToolTip="Een boekingsregel, zodat dit voortaan vanzelf gaat" AutomationProperties.AutomationId="RegelMaken" />
                                        </DockPanel>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Toelichting}" Margin="0,12,0,0" TextWrapping="Wrap" Text="{DynamicResource T.Tekst.ConceptBank}" />
                                </StackPanel>
                            </ScrollViewer>
                        </g:Detailpaneel>

                        <g:LeegScherm DockPanel.Dock="Top" Lijst="Mutaties" Titel="Geen banktransacties in deze lijst" Tekst="Lees een bankafschrift van de Rabobank in, of kies bij Tonen een andere stand." Knoptekst="Bankafschrift inlezen…" Opdracht="{Binding BankInlezenCommand}"
                                       Visibility="{Binding Mutaties.Count, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=0}" />
                        <DataGrid ItemsSource="{Binding Mutaties}" SelectedItem="{Binding GeselecteerdeMutatie}" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Banktransacties"
                                  Visibility="{Binding Mutaties.Count, Converter={StaticResource GroterDanNulNaarZichtbaar}}"
                                  AutomationProperties.AutomationId="Banktransacties">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="Auto" />
                                <DataGridTextColumn Header="Tegenpartij" Binding="{Binding Tegenpartij}" Width="2*" />
                                <DataGridTextColumn Header="Omschrijving" Binding="{Binding Omschrijving}" Width="3*" />
                                <DataGridTextColumn Header="Bedrag" Binding="{Binding Bedragtekst}" Width="Auto" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Bonnen ===== -->
                <TabItem Header="{DynamicResource T.Tab.Postvak}" ToolTip="{DynamicResource U.Tab.Postvak}" AutomationProperties.AutomationId="SubtabPostvak">
                    <!-- De hele pagina is een sleepvlak voor bonnen. -->
                    <DockPanel Margin="0,12,0,0" AllowDrop="True" Background="Transparent" DragOver="Bijlagen_DragOver" Drop="Postvak_Drop">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding Postvak.Count, Converter={StaticResource GroterDanNulNaarZichtbaar}}">
                            <Button Content="_Bonnen toevoegen…" Command="{Binding BonnenToevoegenCommand}" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}"
                                    ToolTip="PDF, JPG of PNG, maximaal 10 MB per bestand; of sleep ze hierheen" AutomationProperties.AutomationId="BonnenToevoegen" />
                        </WrapPanel>

                        <g:Detailpaneel DockPanel.Dock="Right" DataContext="{Binding GeselecteerdeBon}" d:DataContext="{d:DesignInstance Type=vm:BonRegel}"
                                        SluitOpdracht="{Binding DataContext.SluitDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Header="{Binding Bestandsnaam}" Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}"
                                        AutomationProperties.Name="Bon" AutomationProperties.AutomationId="BonDetail">
                            <StackPanel>
                                <Label Content="_Datum op de bon" Target="{Binding ElementName=Bondatum}" Padding="0,0,0,4" />
                                <DatePicker x:Name="Bondatum" SelectedDate="{Binding Datum}" Width="160" HorizontalAlignment="Left" AutomationProperties.AutomationId="BonDatum" />
                                <Label Content="B_edrag" Target="{Binding ElementName=Bonbedrag}" Padding="0,12,0,4" />
                                <TextBox x:Name="Bonbedrag" Text="{Binding Bedragtekst, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"
                                         TextAlignment="Right" AutomationProperties.AutomationId="BonBedrag" ToolTip="Bij een creditnota met minteken, bijvoorbeeld -15,00">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNegatief}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}" AutomationProperties.LiveSetting="Assertive" />
                                <Label Content="_Hoort bij post" Target="{Binding ElementName=Bonpost}" Padding="0,12,0,4" />
                                <ComboBox x:Name="Bonpost" ItemsSource="{Binding Postkeuzes}" SelectedItem="{Binding GekozenPost}" DisplayMemberPath="Tekst"
                                          IsTextSearchEnabled="True" TextSearch.TextPath="Tekst" AutomationProperties.AutomationId="BonPost"
                                          ToolTip="Voorstellen (✓) hebben precies hetzelfde bedrag en een datum binnen 7 dagen" />
                                <TextBlock Style="{StaticResource Toelichting}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="Datum en bedrag worden vanzelf bewaard. Dubbelklik op een bon om hem te bekijken." />
                                <DockPanel Margin="0,16,0,0">
                                    <Button DockPanel.Dock="Right" Content="Koppele_n" MinWidth="96" ContentTemplate="{StaticResource Toegangstekst}"
                                            Command="{Binding DataContext.BonKoppelenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            AutomationProperties.AutomationId="BonKoppelen" />
                                    <Button Content="_Bekijken…" Style="{StaticResource Linkknop}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Command="{Binding DataContext.BonBekijkenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            AutomationProperties.AutomationId="BonBekijken" />
                                </DockPanel>
                            </StackPanel>
                        </g:Detailpaneel>

                        <g:LeegScherm DockPanel.Dock="Top" Lijst="Postvak" Titel="Nog geen bonnen" Tekst="Sleep bonnen hierheen of kies ze. Van een PDF leest BTW-Boeker datum en bedrag en stelt voor bij welke boeking ze horen." Knoptekst="Bonnen toevoegen…" Opdracht="{Binding BonnenToevoegenCommand}"
                                       Visibility="{Binding Postvak.Count, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=0}" />
                        <DataGrid ItemsSource="{Binding Postvak}" SelectedItem="{Binding GeselecteerdeBon}" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column"
                                  Visibility="{Binding Postvak.Count, Converter={StaticResource GroterDanNulNaarZichtbaar}}"
                                  AutomationProperties.Name="Bonnen" AutomationProperties.AutomationId="Postvak">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding BonBekijkenCommand}" />
                                <KeyBinding Key="Delete" Command="{Binding BonVerwijderenCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="_Bekijken…" Command="{Binding BonBekijkenCommand}" />
                                    <MenuItem Header="_Verwijderen…" InputGestureText="Del" Command="{Binding BonVerwijderenCommand}" AutomationProperties.AutomationId="BonVerwijderen" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bestand" Binding="{Binding Bestandsnaam}" Width="2*" />
                                <DataGridTextColumn Header="Datum" Binding="{Binding Datumtekst}" Width="Auto" />
                                <DataGridTextColumn Header="Bedrag" Binding="{Binding Bedragtekst}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Style.Triggers>
                                                <!-- Creditnota in groen; het minteken blijft. -->
                                                <DataTrigger Binding="{Binding IsNegatief}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Voorstel" Binding="{Binding Voorsteltekst}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Boekingsregels ===== -->
                <TabItem Header="{DynamicResource T.Tab.Boekingsregels}" ToolTip="{DynamicResource U.Boekingsregels}" AutomationProperties.AutomationId="SubtabBoekingsregels">
                    <DockPanel Margin="0,12,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button Content="_Nieuwe regel" Command="{Binding NieuweRegelCommand}" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}" Margin="0,0,16,0" AutomationProperties.AutomationId="NieuweBoekingsregel" />
                            <!-- Verplaatsen alleen bij een gekozen regel: de eerste passende regel wint. -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding GeselecteerdeRegel, Converter={StaticResource NietNullNaarZichtbaar}}">
                                <Button FontFamily="{StaticResource Pictogrammen}" Content="&#xE70E;" Padding="8,4" Margin="0,0,4,0" Command="{Binding RegelOmhoogCommand}"
                                        ToolTip="Omhoog (Alt+↑)" AutomationProperties.Name="Regel omhoog" />
                                <Button FontFamily="{StaticResource Pictogrammen}" Content="&#xE70D;" Padding="8,4" Command="{Binding RegelOmlaagCommand}"
                                        ToolTip="Omlaag (Alt+↓)" AutomationProperties.Name="Regel omlaag" />
                            </StackPanel>
                        </WrapPanel>
                        <!-- Een nieuwe rekening staat pas na opslaan in de keuzelijst. -->
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource T.Melding.RekeningNietOpgeslagen}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding HeeftOnopgeslagenNieuweRekeningen, Converter={StaticResource BoolNaarZichtbaar}}"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="RekeningNietOpgeslagen" />

                        <g:Detailpaneel DockPanel.Dock="Right" DataContext="{Binding GeselecteerdeRegel}" d:DataContext="{d:DesignInstance Type=vm:BoekingsregelRegel}"
                                        SluitOpdracht="{Binding DataContext.SluitDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Header="{Binding Naam}" Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}"
                                        AutomationProperties.Name="Boekingsregel" AutomationProperties.AutomationId="BoekingsregelDetail">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Label Content="Na_am" Target="{Binding ElementName=RegelNaam}" Padding="0,0,0,4" />
                                    <TextBox x:Name="RegelNaam" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RegelNaam" />
                                    <Label Content="{DynamicResource T.Label.Rekening}" Target="{Binding ElementName=RegelRekening}" Padding="0,12,0,4" />
                                    <ComboBox x:Name="RegelRekening" ItemsSource="{Binding Rekeningen}" SelectedItem="{Binding GekozenRekening, UpdateSourceTrigger=PropertyChanged}"
                                              IsTextSearchEnabled="True" AutomationProperties.AutomationId="RegelRekening" />
                                    <Label Content="Omschrijving van de _post (leeg = van de bank)" Target="{Binding ElementName=RegelOmschrijving}" Padding="0,12,0,4" />
                                    <TextBox x:Name="RegelOmschrijving" Text="{Binding Omschrijving, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Ac_tief" ContentTemplate="{StaticResource Toegangstekst}" IsChecked="{Binding IsActief}" Margin="0,12,0,0" />

                                    <TextBlock Text="Wanneer" FontWeight="SemiBold" Margin="0,24,0,0" />
                                    <TextBlock Style="{StaticResource Toelichting}" Text="Alle voorwaarden samen; een lege voorwaarde doet niet mee." TextWrapping="Wrap" />
                                    <StackPanel Visibility="{Binding IsTegenIbanZichtbaar, Converter={StaticResource BoolNaarZichtbaar}}">
                                        <Label Content="Tegen-_IBAN" Target="{Binding ElementName=RegelIban}" Padding="0,12,0,4" />
                                        <TextBox x:Name="RegelIban" Text="{Binding TegenIban, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsNaamBevatZichtbaar, Converter={StaticResource BoolNaarZichtbaar}}">
                                        <Label Content="Naam _bevat" Target="{Binding ElementName=RegelNaamBevat}" Padding="0,12,0,4" />
                                        <TextBox x:Name="RegelNaamBevat" Text="{Binding NaamBevat, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsOmschrijvingBevatZichtbaar, Converter={StaticResource BoolNaarZichtbaar}}">
                                        <Label Content="Omschrijving b_evat" Target="{Binding ElementName=RegelOmschrijvingBevat}" Padding="0,12,0,4" />
                                        <TextBox x:Name="RegelOmschrijvingBevat" Text="{Binding OmschrijvingBevat, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsRichtingZichtbaar, Converter={StaticResource BoolNaarZichtbaar}}">
                                        <Label Content="Bij of _af" Target="{Binding ElementName=RegelRichting}" Padding="0,12,0,4" />
                                        <ComboBox x:Name="RegelRichting" Width="140" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding DataContext.Richtingen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Richting, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsBedragZichtbaar, Converter={StaticResource BoolNaarZichtbaar}}">
                                        <Label Content="Bedrag _van … tot" Target="{Binding ElementName=RegelBedragVan}" Padding="0,12,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="RegelBedragVan" Width="100" TextAlignment="Right" Text="{Binding BedragVanTekst, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bedrag van" />
                                            <TextBlock Text="tot" VerticalAlignment="Center" Margin="8,0" />
                                            <TextBox Width="100" TextAlignment="Right" Text="{Binding BedragTotTekst, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bedrag tot" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsTransactiecodeZichtbaar, Converter={StaticResource BoolNaarZichtbaar}}">
                                        <Label Content="Transactie_code" Target="{Binding ElementName=RegelCode}" Padding="0,12,0,4" />
                                        <ComboBox x:Name="RegelCode" IsEditable="True" Text="{Binding Transactiecode, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.Transactiecodekeuzes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  TextSearch.TextPath="Code" />
                                    </StackPanel>
                                    <Button Content="Voorwaarde toevoegen ▾" Style="{StaticResource Linkknop}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Knopmenu_Click"
                                            Visibility="{Binding HeeftToeTeVoegenVoorwaarden, Converter={StaticResource BoolNaarZichtbaar}}"
                                            AutomationProperties.AutomationId="VoorwaardeToevoegen">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Tegen-IBAN" Command="{Binding VoorwaardeToevoegenCommand}" CommandParameter="{x:Static vm:Voorwaarde.TegenIban}"
                                                          Visibility="{Binding IsTegenIbanZichtbaar, Converter={StaticResource OnwaarNaarZichtbaar}}" />
                                                <MenuItem Header="Naam bevat" Command="{Binding VoorwaardeToevoegenCommand}" CommandParameter="{x:Static vm:Voorwaarde.NaamBevat}"
                                                          Visibility="{Binding IsNaamBevatZichtbaar, Converter={StaticResource OnwaarNaarZichtbaar}}" />
                                                <MenuItem Header="Omschrijving bevat" Command="{Binding VoorwaardeToevoegenCommand}" CommandParameter="{x:Static vm:Voorwaarde.OmschrijvingBevat}"
                                                          Visibility="{Binding IsOmschrijvingBevatZichtbaar, Converter={StaticResource OnwaarNaarZichtbaar}}" />
                                                <MenuItem Header="Bij of af" Command="{Binding VoorwaardeToevoegenCommand}" CommandParameter="{x:Static vm:Voorwaarde.Richting}"
                                                          Visibility="{Binding IsRichtingZichtbaar, Converter={StaticResource OnwaarNaarZichtbaar}}" />
                                                <MenuItem Header="Bedrag" Command="{Binding VoorwaardeToevoegenCommand}" CommandParameter="{x:Static vm:Voorwaarde.Bedrag}"
                                                          Visibility="{Binding IsBedragZichtbaar, Converter={StaticResource OnwaarNaarZichtbaar}}" />
                                                <MenuItem Header="Transactiecode" Command="{Binding VoorwaardeToevoegenCommand}" CommandParameter="{x:Static vm:Voorwaarde.Transactiecode}"
                                                          Visibility="{Binding IsTransactiecodeZichtbaar, Converter={StaticResource OnwaarNaarZichtbaar}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"
                                               Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                        <Button Content="_Verwijderen…" Command="{Binding DataContext.VerwijderRegelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AutomationProperties.AutomationId="RegelVerwijderen" />
                                        <Button Content="Opslaan" MinWidth="96" Margin="8,0,0,0" Command="{Binding DataContext.OpslaanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding DataContext.HeeftOnopgeslagenWijzigingenMetDetail, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolNaarZichtbaar}}"
                                                ToolTip="Opslaan (Ctrl+S)" AutomationProperties.AutomationId="DetailOpslaan" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </g:Detailpaneel>

                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="De eerste passende regel in deze volgorde wint. Overboekingen tussen eigen rekeningen gaan altijd via Kruisposten." />
                        <g:LeegScherm DockPanel.Dock="Top" Lijst="Boekingsregels" Titel="Nog geen boekingsregels" Tekst="Een regel deelt banktransacties automatisch in. Maak er een, of kies bij een transactie Regel maken." Knoptekst="Nieuwe regel" Opdracht="{Binding NieuweRegelCommand}"
                                       Visibility="{Binding Boekingsregels.Count, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=0}" />
                        <DataGrid ItemsSource="{Binding Boekingsregels}" SelectedItem="{Binding GeselecteerdeRegel}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                                  Visibility="{Binding Boekingsregels.Count, Converter={StaticResource GroterDanNulNaarZichtbaar}}"
                                  AutomationProperties.Name="Boekingsregels" AutomationProperties.AutomationId="Boekingsregels">
                            <DataGrid.InputBindings>
                                <KeyBinding Gesture="Alt+Up" Command="{Binding RegelOmhoogCommand}" />
                                <KeyBinding Gesture="Alt+Down" Command="{Binding RegelOmlaagCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="*" />
                                <DataGridTextColumn Header="Wanneer" Binding="{Binding Wanneer}" Width="2*" />
                                <DataGridTextColumn Header="Rekening" Binding="{Binding Waarheen}" Width="*" />
                                <DataGridCheckBoxColumn Header="Actief" Binding="{Binding IsActief}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Relaties ===== -->
                <TabItem Header="{DynamicResource T.Tab.Relaties}" AutomationProperties.AutomationId="SubtabRelaties">
                    <DockPanel Margin="0,12,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding Relaties.Count, Converter={StaticResource GroterDanNulNaarZichtbaar}}">
                            <Button Content="Nieu_we relatie" Command="{Binding NieuweRelatieCommand}" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}" AutomationProperties.AutomationId="NieuweRelatie" />
                        </WrapPanel>

                        <g:Detailpaneel DockPanel.Dock="Right" DataContext="{Binding GeselecteerdeRelatie}" d:DataContext="{d:DesignInstance Type=vm:RelatieRegel}"
                                        SluitOpdracht="{Binding DataContext.SluitDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Header="{Binding Naam}" Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}"
                                        AutomationProperties.Name="Relatie" AutomationProperties.AutomationId="RelatieEditor">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Label Content="_Naam" Target="{Binding ElementName=RelatieNaam}" Padding="0,0,0,4" />
                                    <TextBox x:Name="RelatieNaam" MaxLength="100" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RelatieNaam" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <CheckBox Content="_Klant" ContentTemplate="{StaticResource Toegangstekst}" IsChecked="{Binding IsDebiteur}" Margin="0,0,16,0" ToolTip="Stuurt u facturen (debiteur)" />
                                        <CheckBox Content="_Leverancier" ContentTemplate="{StaticResource Toegangstekst}" IsChecked="{Binding IsCrediteur}" Margin="0,0,16,0" ToolTip="Stuurt u rekeningen (crediteur)" />
                                        <CheckBox Content="Ac_tief" ContentTemplate="{StaticResource Toegangstekst}" IsChecked="{Binding IsActief}" />
                                    </StackPanel>
                                    <Label Content="C_ontactpersoon" Target="{Binding ElementName=RelatieContact}" Padding="0,12,0,4" />
                                    <TextBox x:Name="RelatieContact" MaxLength="100" Text="{Binding Contactpersoon, UpdateSourceTrigger=PropertyChanged}" />
                                    <Label Content="Straat en n_ummer" Target="{Binding ElementName=RelatieStraat}" Padding="0,12,0,4" />
                                    <TextBox x:Name="RelatieStraat" MaxLength="100" Text="{Binding Straat, UpdateSourceTrigger=PropertyChanged}" />
                                    <Label Content="Pos_tcode en plaats" Target="{Binding ElementName=RelatiePostcode}" Padding="0,12,0,4" />
                                    <DockPanel>
                                        <TextBox x:Name="RelatiePostcode" Width="96" MaxLength="10" Margin="0,0,8,0" Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Postcode" />
                                        <TextBox MaxLength="100" Text="{Binding Plaats, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Plaats" />
                                    </DockPanel>
                                    <Label Content="E-_mail" Target="{Binding ElementName=RelatieEmail}" Padding="0,12,0,4" />
                                    <TextBox x:Name="RelatieEmail" MaxLength="254" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                    <Label Content="Tele_foon" Target="{Binding ElementName=RelatieTelefoon}" Padding="0,12,0,4" />
                                    <TextBox x:Name="RelatieTelefoon" MaxLength="20" Text="{Binding Telefoon, UpdateSourceTrigger=PropertyChanged}" />
                                    <Label Content="_IBAN" Target="{Binding ElementName=RelatieIban}" Padding="0,12,0,4" />
                                    <TextBox x:Name="RelatieIban" FontFamily="Consolas" MaxLength="42" Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Wordt gebruikt om betalingen in de bank te herkennen" AutomationProperties.AutomationId="RelatieIban" />
                                    <Label Content="No_titie" Target="{Binding ElementName=RelatieNotitie}" Padding="0,12,0,4" />
                                    <TextBox x:Name="RelatieNotitie" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000"
                                             Text="{Binding Notitie, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}" Margin="0,8,0,0" AutomationProperties.AutomationId="RelatieFout"
                                               Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                        <Button Content="Opslaan" MinWidth="96" Margin="8,0,0,0" Command="{Binding DataContext.OpslaanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding DataContext.HeeftOnopgeslagenWijzigingenMetDetail, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolNaarZichtbaar}}"
                                                ToolTip="Opslaan (Ctrl+S)" AutomationProperties.AutomationId="DetailOpslaan" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </g:Detailpaneel>

                        <g:LeegScherm DockPanel.Dock="Top" Lijst="Relaties" Titel="Nog geen relaties" Tekst="Relaties zijn klanten en leveranciers, zoals een verhuurorganisatie of energieleverancier." Knoptekst="Nieuwe relatie" Opdracht="{Binding NieuweRelatieCommand}"
                                       Visibility="{Binding Relaties.Count, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=0}" />
                        <DataGrid ItemsSource="{Binding Relaties}" SelectedItem="{Binding GeselecteerdeRelatie}" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Relaties"
                                  Visibility="{Binding Relaties.Count, Converter={StaticResource GroterDanNulNaarZichtbaar}}"
                                  AutomationProperties.AutomationId="Relaties">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="2*" />
                                <DataGridTextColumn Header="Plaats" Binding="{Binding Plaats}" Width="*" />
                                <DataGridTextColumn Header="Soort" Binding="{Binding Rol}" Width="Auto" />
                                <DataGridCheckBoxColumn Header="Actief" Binding="{Binding IsActief}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Rekeningschema ===== -->
                <TabItem Header="{DynamicResource T.Tab.Rekeningschema}" ToolTip="{DynamicResource U.Rekeningschema}" AutomationProperties.AutomationId="SubtabRekeningschema">
                    <DockPanel Margin="0,12,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button Content="{DynamicResource T.Knop.NieuweRekening}" Command="{Binding NieuweRekeningCommand}" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource Toegangstekst}" Margin="0,0,16,0" AutomationProperties.AutomationId="NieuweRekening" />
                            <!-- Het invoerveld pas na een klik op + Rubriek. -->
                            <Button Content="+ R_ubriek" Command="{Binding RubriekinvoerOpenenCommand}" Style="{StaticResource Linkknop}" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="RubriekinvoerOpenen"
                                    Visibility="{Binding IsRubriekinvoerOpen, Converter={StaticResource OnwaarNaarZichtbaar}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRubriekinvoerOpen, Converter={StaticResource BoolNaarZichtbaar}}">
                                <TextBox Width="200" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding NieuweRubriekNaam, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Naam van de nieuwe rubriek" />
                                <Button Content="{DynamicResource T.Knop.RubriekToevoegen}" Command="{Binding NieuweRubriekCommand}" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>

                        <g:Detailpaneel DockPanel.Dock="Right" DataContext="{Binding GeselecteerdeRekening}" d:DataContext="{d:DesignInstance Type=vm:RekeningRegel}"
                                        SluitOpdracht="{Binding DataContext.SluitDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Header="{Binding Naam}" Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}"
                                        AutomationProperties.Name="Rekening" AutomationProperties.AutomationId="RekeningDetail">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Label Content="N_ummer" Target="{Binding ElementName=RekeningNummer}" Padding="0,0,0,4" />
                                    <TextBox x:Name="RekeningNummer" Width="96" HorizontalAlignment="Left" Text="{Binding Nummertekst, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsNieuw, Converter={StaticResource Niet}}" ToolTip="Het nummer van een bestaande rekening staat vast"
                                             AutomationProperties.AutomationId="RekeningNummer" />
                                    <Label Content="_Naam" Target="{Binding ElementName=RekeningNaam}" Padding="0,12,0,4" />
                                    <TextBox x:Name="RekeningNaam" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RekeningNaam" />
                                    <Label Content="{DynamicResource T.Rubriek}" Target="{Binding ElementName=RekeningRubriek}" Padding="0,12,0,4" />
                                    <ComboBox x:Name="RekeningRubriek" ItemsSource="{Binding Rubrieken}" SelectedItem="{Binding GekozenRubriek, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Naam" AutomationProperties.Name="Rubriek" />
                                    <Label Content="_Soort" Target="{Binding ElementName=RekeningSoort}" Padding="0,12,0,4" />
                                    <ComboBox x:Name="RekeningSoort" Width="160" HorizontalAlignment="Left"
                                              ItemsSource="{Binding DataContext.Soorten, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Soort, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="De soort van een rekening waarop al is geboekt staat vast" />
                                    <StackPanel Visibility="{Binding KantIsKiesbaar, Converter={StaticResource BoolNaarZichtbaar}}">
                                        <Label Content="{DynamicResource T.Kant}" Target="{Binding ElementName=RekeningKant}" Padding="0,12,0,4" />
                                        <ComboBox x:Name="RekeningKant" Width="160" HorizontalAlignment="Left" ItemsSource="{x:Static vm:RekeningRegel.Kanten}"
                                                  SelectedItem="{Binding Kant, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Baten of lasten"
                                                  ToolTip="Baten (inkomsten) of lasten (uitgaven); bepaalt waar de rekening in de jaarrekening staat." />
                                    </StackPanel>
                                    <CheckBox Content="Ac_tief" ContentTemplate="{StaticResource Toegangstekst}" IsChecked="{Binding IsActief, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"
                                              ToolTip="Een rekening die niet meer wordt gebruikt, maakt u inactief" />
                                    <Expander Header="Geavanceerd" Margin="0,16,0,0">
                                        <StackPanel>
                                            <Label Content="_Rol" Target="{Binding ElementName=RekeningRol}" Padding="0,8,0,4" />
                                            <ComboBox x:Name="RekeningRol" Width="160" HorizontalAlignment="Left"
                                                      ItemsSource="{Binding DataContext.Rollen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Rol, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource Toelichting}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="Reserve: hierheen gaat het resultaat bij de jaarafsluiting. Kruisposten: tussenrekening voor overboekingen. Kas: rekening van het kasboek." />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock Margin="0,16,0,0">
                                        <Run Text="Saldo " Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding Saldotekst, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}" Margin="0,8,0,0"
                                               Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                        <Button Content="Opslaan" MinWidth="96" Margin="8,0,0,0" Command="{Binding DataContext.OpslaanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding DataContext.HeeftOnopgeslagenWijzigingenMetDetail, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolNaarZichtbaar}}"
                                                ToolTip="Opslaan (Ctrl+S)" AutomationProperties.AutomationId="DetailOpslaan" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </g:Detailpaneel>

                        <DataGrid ItemsSource="{Binding Rekeningen}" SelectedItem="{Binding GeselecteerdeRekening}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" SelectionMode="Single"
                                  AutomationProperties.Name="Rekeningschema" AutomationProperties.AutomationId="Rekeningschema">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nummer" Binding="{Binding Nummertekst}" Width="Auto" SortMemberPath="Nummer" />
                                <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="2*" />
                                <DataGridTextColumn Header="{DynamicResource T.Rubriek}" Binding="{Binding GekozenRubriek.Naam}" Width="*" />
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldotekst}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridCheckBoxColumn Header="Actief" Binding="{Binding IsActief}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Grootboekkaart ===== -->
                <TabItem Header="{DynamicResource T.Tab.Grootboekkaart}" ToolTip="{DynamicResource U.Grootboekkaart}" AutomationProperties.AutomationId="SubtabGrootboekkaart">
                    <DockPanel Margin="0,12,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Jaarkeuze}" Focusable="False" IsTabStop="False" />
                            <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Uitvoer}" Focusable="False" IsTabStop="False" />
                            <WrapPanel>
                            <Label Content="{DynamicResource T.Label.Rekening}" Target="{Binding ElementName=Kaartrekening}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <ComboBox x:Name="Kaartrekening" ItemsSource="{Binding Rekeningkeuzes}" SelectedItem="{Binding KaartRekening}" Width="280"
                                      IsTextSearchEnabled="True" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.AutomationId="KaartRekening" />
                            <Label Content="_Van" Target="{Binding ElementName=KaartVan}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <DatePicker x:Name="KaartVan" SelectedDate="{Binding KaartVan}" Width="130" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Label Content="_Tot en met" Target="{Binding ElementName=KaartTot}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <DatePicker x:Name="KaartTot" SelectedDate="{Binding KaartTot}" Width="130" VerticalAlignment="Center" />
                            </WrapPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Run Text="Beginsaldo " /><Run Text="{Binding KaartBeginsaldo, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="   ·   eindsaldo " /><Run Text="{Binding KaartEindsaldo, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="   (positief = debet)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding KaartMutaties}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  AutomationProperties.Name="Mutaties op de grootboekkaart" AutomationProperties.AutomationId="KaartMutaties">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="Auto" />
                                <DataGridTextColumn Header="Nummer" Binding="{Binding Nummer}" Width="Auto" />
                                <DataGridTextColumn Header="Omschrijving" Binding="{Binding Omschrijving}" Width="*" />
                                <DataGridTextColumn Binding="{Binding Debet}" Width="Auto">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding Data.KaartDebetkop, Source={StaticResource Kaartproxy}}" ToolTip="{Binding Data.KaartKoptip, Source={StaticResource Kaartproxy}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Credit}" Width="Auto">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding Data.KaartCreditkop, Source={StaticResource Kaartproxy}}" ToolTip="{Binding Data.KaartKoptip, Source={StaticResource Kaartproxy}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Rapporten ===== -->
                <TabItem Header="{DynamicResource T.Tab.Rapporten}" AutomationProperties.AutomationId="SubtabRapporten">
                    <DockPanel Margin="0,12,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Jaarkeuze}" Focusable="False" IsTabStop="False" />
                            <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Uitvoer}" Focusable="False" IsTabStop="False" />
                            <StackPanel Orientation="Horizontal">
                            <Label Content="Rapport" Target="{Binding ElementName=Rapportkeuze}" VerticalAlignment="Center" Padding="0,0,8,0" />
                            <ComboBox x:Name="Rapportkeuze" ItemsSource="{Binding Rapportkeuzes}" SelectedValuePath="Soort" DisplayMemberPath="Naam"
                                      SelectedValue="{Binding Rapportsoort}" Width="240" AutomationProperties.AutomationId="Rapportkeuze" />
                            <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" Text="{Binding Conceptmelding}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="Conceptmelding"
                                       Visibility="{Binding Conceptmelding, Converter={StaticResource NietNullNaarZichtbaar}}" />
                            </StackPanel>
                        </DockPanel>
                        <!-- Jaarrekening volgens de eigen indeling -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"
                                    Visibility="{Binding IsJaarrekening, Converter={StaticResource BoolNaarZichtbaar}}">
                            <CheckBox Content="_Rekeningen tonen" ContentTemplate="{StaticResource Toegangstekst}" IsChecked="{Binding RekeningenTonen}"
                                      VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.AutomationId="RekeningenTonen" />
                            <Button Content="_Indeling bewerken…" Command="{Binding IndelingBewerkenCommand}" AutomationProperties.AutomationId="IndelingBewerken"
                                    ToolTip="Kopjes, regels en subtotalen kiezen; het rekeningschema en de boekingen veranderen niet." />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding JaarrekeningMelding}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding JaarrekeningMelding, Converter={StaticResource NietNullNaarZichtbaar}}"
                                   AutomationProperties.AutomationId="JaarrekeningMelding" />
                        <FlowDocumentScrollViewer Document="{Binding Rapport, Converter={StaticResource RapportNaarDocument}}" VerticalScrollBarVisibility="Auto"
                                                  IsToolBarVisible="False" AutomationProperties.Name="Rapport" AutomationProperties.AutomationId="Rapport" />
                    </DockPanel>
                </TabItem>

                <!-- ===== Boekjaren ===== -->
                <TabItem Header="{DynamicResource T.Tab.Boekjaren}" AutomationProperties.AutomationId="SubtabBoekjaren">
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Volgend boekjaar _openen" Command="{Binding OpenVolgendBoekjaarCommand}"
                                Margin="0,0,0,12" ToolTip="Om alvast in het volgende jaar te boeken, voordat het huidige jaar is afgesloten" />
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Toelichting}" Margin="0,8,0,0"
                                   Text="Afsluiten kan als er geen concepten meer zijn en eerdere jaren zijn afgesloten. Het resultaat gaat naar de reserverekening; vooraf wordt een back-up gemaakt." />
                        <DataGrid ItemsSource="{Binding Jaren}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  AutomationProperties.Name="Boekjaren" AutomationProperties.AutomationId="Boekjaren">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Boekjaar" Binding="{Binding Jaartekst}" Width="Auto" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Statustekst}" Width="Auto" />
                                <DataGridTextColumn Header="Geboekt" Binding="{Binding AantalGeboekt}" Width="Auto" />
                                <DataGridTextColumn Header="Concepten" Binding="{Binding AantalConcepten}" Width="Auto" />
                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:JaarRegel}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Afsluiten..." Margin="0,0,8,0" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.SluitBoekjaarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding IsOpen, Converter={StaticResource BoolNaarZichtbaar}}"
                                                        AutomationProperties.Name="{Binding Jaartekst, StringFormat=Boekjaar {0} afsluiten}" />
                                                <Button Content="Heropenen..." Margin="0,0,8,0" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.HeropenBoekjaarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding IsAfgesloten, Converter={StaticResource BoolNaarZichtbaar}}"
                                                        AutomationProperties.Name="{Binding Jaartekst, StringFormat=Boekjaar {0} heropenen}" />
                                                <Button Content="Auditfile (XAF)..." CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.ExporteerXafCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="Het boekjaar als XML Auditfile Financieel (XAF 3.2), voor een accountant of een ander boekhoudpakket"
                                                        AutomationProperties.Name="{Binding Jaartekst, StringFormat=Auditfile van boekjaar {0} exporteren}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</UserControl>
