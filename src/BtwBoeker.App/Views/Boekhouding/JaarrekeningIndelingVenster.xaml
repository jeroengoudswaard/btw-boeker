<Window x:Class="BtwBoeker.App.Views.Boekhouding.JaarrekeningIndelingVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BtwBoeker.App.ViewModels.Boekhouding"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:JaarrekeningIndelingViewModel}"
        Title="{Binding Titel}"
        Width="920" Height="640" MinWidth="680" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="JaarrekeningIndeling">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="{Binding Titel}" Style="{StaticResource Sectietitel}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Toelichting}" TextWrapping="Wrap"
                           Text="Kies per deel kopjes, regels en subtotalen. Een regel telt de rekeningen van de gekozen rubrieken op. Het rekeningschema en de boekingen veranderen niet." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="_Eén regel per rubriek" Command="{Binding AutomatischCommand}" AutomationProperties.AutomationId="IndelingAutomatisch"
                        ToolTip="Begin opnieuw met de indeling van het rekeningschema; pas na Opslaan definitief." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="_Opslaan" Style="{StaticResource DialoogKnop}" IsDefault="True" Command="{Binding OpslaanCommand}"
                            AutomationProperties.AutomationId="IndelingOpslaan" />
                    <Button Content="Annuleren" Style="{StaticResource DialoogKnop}" IsCancel="True" AutomationProperties.AutomationId="IndelingAnnuleren" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Margin="24,0,24,8" Text="{Binding Fout}" Style="{StaticResource Foutmelding}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="IndelingFout"
                   Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />

        <Grid Margin="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Lijst met regels -->
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Nieuwe _regel" Command="{Binding NieuweRegelCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="IndelingNieuweRegel" />
                    <Button Content="Nieuwe _kop" Command="{Binding NieuweKopCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="IndelingNieuweKop" />
                    <Button Content="_Subtotaal" Command="{Binding NieuwSubtotaalCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="IndelingNieuwSubtotaal" />
                    <Button Content="Om_hoog" Command="{Binding OmhoogCommand}" Margin="0,0,8,8" ToolTip="Alt+Omhoog" AutomationProperties.AutomationId="IndelingOmhoog" />
                    <Button Content="Om_laag" Command="{Binding OmlaagCommand}" Margin="0,0,8,8" ToolTip="Alt+Omlaag" AutomationProperties.AutomationId="IndelingOmlaag" />
                    <Button Content="_Verwijderen" Command="{Binding VerwijderCommand}" Margin="0,0,8,8" ToolTip="Delete" AutomationProperties.AutomationId="IndelingVerwijderen" />
                </WrapPanel>
                <ListBox ItemsSource="{Binding Regels}" SelectedItem="{Binding Geselecteerd}" DisplayMemberPath="Omschrijving"
                         AutomationProperties.Name="Regels van de indeling" AutomationProperties.AutomationId="IndelingRegels">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding OmhoogCommand}" />
                        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding OmlaagCommand}" />
                        <KeyBinding Key="Delete" Command="{Binding VerwijderCommand}" />
                    </ListBox.InputBindings>
                </ListBox>
            </DockPanel>

            <!-- Gekozen regel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding Geselecteerd}"
                          Visibility="{Binding Converter={StaticResource NietNullNaarZichtbaar}}">
                <StackPanel>
                    <Label Content="_Deel" Target="{Binding ElementName=DeelKeuze}" Padding="0,0,0,4" />
                    <ComboBox x:Name="DeelKeuze" Margin="0,0,0,12" SelectedValue="{Binding Afdeling}" SelectedValuePath="Waarde" DisplayMemberPath="Naam"
                              ItemsSource="{Binding DataContext.Afdelingen, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.AutomationId="IndelingDeel" />
                    <Label Content="S_oort" Target="{Binding ElementName=SoortKeuze}" Padding="0,0,0,4" />
                    <ComboBox x:Name="SoortKeuze" Margin="0,0,0,12" SelectedValue="{Binding Soort}" SelectedValuePath="Waarde" DisplayMemberPath="Naam"
                              ItemsSource="{Binding DataContext.Soorten, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.AutomationId="IndelingSoort" />
                    <Label Content="_Tekst" Target="{Binding ElementName=TekstVeld}" Padding="0,0,0,4" />
                    <TextBox x:Name="TekstVeld" Margin="0,0,0,12" MaxLength="100" Text="{Binding Tekst, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="IndelingTekst" />
                    <StackPanel Visibility="{Binding IsRegel, Converter={StaticResource BoolNaarZichtbaar}}">
                        <TextBlock Text="Rubrieken" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Toelichting}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Een grijze rubriek staat al bij een andere regel van dit deel." />
                        <ItemsControl ItemsSource="{Binding Rubrieken}" AutomationProperties.Name="Rubrieken" AutomationProperties.AutomationId="IndelingRubrieken">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RubriekKeuze}">
                                    <CheckBox Content="{Binding Naam}" IsChecked="{Binding IsGekozen}" IsEnabled="{Binding KanKiezen}" Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
