<Window x:Class="BtwBoeker.App.Views.Boekhouding.BankImportVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BtwBoeker.App.ViewModels.Boekhouding"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BankImportViewModel}"
        Title="Bankafschriften inlezen (CAMT.053)"
        Width="900" Height="600" MinWidth="640" MinHeight="440"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="BankImport">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="Stappen">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,24,0" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock x:Name="Stap1" Text="1  Bestanden" />
                <TextBlock x:Name="Stap2" Text="2  Controleren" />
                <TextBlock x:Name="Stap3" Text="3  Klaar" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Left" Width="120" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding IsBezig, Converter={StaticResource BoolNaarZichtbaar}}" AutomationProperties.Name="Bezig" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt; V_orige" Style="{StaticResource DialoogKnop}" Command="{Binding VorigeCommand}"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}" AutomationProperties.AutomationId="BankImportVorige" />
                    <Button Style="{StaticResource DialoogKnop}" IsDefault="True" Command="{Binding VolgendeCommand}"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}" AutomationProperties.AutomationId="BankImportVolgende">
                        <AccessText Text="{Binding Volgendetekst, StringFormat='_{0} &gt;'}" />
                    </Button>
                    <Button Content="Annuleren" Style="{StaticResource DialoogKnop}" IsCancel="True"
                            Visibility="{Binding IsKlaar, Converter={StaticResource OnwaarNaarZichtbaar}}" AutomationProperties.AutomationId="BankImportAnnuleren" />
                    <Button Content="Sluiten" Style="{StaticResource DialoogKnop}" IsDefault="True" Click="Sluiten_Click"
                            Visibility="{Binding IsKlaar, Converter={StaticResource BoolNaarZichtbaar}}" AutomationProperties.AutomationId="BankImportSluiten" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Margin="24,0,24,8" Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}"
                   Visibility="{Binding Foutmelding, Converter={StaticResource NietNullNaarZichtbaar}}" AutomationProperties.LiveSetting="Assertive" />

        <Grid Margin="24,16">
            <!-- ===== Stap 1: bestanden ===== -->
            <StackPanel MaxWidth="600" HorizontalAlignment="Left"
                        Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Bestanden}">
                <TextBlock Text="Gekozen bestanden" Style="{StaticResource Sectietitel}" />
                <ItemsControl ItemsSource="{Binding Bestandsnamen}" Focusable="False" Margin="0,0,0,12" />
                <TextBlock Style="{StaticResource Toelichting}"
                           Text="BTW-Boeker leest de dagafschriften en transacties. Een transactie die al eerder is ingelezen wordt overgeslagen, ook als bestanden elkaar overlappen. De bestanden zelf worden niet bewaard." />
            </StackPanel>

            <!-- ===== Stap 2: controleren ===== -->
            <DockPanel Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Controleren}">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Totaaltekst}" Style="{StaticResource Sectietitel}" />
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Meldingen}" Focusable="False" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Foutmelding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rekeningen}" Focusable="False" AutomationProperties.AutomationId="BankImportRekeningen">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BankImportRekeningRegel}">
                                <Border Style="{StaticResource Kaart}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Ibantekst, Mode=OneWay}" FontFamily="Consolas" /><Run Text="  ·  " /><Run Text="{Binding Periode, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,8">
                                            <Run Text="{Binding AantalNieuw, Mode=OneWay}" /><Run Text=" nieuw · " /><Run Text="{Binding AlBekend, Mode=OneWay}" /><Run Text=" al ingelezen · " /><Run Text="{Binding BuitenBoekjaar, Mode=OneWay}" /><Run Text=" buiten een open boekjaar" />
                                        </TextBlock>
                                        <TextBlock Text="Nieuwe eigen bankrekening: kies de grootboekrekening en de code van het bankdagboek." Style="{StaticResource Toelichting}"
                                                   Margin="0,0,0,8" Visibility="{Binding IsNieuw, Converter={StaticResource BoolNaarZichtbaar}}" />
                                        <WrapPanel IsEnabled="{Binding IsNieuw}">
                                            <StackPanel Margin="0,0,12,0">
                                                <Label Content="Grootboekrekening" Padding="0,0,0,4" />
                                                <ComboBox Width="240" ItemsSource="{Binding DataContext.Balansrekeningen, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding GekozenRekening}" IsTextSearchEnabled="True"
                                                          AutomationProperties.Name="{Binding Ibantekst, StringFormat=Grootboekrekening voor {0}}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <Label Content="Dagboekcode" Padding="0,0,0,4" />
                                                <TextBox Width="80" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                                                         AutomationProperties.Name="{Binding Ibantekst, StringFormat=Dagboekcode voor {0}}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="Naam" Padding="0,0,0,4" />
                                                <TextBox Width="240" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                                         AutomationProperties.Name="{Binding Ibantekst, StringFormat=Naam van het dagboek voor {0}}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}" Margin="0,8,0,0"
                                                   Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                                        <ItemsControl ItemsSource="{Binding Meldingen}" Focusable="False" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Foutmelding}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ===== Stap 3: klaar ===== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                        Visibility="{Binding Stap, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Klaar}">
                <TextBlock FontFamily="{StaticResource Pictogrammen}" Text="&#xE930;" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock Text="Bankafschriften ingelezen" Style="{StaticResource Sectietitel}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Samenvatting}" Style="{StaticResource Toelichting}" AutomationProperties.AutomationId="BankImportSamenvatting" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
