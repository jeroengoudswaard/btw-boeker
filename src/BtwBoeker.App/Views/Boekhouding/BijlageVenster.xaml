<Window x:Class="BtwBoeker.App.Views.Boekhouding.BijlageVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BtwBoeker.App.ViewModels.Boekhouding"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BijlageVoorbeeldViewModel}"
        Title="{Binding Titel}"
        Width="900" Height="760" MinWidth="480" MinHeight="360"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="BijlageVoorbeeld">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding OpslaanAlsCommand}" />
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomUitCommand}" />
        <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomUitCommand}" />
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomHerstelCommand}" />
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="Sluiten_Executed" />
    </Window.CommandBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Sl_uiten" MinWidth="96" Command="ApplicationCommands.Close" ToolTip="Esc"
                        AutomationProperties.AutomationId="BijlageSluiten" />
                <Button DockPanel.Dock="Right" Content="_Opslaan als..." Margin="0,0,8,0" Command="{Binding OpslaanAlsCommand}" ToolTip="Ctrl+S"
                        AutomationProperties.AutomationId="BijlageOpslaanAls" />
                <StackPanel Orientation="Horizontal">
                    <Button FontFamily="{StaticResource Pictogrammen}" Content="&#xE71F;" Padding="8,4" Command="{Binding ZoomUitCommand}"
                            ToolTip="Uitzoomen (Ctrl+min)" AutomationProperties.Name="Uitzoomen" />
                    <TextBlock Text="{Binding Zoomtekst}" MinWidth="56" TextAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.Name="Zoomniveau" AutomationProperties.LiveSetting="Polite" />
                    <Button FontFamily="{StaticResource Pictogrammen}" Content="&#xE8A3;" Padding="8,4" Command="{Binding ZoomInCommand}"
                            ToolTip="Inzoomen (Ctrl+plus)" AutomationProperties.Name="Inzoomen" />
                    <Button Content="_Ware grootte" Margin="8,0,0,0" Command="{Binding ZoomHerstelCommand}" ToolTip="Ctrl+0" />
                    <TextBlock x:Name="Paginatekst" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Toelichting}"
                               AutomationProperties.AutomationId="BijlagePaginas" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="16,8">
            <TextBlock Text="{Binding Melding}" Style="{StaticResource Toelichting}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}" Margin="0" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="True"
                      Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" AutomationProperties.Name="Pagina's">
            <ItemsControl x:Name="Paginalijst" HorizontalAlignment="Center" Margin="16" AutomationProperties.AutomationId="BijlagePaginalijst">
                <ItemsControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="White">
                            <Image Source="{Binding}" Width="800" Stretch="Uniform" AutomationProperties.Name="Pagina" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
