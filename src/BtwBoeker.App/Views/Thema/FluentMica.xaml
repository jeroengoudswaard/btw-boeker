<!-- Het visuele ontwerp Fluent Mica. Alle kleuren komen uit het Fluent-thema van .NET (DynamicResource), zodat
     licht en donker vanzelf werken; de accentkleur is die van Windows (AccentFillColor*Brush). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:g="clr-namespace:BtwBoeker.App.Views.Gedeeld">

    <FontFamily x:Key="Lettertype">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Koplettertype">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Het witte paginavlak naast de navigatiebalk, met een afgeronde hoek linksboven. -->
    <Style x:Key="Paginavlak" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="CornerRadius" Value="8,0,0,0" />
    </Style>

    <!-- Een aantal: klein label in de accentkleur. -->
    <Style x:Key="Teller" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Kerncijfer op Start. -->
    <Style x:Key="Kerncijfertitel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Kerncijferwaarde" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- UX-review stap 1: de focusrand bij toetsenbordgebruik (WPF toont een FocusVisualStyle niet bij een muisklik), afgerond
         zoals Fluent. -->
    <Style x:Key="Focusrand">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Een regel in de navigatiebalk: zonder kader, bij de gekozen regel een vlak en een accentstreepje (zoals Windows 11). -->
    <Style x:Key="Navigatieregel" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focusrand}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Vlak" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Rectangle x:Name="Streep" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Vlak" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Vlak" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter TargetName="Streep" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Knoppen in de eigen titelbalk: 46 × 36 px, zoals de vensterknoppen van Windows. -->
    <Style x:Key="Vensterknop" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Vlak" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Vlak" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Vlak" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Sluitknop" TargetType="Button" BasedOn="{StaticResource Vensterknop}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Vlak" Background="Transparent">
                        <ContentPresenter x:Name="Inhoud" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Vlak" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Vlak" Property="Background" Value="#C83C31" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ===== Ontwerpsysteem v0.14.0 ===== -->

    <!-- Welkomstitel: de enige plek met 32 px. -->
    <Style x:Key="Welkomstitel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Koplettertype}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Pictogram op een zachte tint (onderdeelkleur), 40 px; de kleur zet de gebruiker met Background/Foreground. -->
    <Style x:Key="Pictogramtegel" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Keuzetegel: drie of meer gelijke keuzes naast elkaar, allemaal even groot. -->
    <Style x:Key="Keuzetegel" TargetType="Button">
        <Setter Property="Height" Value="168" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" />
                        <Border x:Name="Zweef" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Opacity="0" />
                        <Border x:Name="Rand" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Zweef" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Rand" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            <Setter TargetName="Rand" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Zweef" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- De gekleurde keuzetegel: de hoofdactie, met een rand en een zachte tint in de accentkleur. -->
    <Style x:Key="Hoofdtegel" TargetType="Button" BasedOn="{StaticResource Keuzetegel}">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" />
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="8" Opacity="0.08" />
                        <Border x:Name="Zweef" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="8" Opacity="0" />
                        <Border x:Name="Rand" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Zweef" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Rand" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            <Setter TargetName="Rand" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Zweef" Property="Opacity" Value="0.12" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Een knop die alleen tekst is, in de accentkleur (bijvoorbeeld de actie op een startkaart). -->
    <!-- ===== UX-review stap 1: uit het moederproduct (besluit 32) ===== -->

    <!-- De meldingsbalk rechts in de paginakop (in plaats van de statusbalk); de achtergrond volgt de soort (✓ ⚠ ✕). -->
    <Style x:Key="Meldingsbalk" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Soort}" Value="Gelukt">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Soort}" Value="Waarschuwing">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Soort}" Value="Fout">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Meldingsteken" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Soort}" Value="Gelukt">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Soort}" Value="Waarschuwing">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Soort}" Value="Fout">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Een klein sluitkruisje (24 × 24 px), bijvoorbeeld in de meldingsbalk. -->
    <Style x:Key="Sluitkruisje" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Content" Value="&#xE711;" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focusrand}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Vlak" Background="Transparent" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Vlak" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Vlak" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- UX-review stap 3 (besluit 38): het detail naast een lijst, met de titel en ✕ bovenaan. -->
    <Style TargetType="g:Detailpaneel">
        <Setter Property="Width" Value="440" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="g:Detailpaneel">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Sluitkruisje}" Command="{TemplateBinding SluitOpdracht}" Margin="8,0,0,0"
                                        ToolTip="Sluiten (Esc)" AutomationProperties.Name="Sluiten" AutomationProperties.AutomationId="DetailSluiten" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="16" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Onderdelen die de navigatiebalk kiest: alleen de inhoud, zonder tabkoppen en zonder de lijn waar die stonden. -->
    <Style x:Key="Onderdeelpaneel" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tekstknop" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Vlak" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Inhoud" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Inhoud" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Vlak" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            <Setter TargetName="Vlak" Property="BorderThickness" Value="0,0,0,2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
