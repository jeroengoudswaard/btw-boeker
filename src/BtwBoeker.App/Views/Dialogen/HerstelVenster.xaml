<Window x:Class="BtwBoeker.App.Views.Dialogen.HerstelVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wachtwoord herstellen"
        SizeToContent="Height" Width="500"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=Sleutel}">
    <StackPanel Margin="24">
        <TextBlock x:Name="Uitleg" TextWrapping="Wrap" Margin="0,0,0,16" />
        <Label Content="_Herstelsleutel" Target="{Binding ElementName=Sleutel}" Padding="0,0,0,4" />
        <TextBox x:Name="Sleutel" FontFamily="Consolas" CharacterCasing="Upper" Margin="0,0,0,12"
                 Text="{Binding HerstelsleutelTekst, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="Herstelsleutel" />
        <Label Content="_Nieuw wachtwoord" Target="{Binding ElementName=Wachtwoord}" Padding="0,0,0,4" />
        <PasswordBox x:Name="Wachtwoord" PasswordChanged="Wachtwoord_PasswordChanged" Margin="0,0,0,12" />
        <Label Content="_Bevestig nieuw wachtwoord" Target="{Binding ElementName=Bevestiging}" Padding="0,0,0,4" />
        <PasswordBox x:Name="Bevestiging" PasswordChanged="Bevestiging_PasswordChanged" />
        <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}"
                   Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
        <StackPanel Style="{StaticResource Knoppenbalk}">
            <Button Content="Herstellen" IsDefault="True" Style="{StaticResource DialoogKnop}"
                    IsEnabled="{Binding KanBevestigen}" Click="Herstellen_Click" />
            <Button Content="Annuleren" IsCancel="True" Style="{StaticResource DialoogKnop}" />
        </StackPanel>
    </StackPanel>
</Window>
