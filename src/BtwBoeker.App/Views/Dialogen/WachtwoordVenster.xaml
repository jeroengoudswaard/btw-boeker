<Window x:Class="BtwBoeker.App.Views.Dialogen.WachtwoordVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database openen"
        SizeToContent="Height" Width="440"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=Wachtwoord}">
    <StackPanel Margin="24">
        <TextBlock x:Name="Uitleg" TextWrapping="Wrap" Margin="0,0,0,16" />
        <Label Content="_Wachtwoord" Target="{Binding ElementName=Wachtwoord}" Padding="0,0,0,4" />
        <PasswordBox x:Name="Wachtwoord" AutomationProperties.AutomationId="Wachtwoord" />
        <TextBlock x:Name="Fout" Style="{StaticResource Foutmelding}" Visibility="Collapsed" />
        <TextBlock Margin="0,12,0,0">
            <Hyperlink Click="Vergeten_Click" AutomationProperties.AutomationId="WachtwoordVergeten">Wachtwoord vergeten?</Hyperlink>
        </TextBlock>
        <StackPanel Style="{StaticResource Knoppenbalk}">
            <Button Content="Openen" IsDefault="True" Style="{StaticResource DialoogKnop}" Click="Openen_Click" />
            <Button Content="Annuleren" IsCancel="True" Style="{StaticResource DialoogKnop}" />
        </StackPanel>
    </StackPanel>
</Window>
