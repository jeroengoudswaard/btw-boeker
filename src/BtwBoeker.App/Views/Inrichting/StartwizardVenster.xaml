<Window x:Class="BtwBoeker.App.Views.Inrichting.StartwizardVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="clr-namespace:BtwBoeker.App.Views.Gedeeld"
        xmlns:vm="clr-namespace:BtwBoeker.App.ViewModels.Inrichting"
        xmlns:rootvm="clr-namespace:BtwBoeker.App.ViewModels"
        Title="BTW-Boeker instellen"
        Width="900" Height="680" MinWidth="680" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="Startwizard">
    <Window.Resources>
        <Style x:Key="Stapkaart" TargetType="Border" BasedOn="{StaticResource Kaart}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="AlIngericht" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Text" Value="✓ Al ingericht. U kunt verder, of het hieronder toch opnieuw doen." />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="BTW-Boeker instellen" Style="{StaticResource Sectietitel}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Stappen}" Focusable="False" AutomationProperties.Name="Stappen">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StapRegel}">
                            <Button Command="{Binding DataContext.GaNaarCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    Padding="8,4" Margin="0,0,4,4" Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="{Binding Toegankelijkenaam}" AutomationProperties.AutomationId="{Binding Stap, StringFormat=Stap{0}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Teken}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Titel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="_Later verder" Command="{Binding LaterVerderCommand}" MinWidth="96"
                        AutomationProperties.AutomationId="StartwizardLaterVerder" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Over_slaan" Style="{StaticResource DialoogKnop}" Command="{Binding OverslaanCommand}"
                            AutomationProperties.AutomationId="StartwizardOverslaan" />
                    <Button Content="&lt; Vo_rige" Style="{StaticResource DialoogKnop}" Command="{Binding VorigeCommand}"
                            AutomationProperties.AutomationId="StartwizardVorige" />
                    <Button Content="_Volgende &gt;" IsDefault="True" Command="{Binding VolgendeCommand}"
                            AutomationProperties.AutomationId="StartwizardVolgende" />
                    <Button Content="_Voltooien" Style="{StaticResource DialoogKnop}" Command="{Binding VoltooienCommand}"
                            Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Klaar}"
                            AutomationProperties.AutomationId="StartwizardVoltooien" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Margin="24,0,24,8" Text="{Binding Foutmelding}" Style="{StaticResource Foutmelding}"
                   AutomationProperties.LiveSetting="Assertive"
                   Visibility="{Binding Foutmelding, Converter={StaticResource NietNullNaarZichtbaar}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <TextBlock Text="{Binding Stapnummer}" Style="{StaticResource Toelichting}" />
                <TextBlock Text="{Binding HuidigeTitel}" Style="{StaticResource Paginatitel}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource AlIngericht}" AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding IsHuidigeStapKlaar, Converter={StaticResource BoolNaarZichtbaar}}" />

                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Welkom}">
                    <TextBlock Style="{StaticResource Toelichting}" FontSize="16" Margin="0,0,0,16"
                               Text="Deze wizard helpt u de database, administraties, boekhouding en bank in te richten. U kunt stappen overslaan en later verdergaan." />
                    <Border Style="{StaticResource Stapkaart}">
                        <StackPanel>
                            <TextBlock Text="Wat u nodig hebt" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource Toelichting}" Text="• Een sterk wachtwoord voor de versleutelde database" />
                            <TextBlock Style="{StaticResource Toelichting}" Text="• Uw rekeningschema en beginstanden" />
                            <TextBlock Style="{StaticResource Toelichting}" Text="• Een bankafschrift in CAMT.053-formaat" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Database}">
                    <TextBlock Style="{StaticResource Toelichting}" Text="Maak een versleutelde database aan of open een bestaande BTW-Boeker-database." Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Nieuwe database..." Command="{Binding NieuweDatabaseCommand}" Style="{DynamicResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="StartwizardNieuweDatabase" />
                        <Button Content="Database openen..." Command="{Binding OpenDatabaseCommand}" Margin="8,0,0,0"
                                AutomationProperties.AutomationId="StartwizardOpenDatabase" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Administraties}">
                    <TextBlock Style="{StaticResource Toelichting}" Text="Geef uw administraties een herkenbare naam en accentkleur." Margin="0,0,0,16" />
                    <ItemsControl ItemsSource="{Binding Namen}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type rootvm:AdministratieInstellingRegel}">
                                <StackPanel Margin="0,0,0,16">
                                    <g:AdministratieKaart />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Label Content="Naam" Target="{Binding ElementName=Naamveld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="Naamveld" Width="220" Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="{Binding Soort, StringFormat=StartwizardNaam{0}}" />
                                        <Label Content="Accentkleur" Margin="12,0,0,0" Target="{Binding ElementName=Kleurveld}" VerticalAlignment="Center" />
                                        <TextBox x:Name="Kleurveld" Width="100" Text="{Binding KleurHex, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="{Binding Soort, StringFormat=StartwizardKleur{0}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Fout}" Style="{StaticResource Foutmelding}"
                                               Visibility="{Binding Fout, Converter={StaticResource NietNullNaarZichtbaar}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Boekhouding}">
                    <TextBlock Style="{StaticResource Toelichting}" Text="Richt het rekeningschema in en vul de beginsaldi in. U kunt ook leeg beginnen en later gegevens importeren." Margin="0,0,0,16" />
                    <ComboBox ItemsSource="{Binding Source={x:Static vm:StartwizardViewModel.BoekhoudingKeuzes}}" SelectedItem="{Binding BoekhoudingVoor}"
                              Width="220" AutomationProperties.AutomationId="StartwizardBoekhoudingVoor" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Sjabloon..." Command="{Binding BoekhoudingInrichtenCommand}" CommandParameter="{x:Static vm:Boekhoudingkeuze.Sjabloon}"
                                AutomationProperties.AutomationId="StartwizardSjabloon" />
                        <Button Content="Leeg beginnen" Command="{Binding BoekhoudingInrichtenCommand}" CommandParameter="{x:Static vm:Boekhoudingkeuze.Leeg}"
                                Margin="8,0,0,0" AutomationProperties.AutomationId="StartwizardLeeg" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Bank}">
                    <TextBlock Style="{StaticResource Toelichting}" Text="Lees een bankafschrift in om de beginstanden te controleren en transacties te verwerken." Margin="0,0,0,16" />
                    <ComboBox ItemsSource="{Binding Source={x:Static vm:StartwizardViewModel.BoekhoudingKeuzes}}" SelectedItem="{Binding BankVoor}"
                              Width="220" AutomationProperties.AutomationId="StartwizardBankVoor" />
                    <Button Content="Bankafschrift inlezen..." Command="{Binding BankInlezenCommand}" IsEnabled="{Binding KanBankInlezen}"
                            Margin="0,16,0,0" AutomationProperties.AutomationId="StartwizardBankInlezen" />
                </StackPanel>

                <StackPanel Visibility="{Binding Huidig, Converter={StaticResource GelijkAanZichtbaar}, ConverterParameter=Klaar}">
                    <TextBlock Style="{StaticResource Toelichting}" Text="Dit is de stand van uw inrichting. U kunt onderdelen later opnieuw openen via Instellingen of Boekhouding." />
                    <ItemsControl ItemsSource="{Binding Klaarregels}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{Binding Teken}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Tekst}" Style="{StaticResource Toelichting}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
