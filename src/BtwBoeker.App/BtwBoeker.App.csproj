<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 versie 2004 of nieuwer: Windows.Data.Pdf voor het voorbeeld van PDF-bijlagen -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>BTW-Boeker</AssemblyName>
    <RootNamespace>BtwBoeker.App</RootNamespace>
    <Company>BTW-Boeker</Company>
    <Product>BTW-Boeker</Product>
    <!-- Besluit 20: eigen icoon voor programma, venster en taakbalk (gemaakt met assets/bron/maak-icoon.py) -->
    <ApplicationIcon>Assets\BtwBoeker.ico</ApplicationIcon>
    <!-- WPF Fluent ThemeMode is nog als experimenteel gemarkeerd -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BtwBoeker.Infrastructure\BtwBoeker.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\BtwBoeker.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BtwBoeker.App.Tests" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
