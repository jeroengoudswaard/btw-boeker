<!--
  BTW-Boeker voor Windows 10/11 (64-bit), per computer geïnstalleerd in Program Files.
  De UpgradeCode blijft altijd gelijk: een nieuwe versie vervangt de oude (MajorUpgrade). De database en instellingen van de
  gebruiker staan buiten de installatiemap en blijven bij bijwerken en verwijderen staan.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="BTW-Boeker"
           Manufacturer="Jeroen Goudswaard"
           Version="$(var.Versie)"
           UpgradeCode="D9D7F0F1-D43A-4614-B85A-F94C1DA7BEA0"
           Language="1043"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="BTW-Boeker: boekhouding en btw-administratie" Codepage="1252" />

    <MajorUpgrade DowngradeErrorMessage="Er is al een nieuwere versie van BTW-Boeker aanwezig. De installatie stopt." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="BtwBoeker.ico" SourceFile="..\src\BtwBoeker.App\Assets\BtwBoeker.ico" />
    <Property Id="ARPPRODUCTICON" Value="BtwBoeker.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://jeroengoudswaard.github.io/btw-boeker/" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BTW-Boeker" />
    </StandardDirectory>

    <!-- Windows Installer-validatie (ICE38/ICE43/ICE57): een snelkoppeling in het menu Start heeft een sleutel onder HKCU als KeyPath. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="Snelkoppeling">
        <Shortcut Id="SnelkoppelingStartmenu"
                  Name="BTW-Boeker"
                  Description="Leden, contributie en boekhouding"
                  Target="[INSTALLFOLDER]BTW-Boeker.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="BtwBoeker.ico" />
        <RegistryValue Root="HKCU" Key="Software\BtwBoeker" Name="Snelkoppeling" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="BtwBoeker" Title="BTW-Boeker">
      <Files Directory="INSTALLFOLDER" Include="$(var.PublicatieMap)\**" />
      <ComponentRef Id="Snelkoppeling" />
    </Feature>
  </Package>
</Wix>
