<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Testnamen in het Nederlands met underscores zijn bewust -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Verenigd.App\Verenigd.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dezelfde synthetische SOL3-exports als in de Application-tests -->
    <Compile Include="..\Verenigd.Application.Tests\Import\Sol3Voorbeeld.cs" Link="Leden\Sol3Voorbeeld.cs" />
    <Compile Include="..\Verenigd.Application.Tests\Bank\CamtVoorbeeld.cs" Link="Boekhouding\CamtVoorbeeld.cs" />
    <Compile Include="..\Verenigd.Application.Tests\Boekhouding\HistorieVoorbeeld.cs" Link="Boekhouding\HistorieVoorbeeld.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
