<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 versie 2004 of nieuwer: Windows.Data.Pdf voor het voorbeeld van PDF-bijlagen -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Testnamen in het Nederlands met underscores zijn bewust -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BtwBoeker.App\BtwBoeker.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\BtwBoeker.Application.Tests\Bank\CamtVoorbeeld.cs" Link="Boekhouding\CamtVoorbeeld.cs" />
    <Compile Include="..\BtwBoeker.Application.Tests\Boekhouding\Testvoorstel.cs" Link="Boekhouding\Testvoorstel.cs" />
    <Compile Include="..\BtwBoeker.Application.Tests\Boekhouding\Testsjabloon.cs" Link="Boekhouding\Testsjabloon.cs" />
    <Compile Include="..\BtwBoeker.Infrastructure.Tests\Bijlagen\Testpdf.cs" Link="UI\Testpdf.cs" />
    <Compile Include="..\BtwBoeker.Infrastructure.Tests\Demo\Demodatabase.cs" Link="UI\Demodatabase.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
